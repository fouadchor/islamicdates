---
import Layout from '../../layouts/Layout.astro';
import DuaPage from '../../components/DuaPage.astro';
import { DUA_PAGE, DUA_SECTIONS, DUA_HUB_FAQ } from '../../lib/duas';

const canonical = 'https://islamicdates.org/en/dua/';
const P = DUA_PAGE.en;
const description = 'Authentic supplications and remembrances from the Quran and Sunnah: morning & evening adhkar, Quranic duas, duas for distress and hardship, and daily supplications — each with its source.';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://islamicdates.org/en/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Duʿaʾ', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', 'name': 'Duʿaʾ & adhkar sections', 'itemListElement': DUA_SECTIONS.map((s, i) => ({ '@type': 'ListItem', 'position': i + 1, 'name': s.title.en, 'url': `https://islamicdates.org/en/dua/${s.id}/` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': DUA_HUB_FAQ.map(f => ({ '@type': 'Question', 'name': f.q.en, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a.en } })) },
]);
---
<Layout title={P.title} description={description} canonical={canonical} lang="en" jsonLd={jsonLd} arPath="/dua/" enPath="/en/dua/" urPath="/ur/dua/">
  <DuaPage lang="en" />
</Layout>
