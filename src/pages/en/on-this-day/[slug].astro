---
import Layout from '../../../layouts/Layout.astro';
import { OTD_EVENTS, otdPathL, otdAltPaths, fmtHDayL, whatsappHrefL, otdContent, eventsOfMonth } from '../../../lib/onthisday.i18n';
import { H_MON_EN } from '../../../lib/data';

export function getStaticPaths() {
  return OTD_EVENTS.map(ev => ({ params: { slug: ev.slug }, props: { slug: ev.slug } }));
}

const { slug } = Astro.props;
const ev = OTD_EVENTS.find(e => e.slug === slug)!;
const c = otdContent(ev, 'en');
const canonical = `https://islamicdates.org${otdPathL(ev.slug, 'en')}`;
const alt = otdAltPaths(ev.slug);
const hDate = fmtHDayL(ev.hm, ev.hd, 'en');
const title = `${c.title} (${c.year}) · On this day in Hijri history, ${hDate}`;
const description = c.summary.length > 158 ? c.summary.slice(0, 155) + '…' : c.summary;
const waHref = whatsappHrefL(ev, 'en');

const ordered = [...OTD_EVENTS].sort((a, b) => a.hm - b.hm || a.hd - b.hd || a.slug.localeCompare(b.slug));
const idx = ordered.findIndex(e => e.slug === ev.slug);
const prevEv = ordered[(idx - 1 + ordered.length) % ordered.length];
const nextEv = ordered[(idx + 1) % ordered.length];
const monthEvents = eventsOfMonth(ev.hm).filter(e => e.slug !== ev.slug).slice(0, 6);

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'Article',
    headline: `${c.title} (${c.year})`,
    description,
    inLanguage: 'en',
    mainEntityOfPage: canonical,
    author: { '@type': 'Organization', name: 'Hijri Calendar — islamicdates.org', url: 'https://islamicdates.org/en/' },
    publisher: { '@type': 'Organization', name: 'Hijri Calendar — islamicdates.org' },
    image: 'https://islamicdates.org/og-image.png',
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://islamicdates.org/en/' },
    { '@type': 'ListItem', position: 2, name: 'On This Day in Hijri History', item: 'https://islamicdates.org/en/on-this-day/' },
    { '@type': 'ListItem', position: 3, name: c.title, item: canonical },
  ] },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="en" jsonLd={jsonLd}
  arPath={alt.ar} enPath={alt.en} urPath={alt.ur}>
  <header class="site-header">
    <div class="header-start">
      <a href="/en/" class="logo" aria-label="Go to the homepage">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">Hijri Calendar</div>
          <div class="tagline">On this day in Hijri history</div>
        </div>
      </a>
      <a href="/en/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>Home</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <nav style="font-size:13px;color:var(--muted);margin-bottom:4px" aria-label="Breadcrumb">
        <a href="/en/" style="color:var(--accent);text-decoration:none">Home</a>
        <span aria-hidden="true"> › </span>
        <a href="/en/on-this-day/" style="color:var(--accent);text-decoration:none">On this day in Hijri history</a>
        <span aria-hidden="true"> › </span>
        <span>{c.title}</span>
      </nav>

      <article class="card section-card">
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
          <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:700;font-size:13.5px">☾ {hDate}</span>
          <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:var(--gold-soft);color:var(--gold-deep);font-weight:700;font-size:13.5px">{c.year}</span>
        </div>
        <h1 class="section-h2" style="font-size:clamp(22px,3.6vw,28px)">{c.title}</h1>
        <p class="section-p" style="font-weight:600;margin-top:10px">{c.summary}</p>

        {c.story.map(p => <p class="section-p" style="margin-top:14px">{p}</p>)}

        {c.disputed && (
          <div style="margin-top:18px;display:flex;gap:10px;align-items:flex-start;padding:13px 16px;border-radius:12px;background:rgba(251,191,36,.12);border:1px solid rgba(217,164,6,.35)">
            <span aria-hidden="true" style="font-size:18px;line-height:1.4">⚠️</span>
            <p style="margin:0;font-size:13.5px;line-height:1.9;color:var(--text)"><strong>Note — differing reports on the date:</strong> {c.disputed}</p>
          </div>
        )}

        <div style="margin-top:14px;padding:13px 16px;border-radius:12px;background:var(--accent-soft);font-size:13.5px;line-height:1.9">
          <strong>📚 Source:</strong> {c.source}
        </div>

        <div style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap">
          <a href={waHref} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:11px;background:#25D366;color:#fff;font-weight:700;font-size:14px;text-decoration:none">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Share on WhatsApp
          </a>
          <button id="otd-copy" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:11px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;border:0;cursor:pointer;font-family:inherit">
            🔗 Copy link
          </button>
        </div>
      </article>

      <section class="card section-card">
        <h2 class="section-h2">Other events in {H_MON_EN[ev.hm - 1]}</h2>
        <div class="months-grid" style="margin-top:12px">
          {monthEvents.map(e => {
            const ec = otdContent(e, 'en');
            return (
              <a href={otdPathL(e.slug, 'en')} class="month-item" style="text-decoration:none;color:inherit">
                <div>
                  <div class="month-name">{ec.title}</div>
                  <div class="month-note">{fmtHDayL(e.hm, e.hd, 'en')} · {ec.year}</div>
                </div>
              </a>
            );
          })}
        </div>
        <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;justify-content:space-between">
          <a href={otdPathL(prevEv.slug, 'en')} style="color:var(--accent);text-decoration:none;font-weight:700;font-size:14px">‹ Previous: {otdContent(prevEv, 'en').title}</a>
          <a href={otdPathL(nextEv.slug, 'en')} style="color:var(--accent);text-decoration:none;font-weight:700;font-size:14px">Next: {otdContent(nextEv, 'en').title} ›</a>
        </div>
        <a href="/en/on-this-day/" style="margin-top:16px;display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:11px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;text-decoration:none">Browse all “On this day” events ›</a>
      </section>
    </main>
  </div>

  <script>
    document.getElementById('otd-copy')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(location.href);
        btn.textContent = '✓ Copied';
        setTimeout(() => { btn.textContent = '🔗 Copy link'; }, 2000);
      } catch {}
    });
  </script>
</Layout>
