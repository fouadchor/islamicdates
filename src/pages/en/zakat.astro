---
import Layout from '../../layouts/Layout.astro';
import ZakatIsland from '../../components/ZakatIsland';

const canonical = 'https://islamicdates.org/en/zakat/';
const title = 'Zakat Calculator · Calculate Zakat on Cash, Gold & Silver (2.5%)';
const description = 'Free Zakat calculator for cash, gold, silver, business goods, and investments. Set the nisab by gold (85g) or silver (595g), subtract debts, and compute 2.5% — based on the Hijri year.';

const faq = [
  { q: 'What is the nisab for Zakat?', a: 'The nisab is the minimum amount of wealth on which Zakat becomes due. It equals the value of 85 grams of gold or 595 grams of silver. If your net wealth reaches this threshold and a full lunar (Hijri) year passes while you own it, Zakat is due.' },
  { q: 'How much is the Zakat nisab in Qatar, Saudi Arabia, the UAE and the Gulf?', a: 'The nisab is not a fixed number — it changes daily with gold and silver prices and differs by currency. It equals the value of 85 grams of gold or 595 grams of silver at the current market price. The "Today\'s Zakat nisab" box at the top of this page shows the live value automatically in your currency — Qatari Riyal, Saudi Riyal, UAE Dirham and others — updated in real time.' },
  { q: 'How much is Zakat on wealth?', a: 'Zakat on monetary wealth (cash, gold, silver, business goods) is 2.5% — one fortieth — of your net zakatable wealth, once it reaches the nisab and a lunar year has passed.' },
  { q: 'Should I use the gold or silver nisab?', a: 'Both are valid. The silver nisab is usually lower in value, so using it means Zakat applies to more people — considered the more cautious and charitable choice — while many people use the gold nisab. This calculator lets you choose.' },
  { q: 'Is Zakat due on gold jewellery worn for adornment?', a: 'Scholars differ. The majority hold that jewellery a woman wears is exempt, while others hold it is always due as a precaution. Paying it is the more cautious view; consult a scholar for your situation.' },
  { q: 'When does the Zakat year (hawl) start?', a: 'The hawl begins on the day your wealth first reaches the nisab and is counted by the lunar Hijri year (about 354 days). When the year completes and your wealth is still at or above the nisab, Zakat is due.' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://islamicdates.org/en/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Zakat Calculator', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'Zakat Calculator', 'url': canonical,
    'applicationCategory': 'FinanceApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="en" jsonLd={jsonLd} arPath="/zakat/" enPath="/en/zakat/" urPath="/ur/zakat/">
  <header class="site-header">
    <div class="header-start">
      <a href="/en/" class="logo" aria-label="Go to homepage">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">Hijri Calendar</div>
          <div class="tagline">Zakat Calculator</div>
        </div>
      </a>
      <a href="/en/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>Home</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">Zakat Calculator</h1>
        <p class="section-p" style="margin-top:8px">Easily calculate your Zakat: cash and bank balances, gold and silver, business goods, stocks and investments, and money owed to you — minus debts you owe. Choose your nisab basis (gold or silver), and Zakat is computed at 2.5% once your wealth reaches the nisab.</p>
      </section>

      <ZakatIsland lang="en" client:load />

      <section class="card section-card">
        <h2 class="section-h2">How is Zakat calculated?</h2>
        <p class="section-p">Add up all your zakatable wealth (cash, the value of gold and silver, business goods, investments, and recoverable debts), then subtract debts currently due, giving your net zakatable wealth. If this net amount reaches the nisab — the value of 85 grams of gold or 595 grams of silver — and a full lunar year has passed, 2.5% of it is due as Zakat.</p>
        <h2 class="section-h2" style="margin-top:22px">Nisab and metal prices</h2>
        <p class="section-p">Because the nisab value tracks the daily price of gold and silver, the calculator fetches an approximate live price automatically, and you can edit it to match the market price in your currency. Enter all amounts in the same currency you used for the gram price.</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">Frequently asked questions</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="ad-slot"><span class="ad-label">Advertisement</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">Related tools</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/en/" style="color:var(--accent);text-decoration:none">Hijri calendar &amp; today's date</a>
          <a href="/en/prayer-times/" style="color:var(--accent);text-decoration:none">Prayer times by location</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    Guidance tool only · consult a scholar for your specific case
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">Privacy Policy</a>
  </footer>
</Layout>
