---
import Layout from '../../layouts/Layout.astro';
import { getL } from '../../lib/data';

const L = getL(false);
const canonical = 'https://islamicdates.org/en/about/';
const title = 'What Is the Hijri Calendar? A Guide to Umm al-Qura & Date Calculation';
const description = 'A guide to the Hijri calendar: what it is, how it is calculated astronomically, the difference between the Umm al-Qura calendar and moon sighting, plus FAQs.';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://islamicdates.org/en/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Hijri Calendar Guide', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': L.faqItems.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="en" jsonLd={jsonLd} arPath="/about/" enPath="/en/about/" urPath="/ur/about/">
  <header class="site-header">
    <div class="header-start">
      <a href="/en/" class="logo" aria-label="Go to homepage">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">Hijri Calendar</div>
          <div class="tagline">Hijri Calendar Guide</div>
        </div>
      </a>
      <a href="/en/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>Home</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <img src="/images/hero-calendar.svg"
        alt="A monthly calendar card with a highlighted day beside a golden crescent — Hijri calendar illustration"
        width="1200" height="420" fetchpriority="high" decoding="async"
        style="width:100%;height:auto;border-radius:16px;display:block" />
      <section class="card section-card">
        <h1 class="section-h2" style="font-size:25px">{L.whatIsTitle}</h1>
        <p class="section-p" style="margin-top:8px">{L.whatIsBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.diffTitle}</h2>
        <p class="section-p">{L.diffBody}</p>
        <h2 class="section-h2" style="margin-top:22px">{L.howTitle}</h2>
        <p class="section-p">{L.howBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.aboutTitle}</h2>
        <p class="section-p">{L.aboutBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.faqTitle}</h2>
        {L.faqItems.map((f, i) => (
          <div class="faq-item" style={i === L.faqItems.length - 1 ? 'border-bottom:none' : ''}>
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">Related tools</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/en/" style="color:var(--accent);text-decoration:none">Hijri calendar &amp; today's date</a>
          <a href="/en/#converter" style="color:var(--accent);text-decoration:none">Hijri ⇄ Gregorian converter</a>
          <a href="/en/prayer-times/" style="color:var(--accent);text-decoration:none">Prayer times by location</a>
          <a href="/en/zakat/" style="color:var(--accent);text-decoration:none">Zakat calculator</a>
          <a href="/en/widget/" style="color:var(--accent);text-decoration:none">Hijri date widget for your site</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    Calculated using the Umm al-Qura calendar
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">Privacy Policy</a>
  </footer>
</Layout>
