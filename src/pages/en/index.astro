---
import Layout from '../../layouts/Layout.astro';
import KhatmaHeroDoor from '../../components/KhatmaHeroDoor.astro';
import TodayIsland from '../../components/TodayIsland';
import CalendarIsland from '../../components/CalendarIsland';
import ConverterIsland from '../../components/ConverterIsland';
import HomeOccasions from '../../components/HomeOccasions.astro';
import SidebarExtras from '../../components/SidebarExtras.astro';
import HadithOfDay from '../../components/HadithOfDay.astro';
import HomeCityPrayer from '../../components/HomeCityPrayer.astro';
import { H_MON_EN, MONTHS_NOTES_EN } from '../../lib/data';
import { getL } from '../../lib/data';
import { g2h, h2g, todayUTC } from '../../lib/hijri';
import { G_MON_EN } from '../../lib/data';
import { monthBasePath, monthName, monthSlug, H_YEAR_START, H_YEAR_END } from '../../lib/months';
import { eventForDay, otdContent, otdIcon, otdAgo, fmtHDayL, otdPathL, whatsappHrefL } from '../../lib/onthisday.i18n';

// --- Request-time SSR + fresh CDN cache (fixes stale build-time date) ---
export const prerender = false;
// Keep the edge copy fresh: expires at the next Riyadh midnight, capped to 1h,
// so the server-rendered date can never sit a day behind.
const _tParts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Riyadh', hourCycle: 'h23', hour: '2-digit', minute: '2-digit', second: '2-digit' }).formatToParts(new Date());
const _tp = (t: string) => Number(_tParts.find(p => p.type === t)?.value ?? 0);
const _secsToMidnight = 86400 - (_tp('hour') * 3600 + _tp('minute') * 60 + _tp('second'));
const _ttl = Math.max(60, Math.min(_secsToMidnight, 3600));
Astro.response.headers.set('Cache-Control', `public, max-age=0, s-maxage=${_ttl}, stale-while-revalidate=86400`);
// ------------------------------------------------------------------------

const _curHy = Math.min(Math.max(g2h(todayUTC()).y, H_YEAR_START), H_YEAR_END);
const _monthLinks = Array.from({ length: 12 }, (_, i) => ({ name: monthName(i + 1, false), href: monthBasePath(_curHy, i + 1, false) }));
const _monthNotesShort = ['Opens the Hijri year — a sacred month graced by the fast of Ashura','Named for the empty homes of the Arabs in their season of travel','The month of the Prophet ﷺ birth — hearts recall his noble life','The fourth month, completing the season of spring for the Arabs','Named jumada — for water that froze in the deep cold','The last of the two Jumadas, leading into the sacred months','A sacred month, marking the Night Journey — Israʾ & Miʿraj','When deeds are raised; abundant fasting prepares for Ramadan','The month of fasting and the Quran, holding the Night of Decree','Begins with Eid al-Fitr; six recommended days of fasting follow','A sacred month as pilgrims prepare for the Hajj season','Hajj and Eid al-Adha — its first ten are the best of days'];

const L = getL(false);

// «On this day in Hijri history» — today's event (SSR each request)
const _otdH = g2h(todayUTC());
const _otd = eventForDay(_otdH.m, _otdH.d, new Date().getUTCFullYear());
const _ev = _otd.ev;
const _c = otdContent(_ev, 'en');
const _otdAgoN = otdAgo(_ev, _otdH.y);
const _otdIcon = otdIcon(_ev);
const _otdPath = otdPathL(_ev.slug, 'en');
const _otdWa = whatsappHrefL(_ev, 'en');
const _otdHDate = fmtHDayL(_ev.hm, _ev.hd, 'en');
const _otdMonthName = H_MON_EN[_otdH.m - 1];


// —— Internal-linking depth: Gregorian spans on month cards + cross-year month funnel ——
const _gSpan = (hy: number, hm: number): string => {
  const _s = h2g(hy, hm, 1);
  const _n = hm < 12 ? h2g(hy, hm + 1, 1) : h2g(hy + 1, 1, 1);
  const _e = new Date(_n.getTime() - 86400000);
  const sM = _s.getUTCMonth(), sY = _s.getUTCFullYear();
  const eM = _e.getUTCMonth(), eY = _e.getUTCFullYear();
  if (sM === eM && sY === eY) return `${G_MON_EN[sM]} ${sY}`;
  if (sY === eY) return `${G_MON_EN[sM]} – ${G_MON_EN[eM]} ${sY}`;
  return `${G_MON_EN[sM]} ${sY} – ${G_MON_EN[eM]} ${eY}`;
};
const _monthGreg = Array.from({ length: 12 }, (_, i) => _gSpan(_curHy, i + 1));
const _keyMonths = [
  { hm: 1, note: 'Ashura & Islamic New Year' },
  { hm: 7, note: 'Israʾ and Miʿraj' },
  { hm: 8, note: 'Mid-Shaʿban' },
  { hm: 9, note: 'Fasting & Laylat al-Qadr' },
  { hm: 10, note: 'Eid al-Fitr' },
  { hm: 12, note: 'Hajj & Eid al-Adha' },
];
const _yStart = Math.max(H_YEAR_START, _curHy - 3);
const _yEnd = Math.min(H_YEAR_END, _curHy + 3);
const _keyMonthRows = _keyMonths.map(k => ({
  name: monthName(k.hm, false), note: k.note, slug: monthSlug(k.hm),
  years: Array.from({ length: _yEnd - _yStart + 1 }, (_, j) => {
    const _y = _yStart + j;
    return { hy: _y, gy: h2g(_y, k.hm, 1).getUTCFullYear(), href: monthBasePath(_y, k.hm, false) };
  }),
}));

const jsonLd = JSON.stringify([
  {
    "@context":"https://schema.org","@type":"WebApplication",
    "name":"Hijri Calendar","alternateName":"التقويم الهجري",
    "url":"https://islamicdates.org/en/",
    "description":"Hijri calendar today with Gregorian date comparison, browse Hijri months, quick date converter between Hijri and Gregorian, and upcoming Islamic occasions based on the Umm al-Qura calendar.",
    "applicationCategory":"UtilitiesApplication","operatingSystem":"Web",
    "inLanguage":["ar","en","ur"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}
  },
  {
    "@context":"https://schema.org","@type":"FAQPage",
    "@id":"https://islamicdates.org/en/#faq",
    "mainEntity": L.homeFaqItems.map(f => ({
      "@type":"Question","name":f.q,
      "acceptedAnswer":{"@type":"Answer","text":f.a},
    })),
  },
]);
---

<Layout
  title="Hijri Calendar Today · Islamic Date & Gregorian Converter | Umm al-Qura"
  description="Today's Hijri (Islamic) date next to the Gregorian date, browse Hijri months, quick Hijri–Gregorian date converter, and upcoming Islamic occasions based on the Umm al-Qura calendar."
  canonical="https://islamicdates.org/en/"
  lang="en"
  jsonLd={jsonLd}
>
  <header class="site-header">
    <a href="/en/" class="logo" style="text-decoration:none;color:inherit" aria-label="Home">
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L.brand}</div>
        <div class="tagline">{L.tagline}</div>
      </div>
    </a>
  </header>

  <div class="layout with-hero">
    <div class="hero-band has-door">
      <TodayIsland lang="en" todayIso={todayUTC().toISOString().slice(0, 10)} client:load />
      <KhatmaHeroDoor lang="en" />
    </div>

    <main>

      <CalendarIsland lang="en" client:load />
      <div id="converter" style="scroll-margin-top:var(--anchor-offset)"><ConverterIsland lang="en" client:visible /></div>

      <!-- On this day in Hijri history (order:2 → right after the converter, before upcoming occasions) -->
      <section class="card section-card" style="order:2;position:relative;overflow:hidden;background:linear-gradient(140deg,#10312f 0%,#0c4a44 55%,#0a5a54 100%);border-color:transparent;color:#eafaf6">
        <span aria-hidden="true" style="position:absolute;top:-24px;inset-inline-end:-10px;font-size:110px;opacity:.09;transform:rotate(12deg);color:#fbbf24">✦</span>
        <span aria-hidden="true" style="position:absolute;bottom:-34px;inset-inline-start:-12px;font-size:120px;opacity:.09;color:#fbbf24">☾</span>
        <span aria-hidden="true" style="position:absolute;bottom:-38px;inset-inline-end:6px;font-size:clamp(80px,14vw,150px);font-weight:800;line-height:1;color:rgba(251,191,36,.10);pointer-events:none;font-variant-numeric:tabular-nums">{_c.year.replace(/[^0-9]/g,'')}</span>

        <div style="position:relative">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:4px">
            <h2 class="section-h2" style="margin:0;color:#fff">📜 On this day in Hijri history</h2>
            <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);font-weight:700;font-size:12.5px;color:#d5efe9">☾ Today {_otdH.d} {_otdMonthName} {_otdH.y} AH</span>
          </div>
          <p style="margin:0 0 16px;font-size:13px;color:#9fd4c9">{_otd.exact
            ? 'A page from the memory of the Ummah, turned each day — an event that occurred on this Hijri day'
            : `No event is documented for today (${_otdH.d} ${_otdMonthName}) itself — here is a highlight from the month:`}</p>

          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
            {_otdAgoN !== null && <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 15px;border-radius:999px;background:#fbbf24;color:#4a2b00;font-weight:800;font-size:13.5px;box-shadow:0 3px 10px rgba(0,0,0,.25)">⏳ {_otdAgoN} years ago</span>}
            <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(251,191,36,.5);color:#ffd97a;font-weight:700;font-size:13px">{_c.year}</span>
            <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.12);color:#d5efe9;font-weight:700;font-size:13px">{_otdHDate}</span>
            <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(94,234,212,.16);color:#8ff5e2;font-weight:700;font-size:12.5px">{_ev.hd === _otdH.d ? '✨ This very day' : `A key event of ${_otdMonthName}`}</span>
          </div>

          <div style="display:flex;gap:14px;align-items:flex-start">
            <span aria-hidden="true" style="font-size:44px;line-height:1.2;flex:0 0 auto;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35))">{_otdIcon}</span>
            <div style="flex:1 1 auto;min-width:0">
              <h3 style="margin:0 0 8px;font-size:clamp(18px,2.8vw,23px);font-weight:800;line-height:1.6">
                <a href={_otdPath} style="color:#fff;text-decoration:none">{_c.title}</a>
              </h3>
              <p class="section-p" style="color:#d9efe9;margin:0">{_c.summary}</p>
            </div>
          </div>

          {_c.disputed && (
            <div style="margin-top:14px;display:flex;gap:9px;align-items:flex-start;padding:11px 14px;border-radius:12px;background:rgba(251,191,36,.13);border:1px solid rgba(251,191,36,.4)">
              <span aria-hidden="true" style="font-size:16px;line-height:1.5">⚠️</span>
              <p style="margin:0;font-size:12.5px;line-height:1.9;color:#ffe9b3"><strong>Differing reports:</strong> {_c.disputed}</p>
            </div>
          )}
          <p style="margin:12px 0 0;font-size:12.5px;color:#9fd4c9">📚 Source: {_c.source}</p>

          <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <a href={_otdPath} style="display:inline-flex;align-items:center;gap:7px;padding:11px 22px;border-radius:999px;background:#fbbf24;color:#4a2b00;font-weight:800;font-size:14px;text-decoration:none;box-shadow:0 4px 14px rgba(0,0,0,.25)">Read the full story ›</a>
            <a href={_otdWa} target="_blank" rel="noopener" aria-label="Share on WhatsApp" style="display:inline-flex;align-items:center;gap:7px;padding:11px 20px;border-radius:999px;background:#25D366;color:#fff;font-weight:700;font-size:14px;text-decoration:none">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Share on WhatsApp
            </a>
            <a href="/en/on-this-day/" style="font-size:13.5px;font-weight:700;color:#8ff5e2;text-decoration:none">Full archive ›</a>
          </div>
        </div>
      </section>


      <!-- Decorative section divider -->
      <img src="/images/divider-ornament.svg" alt="" role="presentation" width="1200" height="70"
        loading="lazy" decoding="async" style="order:5;width:100%;height:auto;display:block;margin:-2px 0" />

      <!-- Prayer times by city (internal links to city pages) -->
      <HomeCityPrayer lang="en" />

      <HomeOccasions lang="en" />

      <section class="card section-card" style="order:5">
        <h2 class="section-h2">{`The Hijri months of ${_curHy} AH`}</h2>
        <p class="section-p" style="margin-bottom:14px">Explore the Hijri year month by month — meanings, occasions, and Gregorian dates</p>
        <div class="months-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
          {_monthLinks.map((m, i) => (
            <a href={m.href} class="month-item" style="text-decoration:none;color:inherit">
              <span class="month-num">{i + 1}</span>
              <div><div class="month-name">{m.name}</div><div class="month-note">{_monthNotesShort[i]}</div><div style="font-size:12px;color:var(--accent);font-weight:600;margin-top:3px">{_monthGreg[i]}</div></div>
            </a>
          ))}
        </div>

        <!-- Was a separate "key months across the years" section. Same links,
             folded: crawlable in the DOM, one line of height on screen. -->
        <details class="fold">
          <summary>The same month in other Hijri years</summary>
          <div style="display:flex;flex-direction:column;gap:14px;margin-top:16px">
            {_keyMonthRows.map(row => (
              <div>
                <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:8px">
                  <span style="font-weight:700;font-size:14.5px">{row.name}</span>
                  <span style="font-size:12.5px;color:var(--muted)">{row.note}</span>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                  {row.years.map(y => (
                    <a href={y.href} class="yr-chip" aria-label={`${row.name} ${y.hy} AH`}>
                      <span class="yc-h">{y.hy} AH</span>
                      <span class="yc-g">{y.gy}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </details>
        <style>
          .yr-chip { display:inline-flex; flex-direction:column; align-items:center; gap:1px; padding:7px 14px; border-radius:11px; background:var(--surface2); border:1px solid var(--border); text-decoration:none; transition:border-color .2s, transform .2s, box-shadow .2s; }
          .yr-chip:hover { border-color:var(--accent); transform:translateY(-1px); box-shadow:var(--shadow); }
          .yr-chip .yc-h { font-weight:700; font-size:13.5px; color:var(--accent); }
          .yr-chip .yc-g { font-size:11.5px; color:var(--muted); }
        </style>
      </section>


      <!-- Condensed intro + guide link (full educational content lives on /en/about/) -->
      <section class="card section-card" style="order:8">
        <h2 class="section-h2">What is the Hijri calendar?</h2>
        <p class="section-p">The Hijri calendar is a lunar calendar whose year is made up of twelve lunar months (about 354 days), dated from the migration (Hijra) of Prophet Muhammad ﷺ in 622 CE. This site shows today's Hijri date next to the Gregorian date using the Umm al-Qura calendar, with a quick Hijri ⇄ Gregorian converter, the main Islamic occasions, and prayer times.</p>
        <h3 class="section-h2" style="font-size:17px;margin:22px 0 2px">{L.homeFaqTitle}</h3>
        {L.homeFaqItems.map(f => (
          <details class="faq-d">
            <summary>{f.q}<svg class="faq-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}

        <a href="/en/about/" style="margin-top:18px;display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:11px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;text-decoration:none">Read the full guide
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </section>
    </main>

    <aside class="rail-start">
      <div class="card" style="padding:15px">
        <div class="tool-grid">
          <a href="/en/prayer-times/" class="tool-tile is-primary">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span class="tt-n">Prayer Times<span class="tt-sub">Today's prayer times for your location</span></span>
          </a>
          <a href="/en/mosques-near-me/" class="tool-tile is-primary">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11Z"/></svg></span>
            <span class="tt-n">Mosques Near Me<span class="tt-sub">Closest mosques to you, with directions</span></span>
          </a>
          <a href="/en/qibla/" class="tool-tile" title="Qibla compass & distance to the Kaaba">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg></span>
            <span class="tt-n">Qibla Direction</span>
          </a>
          <a href="/en/zakat/" class="tool-tile" title="Calculate Zakat on your wealth (2.5%)">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
            <span class="tt-n">Zakat Calculator</span>
          </a>
          <a href="/en/age/" class="tool-tile" title="Your age in Hijri &amp; Gregorian + birthday">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
            <span class="tt-n">Hijri Age Calculator</span>
          </a>
          <a href="/en/fasting/" class="tool-tile" title="White days with Gregorian dates &amp; Sunnah fasts">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span>
            <span class="tt-n">White Days &amp; Fasting</span>
          </a>
          <a href="/en/printable/" class="tool-tile" title="Download &amp; print the calendar (PDF/PNG)">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg></span>
            <span class="tt-n">Printable Calendar</span>
          </a>
          <a href="/en/widget/" class="tool-tile is-gold" title="Add today's Hijri date to your website — free">
            <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/></svg></span>
            <span class="tt-n">Widget for your site</span>
          </a>
        </div>
      </div>

    </aside>

    <aside class="rail-end">
      <SidebarExtras lang="en" />
      <HadithOfDay lang="en" />

    </aside>
  </div>

  <footer class="site-footer">
    {L.footer}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/en/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">Privacy Policy</a>
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/en/contact/" style="color:var(--muted);text-decoration:none;font-size:13px">Contact</a>
  </footer>
</Layout>
