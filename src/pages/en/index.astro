---
import Layout from '../../layouts/Layout.astro';
import TodayIsland from '../../components/TodayIsland';
import CalendarIsland from '../../components/CalendarIsland';
import ConverterIsland from '../../components/ConverterIsland';
import UpcomingIsland from '../../components/UpcomingIsland';
import { H_MON_EN, MONTHS_NOTES_EN } from '../../lib/data';
import { getL } from '../../lib/data';
import { HADITHS, hadithOfDay } from '../../lib/hadiths';
import { OCCASIONS, occurrencesInGYear, occBasePath, fmtGShort } from '../../lib/occasions';
import { g2h, todayUTC } from '../../lib/hijri';
import { monthBasePath, monthName, H_YEAR_START, H_YEAR_END } from '../../lib/months';
const _curHy = Math.min(Math.max(g2h(todayUTC()).y, H_YEAR_START), H_YEAR_END);
const _monthLinks = Array.from({ length: 12 }, (_, i) => ({ name: monthName(i + 1, false), href: monthBasePath(_curHy, i + 1, false) }));
const _monthNotesShort = ['Opens the Hijri year — a sacred month graced by the fast of Ashura','Named for the empty homes of the Arabs in their season of travel','The month of the Prophet ﷺ birth — hearts recall his noble life','The fourth month, completing the season of spring for the Arabs','Named jumada — for water that froze in the deep cold','The last of the two Jumadas, leading into the sacred months','A sacred month, marking the Night Journey — Israʾ & Miʿraj','When deeds are raised; abundant fasting prepares for Ramadan','The month of fasting and the Quran, holding the Night of Decree','Begins with Eid al-Fitr; six recommended days of fasting follow','A sacred month as pilgrims prepare for the Hajj season','Hajj and Eid al-Adha — its first ten are the best of days'];

const L = getL(false);
const _h = hadithOfDay(new Date());

const _featured = ['ramadan', 'eid-al-fitr', 'eid-al-adha', 'ashura', 'mawlid-al-nabi', 'islamic-new-year', 'isra-and-miraj', 'laylat-al-qadr', 'day-of-arafah'];
const _homeYears = (() => { const y = new Date().getUTCFullYear(); return [y, y+1]; })();
const occLinks = [];
for (const _y of _homeYears) {
  for (const _slug of _featured) {
    const _o = OCCASIONS.find(x => x.slug === _slug);
    if (!_o) continue;
    const _occ = occurrencesInGYear(_o.hm, _o.hd, _y)[0];
    if (_occ) occLinks.push({ name: _o.en.name, year: _y, href: occBasePath(_slug, _y, false), date: _occ.date });
  }
}

const jsonLd = JSON.stringify([
  {
    "@context":"https://schema.org","@type":"WebApplication",
    "name":"Hijri Calendar","alternateName":"التقويم الهجري",
    "url":"https://islamicdates.org/en/",
    "description":"Hijri calendar today with Gregorian date comparison, browse Hijri months, quick date converter between Hijri and Gregorian, and upcoming Islamic occasions based on the Umm al-Qura calendar.",
    "applicationCategory":"UtilitiesApplication","operatingSystem":"Web",
    "inLanguage":["ar","en"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}
  }
]);
---

<Layout
  title="Hijri Calendar Today · Islamic Date & Gregorian Converter | Umm al-Qura"
  description="Today's Hijri (Islamic) date next to the Gregorian date, browse Hijri months, quick Hijri–Gregorian date converter, and upcoming Islamic occasions based on the Umm al-Qura calendar."
  canonical="https://islamicdates.org/en/"
  lang="en"
  jsonLd={jsonLd}
>
  <header class="site-header">
    <a href="/en/" class="logo" style="text-decoration:none;color:inherit" aria-label="Home">
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L.brand}</div>
        <div class="tagline">{L.tagline}</div>
      </div>
    </a>
  </header>

  <div class="layout">
    <main>
      <TodayIsland lang="en" client:load />
      <CalendarIsland lang="en" client:load />
      <div id="converter" style="scroll-margin-top:64px"><ConverterIsland lang="en" client:visible /></div>
      <UpcomingIsland lang="en" client:visible />

      <section id="occasions" class="card section-card" style="order:5;scroll-margin-top:64px">
        <h2 class="section-h2">Islamic occasion dates</h2>
        <p class="section-p" style="margin-bottom:14px">See each occasion's Hijri & Gregorian date with a countdown</p>
        {_homeYears.map((_yr, _i) => (
          <div style={`margin-top:${_i === 0 ? 4 : 26}px`}>
            <h3 style="margin:0 0 12px;font-size:16px;font-weight:700;color:var(--accent)">{_yr} occasions</h3>
            <div class="months-grid">
              {occLinks.filter(o => o.year === _yr).map(o => (
                <a href={o.href} class="month-item" style="text-decoration:none;color:inherit">
                  <div>
                    <div class="month-name">{o.name} {o.year}</div>
                    <div class="month-note">{fmtGShort(o.date, false)}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <!-- Hijri month browse (SEO internal links) -->
      <section class="card section-card" style="order:5">
        <h2 class="section-h2">Browse the Hijri months of {_curHy} AH</h2>
        <p class="section-p" style="margin-bottom:14px">Explore the Hijri year month by month — meanings, occasions, and Gregorian dates</p>
        <div class="months-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
          {_monthLinks.map((m, i) => (
            <a href={m.href} class="month-item" style="text-decoration:none;color:inherit">
              <span class="month-num">{i + 1}</span>
              <div><div class="month-name">{m.name}</div><div class="month-note">{_monthNotesShort[i]}</div></div>
            </a>
          ))}
        </div>
      </section>

      <section class="card section-card" style="order:7;background:var(--gold-soft);border-color:var(--gold-soft)">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:10px">
          <span aria-hidden="true" style="font-size:22px;line-height:1;color:var(--gold-deep)">☾</span>
          <h2 class="section-h2" style="margin:0;color:var(--gold-deep)">Hadith of the Day</h2>
        </div>
        <div style="position:relative;padding:4px 2px 0">
          <span aria-hidden="true" style="position:absolute;top:-22px;inset-inline-start:-2px;font-size:60px;line-height:1;color:var(--gold);opacity:.22;font-family:Georgia,serif">“</span>
          <blockquote id="hadith-text" style="margin:0;border:0;padding:0;font-size:clamp(18px,2.7vw,24px);line-height:1.95;font-weight:700;color:var(--text);text-wrap:pretty">“{_h.en}”</blockquote>
        </div>
        <div style="margin-top:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span id="hadith-src" style="display:inline-block;padding:5px 14px;border-radius:999px;background:var(--gold-deep);color:#fff;font-weight:700;font-size:13px">{_h.enSrc}</span>
          <span style="color:var(--muted);font-size:12.5px">from Sahih al-Bukhari &amp; Muslim</span>
        </div>
      </section>
      <script define:vars={{ hList: HADITHS.map(h => ({ t: h.en, s: h.enSrc })) }}>
        (function () {
          var d = new Date();
          var start = Date.UTC(d.getFullYear(), 0, 0);
          var day = Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - start) / 86400000);
          var h = hList[((day % hList.length) + hList.length) % hList.length];
          var t = document.getElementById('hadith-text');
          var s = document.getElementById('hadith-src');
          if (t) t.textContent = '\u201C' + h.t + '\u201D';
          if (s) s.textContent = h.s;
        })();
      </script>

      <!-- Condensed intro + guide link (full educational content lives on /en/about/) -->
      <section class="card section-card" style="order:8">
        <h2 class="section-h2">What is the Hijri calendar?</h2>
        <p class="section-p">The Hijri calendar is a lunar calendar whose year is made up of twelve lunar months (about 354 days), dated from the migration (Hijra) of Prophet Muhammad ﷺ in 622 CE. This site shows today's Hijri date next to the Gregorian date using the Umm al-Qura calendar, with a quick Hijri ⇄ Gregorian converter, the main Islamic occasions, and prayer times.</p>
        <a href="/en/about/" style="margin-top:14px;display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:11px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;text-decoration:none">Read the full guide
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </section>
    </main>

    <aside>
      <a href="/en/prayer-times/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">Prayer Times</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">Today's prayer times for your location</span></span>
      </a>

      <a href="/en/zakat/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">Zakat Calculator</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">Calculate Zakat on your wealth (2.5%)</span></span>
      </a>

      <a href="/en/age/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">Hijri Age Calculator</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">Your age in Hijri &amp; Gregorian + birthday</span></span>
      </a>

      <a href="/en/printable/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">Printable Calendar</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">Download &amp; print the calendar (PDF/PNG)</span></span>
      </a>

      <a href="/en/widget/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--gold-soft);color:var(--gold-deep);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--gold-deep)">Widget for your site</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">Add today's Hijri date to your website — free</span></span>
      </a>

      <div class="ad-slot">
        <span class="ad-label">{L.ad}</span>
        <span style="font-size:13px;opacity:.7">300 × 250</span>
      </div>

      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">{L.legend}</h3>
        <div style="display:flex;flex-direction:column;gap:11px;font-size:14px">
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:50%;background:var(--accent);flex:0 0 auto"></span>{L.legendToday}</div>
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:50%;background:var(--gold);flex:0 0 auto"></span>{L.legendEid}</div>
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:50%;background:var(--holy);flex:0 0 auto"></span>{L.legendHoly}</div>
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:4px;background:var(--accent-soft);border:1px solid var(--accent);flex:0 0 auto"></span>{L.legendRam}</div>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    {L.footer}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/en/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">Privacy Policy</a>
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/en/contact/" style="color:var(--muted);text-decoration:none;font-size:13px">Contact</a>
  </footer>
</Layout>
