---
import Layout from '../../layouts/Layout.astro';
import PrintCalendarIsland from '../../components/PrintCalendarIsland';

const canonical = 'https://islamicdates.org/en/printable/';
const title = 'Printable Hijri Calendar · Download PDF & PNG (Month & Full Year)';
const description = 'Free printable Hijri (Islamic) calendar — download as PDF or PNG, single month or full year, with Hijri and Gregorian dates and Islamic occasions, based on the Umm al-Qura calendar. Pick a year and print or download in one click.';

const faq = [
  { q: 'Is the calendar free to print and share?', a: 'Yes. You can download, print and share the Hijri calendar for free — a single month or the full year — with no restrictions.' },
  { q: 'Which download formats are available?', a: 'You can download a PDF sized for A4 printing, or a high-resolution PNG image that is easy to share on social media and websites.' },
  { q: 'Does it show both Hijri and Gregorian dates?', a: 'Yes. Every day shows its Hijri number alongside the matching Gregorian date, and Islamic occasions and today are highlighted.' },
  { q: 'Which calendar is it based on?', a: 'It uses the astronomically calculated Umm al-Qura calendar. The start of some months may differ by a day depending on local moon sighting in some countries.' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://islamicdates.org/en/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Printable Hijri Calendar', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'Printable Hijri Calendar', 'url': canonical,
    'applicationCategory': 'UtilitiesApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en', 'ur'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="en" jsonLd={jsonLd} arPath="/printable/" enPath="/en/printable/" urPath="/ur/printable/">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <header class="site-header no-print">
    <div class="header-start">
      <a href="/en/" class="logo" aria-label="Go to homepage">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">Hijri Calendar</div>
          <div class="tagline">Printable Calendar</div>
        </div>
      </a>
      <a href="/en/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>Home</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card no-print" style="order:1">
        <h1 class="section-h2" style="font-size:25px">Printable Hijri Calendar</h1>
        <p class="section-p" style="margin-top:8px">Download a ready-to-print Hijri calendar as a PDF or PNG image — a single month or the full year. Pick a Hijri year, then download the file or print it directly. Each day shows the Hijri and Gregorian date, with Islamic occasions and today highlighted.</p>
      </section>

      <PrintCalendarIsland lang="en" client:load />

      <section class="card section-card no-print">
        <h2 class="section-h2">How to print or download the calendar</h2>
        <p class="section-p">Choose "Full year" or "Single month" and set the Hijri year with the + and − buttons. Then click "Download PDF" for an A4-ready file, "Download PNG" for a high-resolution image to share, or "Print" to print it now or save it as a PDF from the print dialog.</p>
      </section>

      <section class="card section-card no-print">
        <h2 class="section-h2">Frequently asked questions</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside class="no-print">
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">Related tools</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/en/" style="color:var(--accent);text-decoration:none">Hijri calendar &amp; today's date</a>
          <a href="/en/#converter" style="color:var(--accent);text-decoration:none">Hijri ⇄ Gregorian converter</a>
          <a href="/en/age/" style="color:var(--accent);text-decoration:none">Hijri age calculator</a>
          <a href="/en/zakat/" style="color:var(--accent);text-decoration:none">Zakat calculator</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer no-print">
    Dates based on the Umm al-Qura calendar · for reference
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/en/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">Privacy Policy</a>
  </footer>

  <style is:global>
    @media print {
      .site-nav, .no-print { display: none !important; }
      .layout { display: block !important; padding: 0 !important; max-width: 100% !important; }
      main { gap: 0 !important; }
      #print-sheet { border: none !important; box-shadow: none !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      @page { margin: 10mm; }
    }
  </style>
</Layout>
