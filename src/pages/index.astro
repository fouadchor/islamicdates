---
import Layout from '../layouts/Layout.astro';
import TodayIsland from '../components/TodayIsland';
import CalendarIsland from '../components/CalendarIsland';
import ConverterIsland from '../components/ConverterIsland';
import UpcomingIsland from '../components/UpcomingIsland';
import { H_MON_AR, MONTHS_NOTES_AR } from '../lib/data';
import { getL } from '../lib/data';
import { HADITHS, hadithOfDay } from '../lib/hadiths';
import { OCCASIONS, occurrencesInGYear, occBasePath, fmtGShort } from '../lib/occasions';
import { g2h, todayUTC } from '../lib/hijri';
import { monthBasePath, monthName, H_YEAR_START, H_YEAR_END } from '../lib/months';
const _curHy = Math.min(Math.max(g2h(todayUTC()).y, H_YEAR_START), H_YEAR_END);
const _monthLinks = Array.from({ length: 12 }, (_, i) => ({ name: monthName(i + 1, true), href: monthBasePath(_curHy, i + 1, true) }));
const _monthNotesShort = ['مفتتح العام الهجري وأحد الأشهر الحُرم، يزيّنه صيام عاشوراء','سُمِّي بالصَّفَر لخلوّ ديار العرب وقت الأسفار والغزو','شهر مولد النبي ﷺ، تتعطّر فيه القلوب بذكر سيرته','رابع الشهور، تمام فصل الربيع في تسمية العرب','سُمِّيت جُمادى لتجمُّد الماء فيها زمن البرد','خاتمة الجُمادَيَيْن، تسبق دخول الأشهر الحُرم','من الأشهر الحُرم، وفيه ذكرى الإسراء والمعراج','تُرفع فيه الأعمال، ويكثر فيه الصيام استعدادًا لرمضان','شهر الصيام ونزول القرآن، وفيه ليلة القدر','يُستهلّ بعيد الفطر، ويُستحبّ صيام ستٍّ من أيامه','من الأشهر الحُرم، وفيه يتجهّز الحجيج لموسم الحج','موسم الحج وعيد الأضحى، وعشره الأوائل أفضل الأيام'];

const lang = 'ar';
const L = getL(true);
const _h = hadithOfDay(new Date());

const _featured = ['ramadan', 'eid-al-fitr', 'eid-al-adha', 'ashura', 'mawlid-al-nabi', 'islamic-new-year'];
const _homeYears = (() => { const y = new Date().getUTCFullYear(); return [y, y+1]; })();
const occLinks = [];
for (const _y of _homeYears) {
  for (const _slug of _featured) {
    const _o = OCCASIONS.find(x => x.slug === _slug);
    if (!_o) continue;
    const _occ = occurrencesInGYear(_o.hm, _o.hd, _y)[0];
    if (_occ) occLinks.push({ name: (true ? _o.ar : _o.en).name, year: _y, href: occBasePath(_slug, _y, true), date: _occ.date });
  }
}

const jsonLd = JSON.stringify([
  {
    "@context":"https://schema.org","@type":"WebApplication",
    "name":"التقويم الهجري","alternateName":"Hijri Calendar",
    "url":"https://islamicdates.org/",
    "description":"التقويم الهجري اليوم بالتاريخ الميلادي للمقارنة، مع تصفّح الأشهر الهجرية ومحوّل سريع بين الهجري والميلادي والمناسبات الإسلامية وفق تقويم أم القرى.",
    "applicationCategory":"UtilitiesApplication","operatingSystem":"Web",
    "inLanguage":["ar","en"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}
  },
  {
    "@context":"https://schema.org","@type":"FAQPage",
    "mainEntity": L.faqItems.map(f => ({ "@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a} }))
  }
]);
---

<Layout
  title="التقويم الهجري اليوم · تحويل التاريخ الهجري والميلادي | تقويم أم القرى"
  description="التقويم الهجري اليوم بالتاريخ الميلادي للمقارنة، مع تصفّح الأشهر الهجرية ومحوّل سريع بين الهجري والميلادي والمناسبات الإسلامية وفق تقويم أم القرى."
  canonical="https://islamicdates.org/"
  lang="ar"
  jsonLd={jsonLd}
>
  <header class="site-header">
    <a href="/" class="logo" style="text-decoration:none;color:inherit" aria-label="الصفحة الرئيسية">
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L.brand}</div>
        <div class="tagline">{L.tagline}</div>
      </div>
    </a>
    <a href="/en/" class="lang-btn">EN</a>
  </header>

  <div class="layout">
    <main>
      <!-- Today (live, client island) -->
      <TodayIsland lang="ar" client:load />

      <!-- Calendar (client island) -->
      <CalendarIsland lang="ar" client:load />

      <!-- Converter (client island) -->
      <div id="converter" style="scroll-margin-top:64px"><ConverterIsland lang="ar" client:visible /></div>

      <!-- Upcoming occasions (client island) -->
      <UpcomingIsland lang="ar" client:visible />

      <!-- Occasion year pages (SEO internal links) -->
      <section id="occasions" class="card section-card" style="order:5;scroll-margin-top:64px">
        <h2 class="section-h2">تواريخ المناسبات الإسلامية</h2>
        <p class="section-p" style="margin-bottom:14px">اعرف تاريخ كل مناسبة بالهجري والميلادي مع العدّ التنازلي</p>
        <div class="months-grid">
          {occLinks.map(o => (
            <a href={o.href} class="month-item" style="text-decoration:none;color:inherit">
              <div>
                <div class="month-name">{o.name} {o.year}</div>
                <div class="month-note">{fmtGShort(o.date, true)}</div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Hijri month browse (SEO internal links) -->
      <section class="card section-card" style="order:5">
        <h2 class="section-h2">تصفّح الأشهر الهجرية {_curHy} هـ</h2>
        <p class="section-p" style="margin-bottom:14px">استكشف أشهر العام الهجري شهرًا شهرًا، بمعانيها ومناسباتها وتواريخها الميلادية</p>
        <div class="months-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
          {_monthLinks.map((m, i) => (
            <a href={m.href} class="month-item" style="text-decoration:none;color:inherit">
              <span class="month-num">{i + 1}</span>
              <div><div class="month-name">{m.name}</div><div class="month-note">{_monthNotesShort[i]}</div></div>
            </a>
          ))}
        </div>
      </section>

      <!-- Content: What is / Diff / How -->
      <section class="card section-card" style="order:6">
        <h2 class="section-h2">{L.whatIsTitle}</h2>
        <p class="section-p">{L.whatIsBody}</p>
        <h2 class="section-h2" style="margin-top:22px">{L.diffTitle}</h2>
        <p class="section-p">{L.diffBody}</p>
        <h2 class="section-h2" style="margin-top:22px">{L.howTitle}</h2>
        <p class="section-p">{L.howBody}</p>
      </section>

      <!-- Hadith of the day -->
      <section class="card section-card" style="order:7;background:var(--accent-soft);border-color:var(--accent-soft)">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:10px">
          <span aria-hidden="true" style="font-size:22px;line-height:1">☾</span>
          <h2 class="section-h2" style="margin:0;color:var(--accent)">حديث اليوم</h2>
        </div>
        <div style="position:relative;padding:4px 2px 0">
          <span aria-hidden="true" style="position:absolute;top:-22px;inset-inline-start:-2px;font-size:60px;line-height:1;color:var(--accent);opacity:.16;font-family:Georgia,serif">”</span>
          <blockquote id="hadith-text" style="margin:0;border:0;padding:0;font-size:clamp(19px,2.9vw,26px);line-height:2.1;font-weight:700;color:var(--text);text-wrap:pretty">«{_h.ar}»</blockquote>
        </div>
        <div style="margin-top:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span id="hadith-src" style="display:inline-block;padding:5px 14px;border-radius:999px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:13px">{_h.arSrc}</span>
          <span style="color:var(--muted);font-size:12.5px">من صحيح البخاري ومسلم</span>
        </div>
      </section>
      <script define:vars={{ hList: HADITHS.map(h => ({ t: h.ar, s: h.arSrc })) }}>
        (function () {
          var d = new Date();
          var start = Date.UTC(d.getFullYear(), 0, 0);
          var day = Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - start) / 86400000);
          var h = hList[((day % hList.length) + hList.length) % hList.length];
          var t = document.getElementById('hadith-text');
          var s = document.getElementById('hadith-src');
          if (t) t.textContent = '«' + h.t + '»';
          if (s) s.textContent = h.s;
        })();
      </script>

      <!-- About + FAQ -->
      <section class="card section-card" style="order:8">
        <h2 class="section-h2">{L.aboutTitle}</h2>
        <p class="section-p">{L.aboutBody}</p>
        <h2 class="section-h2" style="margin-top:24px">{L.faqTitle}</h2>
        {L.faqItems.map(f => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <a href="/prayer-times/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">مواقيت الصلاة</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">أوقات الصلاة اليوم حسب موقعك</span></span>
      </a>

      <a href="/zakat/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">حاسبة الزكاة</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">احسب زكاة مالك وذهبك (2.5%)</span></span>
      </a>

      <!-- Ad slot -->
      <div class="ad-slot">
        <span class="ad-label">{L.ad}</span>
        <span style="font-size:13px;opacity:.7">300 × 250</span>
      </div>

      <!-- Legend -->
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">{L.legend}</h3>
        <div style="display:flex;flex-direction:column;gap:11px;font-size:14px">
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:50%;background:var(--accent);flex:0 0 auto"></span>{L.legendToday}</div>
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:50%;background:var(--gold);flex:0 0 auto"></span>{L.legendEid}</div>
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:50%;background:var(--holy);flex:0 0 auto"></span>{L.legendHoly}</div>
          <div style="display:flex;gap:11px;align-items:center"><span style="width:12px;height:12px;border-radius:4px;background:var(--accent-soft);border:1px solid var(--accent);flex:0 0 auto"></span>{L.legendRam}</div>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    {L.footer}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/contact/" style="color:var(--muted);text-decoration:none;font-size:13px">اتصل بنا</a>
  </footer>
</Layout>
