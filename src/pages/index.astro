        </div>
      </section>
      <script define:vars={{ hList: HADITHS.map(h => ({ t: h.ar, s: h.arSrc })) }}>
        (function () {
          var d = new Date();
          var start = Date.UTC(d.getFullYear(), 0, 0);
          var day = Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - start) / 86400000);
          var h = hList[((day % hList.length) + hList.length) % hList.length];
          var t = document.getElementById('hadith-text');
          var s = document.getElementById('hadith-src');
          if (t) t.textContent = '«' + h.t + '»';
          if (s) s.textContent = h.s;
        })();
      </script>

