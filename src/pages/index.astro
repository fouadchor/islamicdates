---
import Layout from '../layouts/Layout.astro';
import TodayIsland from '../components/TodayIsland';
import CalendarIsland from '../components/CalendarIsland';
import ConverterIsland from '../components/ConverterIsland';
import UpcomingIsland from '../components/UpcomingIsland';
import SidebarExtras from '../components/SidebarExtras.astro';
import HomeCityPrayer from '../components/HomeCityPrayer.astro';
import { H_MON_AR, MONTHS_NOTES_AR, G_MON_AR } from '../lib/data';
import { getL } from '../lib/data';
import { HADITHS, hadithOfDay } from '../lib/hadiths';
import { OCCASIONS, occurrencesInGYear, occBasePath, fmtGShort } from '../lib/occasions';
import { g2h, h2g, todayUTC } from '../lib/hijri';
import { monthBasePath, monthName, monthSlug, H_YEAR_START, H_YEAR_END } from '../lib/months';
import { eventForDay, eventsOfMonth, otdPath, fmtHDay, whatsappHref } from '../lib/onthisday';

// --- Request-time SSR + fresh CDN cache (fixes stale build-time date) ---
export const prerender = false;
// Keep the edge copy fresh: expires at the next Riyadh midnight, capped to 1h,
// so the server-rendered date can never sit a day behind.
const _tParts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Riyadh', hourCycle: 'h23', hour: '2-digit', minute: '2-digit', second: '2-digit' }).formatToParts(new Date());
const _tp = (t: string) => Number(_tParts.find(p => p.type === t)?.value ?? 0);
const _secsToMidnight = 86400 - (_tp('hour') * 3600 + _tp('minute') * 60 + _tp('second'));
const _ttl = Math.max(60, Math.min(_secsToMidnight, 3600));
Astro.response.headers.set('Cache-Control', `public, max-age=0, s-maxage=${_ttl}, stale-while-revalidate=86400`);
// ------------------------------------------------------------------------

const _curHy = Math.min(Math.max(g2h(todayUTC()).y, H_YEAR_START), H_YEAR_END);
const _monthLinks = Array.from({ length: 12 }, (_, i) => ({ name: monthName(i + 1, true), href: monthBasePath(_curHy, i + 1, true) }));
const _monthNotesShort = ['مفتتح العام الهجري وأحد الأشهر الحُرم، يزيّنه صيام عاشوراء','سُمِّي بالصَّفَر لخلوّ ديار العرب وقت الأسفار والغزو','شهر مولد النبي ﷺ، تتعطّر فيه القلوب بذكر سيرته','رابع الشهور، تمام فصل الربيع في تسمية العرب','سُمِّيت جُمادى لتجمُّد الماء فيها زمن البرد','خاتمة الجُمادَيَيْن، تسبق دخول الأشهر الحُرم','من الأشهر الحُرم، وفيه ذكرى الإسراء والمعراج','تُرفع فيه الأعمال، ويكثر فيه الصيام استعدادًا لرمضان','شهر الصيام ونزول القرآن، وفيه ليلة القدر','يُستهلّ بعيد الفطر، ويُستحبّ صيام ستٍّ من أيامه','من الأشهر الحُرم، وفيه يتجهّز الحجيج لموسم الحج','موسم الحج وعيد الأضحى، وعشره الأوائل أفضل الأيام'];

const lang = 'ar';
const L = getL(true);
const _h = hadithOfDay(new Date());

// «في مثل هذا اليوم الهجري» — حدث اليوم (SSR عند كل طلب) + شريط أحداث الشهر التفاعلي
const _otdH = g2h(todayUTC());
const _otd = eventForDay(_otdH.m, _otdH.d, new Date().getUTCFullYear());
const _otdIcon = (t: string): string => {
  if (/الإمام|الحافظ|شيخ الإسلام|الفيلسوف|مكتشف|صاحب/.test(t)) return '📚';
  if (/غزوة|معركة|حصار|وقعة|صفّين|الخندق/.test(t)) return '⚔️';
  if (/فتح|استرداد|تحرير/.test(t)) return '🕌';
  if (/وفاة|استشهاد|مقتل|طعن/.test(t)) return '🕯️';
  if (/مولد|ولادة/.test(t)) return '🌟';
  if (/بيعة|خلافة|دولة|سلطان|تقويم/.test(t)) return '👑';
  return '📜';
};
const _otdAgo = (y: string): number | null => {
  const m = y.match(/^(\d+)\s*هـ/);
  return m ? _otdH.y - parseInt(m[1], 10) : null;
};
const _otdMonthEvents = eventsOfMonth(_otdH.m).map(e => ({
  slug: e.slug, hd: e.hd, title: e.title, year: e.year, summary: e.summary,
  source: e.source, disputed: e.disputed || '', icon: _otdIcon(e.title),
  ago: _otdAgo(e.year), path: otdPath(e.slug), hDate: fmtHDay(e.hm, e.hd),
}));
const _otdCur = _otdMonthEvents.find(e => e.slug === _otd.ev.slug) || _otdMonthEvents[0];
const _otdWa = whatsappHref(_otd.ev);
const _otdMonthName = H_MON_AR[_otdH.m - 1];

const _featured = OCCASIONS.map(o => o.slug); // all occasions, ordered by date below
const _homeYears = (() => { const y = new Date().getUTCFullYear(); return [y, y+1]; })();
const occLinks = [];
for (const _y of _homeYears) {
  for (const _slug of _featured) {
    const _o = OCCASIONS.find(x => x.slug === _slug);
    if (!_o) continue;
    const _occ = occurrencesInGYear(_o.hm, _o.hd, _y)[0];
    if (_occ) occLinks.push({ slug: _slug, name: _o.ar.name, year: _y, href: occBasePath(_slug, _y, true), date: _occ.date });
  }
}
occLinks.sort((a, b) => a.year - b.year || a.date.getTime() - b.date.getTime());

// Split each listed year into upcoming vs already-passed occurrences so the
// section never leads with stale dates. Passed items stay in the DOM (inside a
// collapsed <details>) to keep their internal links crawlable.
const _todayMs = todayUTC().getTime();
const _yearGroups = _homeYears.map(_yr => ({
  year: _yr,
  upcoming: occLinks.filter(o => o.year === _yr && o.date.getTime() >= _todayMs),
  past: occLinks.filter(o => o.year === _yr && o.date.getTime() < _todayMs),
})).filter(g => g.upcoming.length > 0 || g.past.length > 0);

// —— Internal-linking depth: Gregorian spans on month cards + cross-year month funnel ——
const _gSpan = (hy: number, hm: number): string => {
  const _s = h2g(hy, hm, 1);
  const _n = hm < 12 ? h2g(hy, hm + 1, 1) : h2g(hy + 1, 1, 1);
  const _e = new Date(_n.getTime() - 86400000);
  const sM = _s.getUTCMonth(), sY = _s.getUTCFullYear();
  const eM = _e.getUTCMonth(), eY = _e.getUTCFullYear();
  if (sM === eM && sY === eY) return `${G_MON_AR[sM]} ${sY}`;
  if (sY === eY) return `${G_MON_AR[sM]} – ${G_MON_AR[eM]} ${sY}`;
  return `${G_MON_AR[sM]} ${sY} – ${G_MON_AR[eM]} ${eY}`;
};
const _monthGreg = Array.from({ length: 12 }, (_, i) => _gSpan(_curHy, i + 1));
const _keyMonths = [
  { hm: 1, note: 'عاشوراء ورأس السنة الهجرية' },
  { hm: 7, note: 'الإسراء والمعراج' },
  { hm: 8, note: 'ليلة النصف من شعبان' },
  { hm: 9, note: 'الصيام وليلة القدر' },
  { hm: 10, note: 'عيد الفطر' },
  { hm: 12, note: 'الحج وعيد الأضحى' },
];
const _yStart = Math.max(H_YEAR_START, _curHy - 3);
const _yEnd = Math.min(H_YEAR_END, _curHy + 3);
const _keyMonthRows = _keyMonths.map(k => ({
  name: monthName(k.hm, true), note: k.note, slug: monthSlug(k.hm),
  years: Array.from({ length: _yEnd - _yStart + 1 }, (_, j) => {
    const _y = _yStart + j;
    return { hy: _y, gy: h2g(_y, k.hm, 1).getUTCFullYear(), href: monthBasePath(_y, k.hm, true) };
  }),
}));

const jsonLd = JSON.stringify([
  {
    "@context":"https://schema.org","@type":"WebSite",
    "@id":"https://islamicdates.org/#website",
    "name":"التقويم الهجري","alternateName":["Hijri Calendar","Islamic Dates","islamicdates.org"],
    "url":"https://islamicdates.org/","inLanguage":["ar","en","ur"],
    "publisher":{"@id":"https://islamicdates.org/#organization"}
  },
  {
    "@context":"https://schema.org","@type":"Organization",
    "@id":"https://islamicdates.org/#organization",
    "name":"التقويم الهجري","alternateName":"Hijri Calendar · islamicdates.org",
    "url":"https://islamicdates.org/",
    "logo":{"@type":"ImageObject","url":"https://islamicdates.org/og-image.png","width":1200,"height":630},
    "image":"https://islamicdates.org/og-image.png",
    "description":"موقع التقويم الهجري يعرض التاريخ الهجري اليوم وفق تقويم أم القرى، مع محوّل بين الهجري والميلادي والمناسبات الإسلامية ومواقيت الصلاة وحاسبة الزكاة."
  },
  {
    "@context":"https://schema.org","@type":"WebApplication",
    "@id":"https://islamicdates.org/#webapp",
    "name":"التقويم الهجري","alternateName":"Hijri Calendar",
    "url":"https://islamicdates.org/",
    "description":"التقويم الهجري اليوم بالتاريخ الميلادي للمقارنة، مع تصفّح الأشهر الهجرية ومحوّل سريع بين الهجري والميلادي والمناسبات الإسلامية وفق تقويم أم القرى.",
    "applicationCategory":"UtilitiesApplication","operatingSystem":"Web",
    "inLanguage":["ar","en"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}
  },
]);
---

<Layout
  title="التقويم الهجري اليوم · تحويل التاريخ الهجري والميلادي | تقويم أم القرى"
  description="التقويم الهجري اليوم بالتاريخ الميلادي للمقارنة، مع تصفّح الأشهر الهجرية ومحوّل سريع بين الهجري والميلادي والمناسبات الإسلامية وفق تقويم أم القرى."
  canonical="https://islamicdates.org/"
  lang="ar"
  jsonLd={jsonLd}
>
  <header class="site-header">
    <a href="/" class="logo" style="text-decoration:none;color:inherit" aria-label="الصفحة الرئيسية">
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L.brand}</div>
        <div class="tagline">{L.tagline}</div>
      </div>
    </a>
  </header>

  <div class="layout">
    <main>
      <!-- Today (live, client island) -->
      <TodayIsland lang="ar" todayIso={todayUTC().toISOString().slice(0, 10)} client:load />

      <!-- Calendar (client island) -->
      <CalendarIsland lang="ar" client:load />

      <!-- Converter (client island) -->
      <div id="converter" style="scroll-margin-top:64px"><ConverterIsland lang="ar" client:visible /></div>

      <!-- Upcoming occasions (client island) — order:3 so the OTD card sits above it -->
      <div style="order:3"><UpcomingIsland lang="ar" client:visible /></div>

      <!-- Decorative section divider -->
      <img src="/images/divider-ornament.svg" alt="" role="presentation" width="1200" height="70"
        loading="lazy" decoding="async" style="order:5;width:100%;height:auto;display:block;margin:-2px 0" />

      <!-- Occasion year pages (SEO internal links) -->
      <!-- Prayer times by city (internal links to city pages) -->
      <HomeCityPrayer lang="ar" />

      <section id="occasions" class="card section-card" style="order:5;scroll-margin-top:64px">
        <h2 class="section-h2">تواريخ المناسبات الإسلامية</h2>
        <p class="section-p" style="margin-bottom:14px">اعرف تاريخ كل مناسبة بالهجري والميلادي مع العدّ التنازلي</p>
        {_yearGroups.map((_g, _i) => { const _yr = _g.year; return (
          <div style={`margin-top:${_i === 0 ? 4 : 26}px`}>
            <h3 style="margin:0 0 12px;font-size:16px;font-weight:700;color:var(--accent)">مناسبات {_yr}</h3>
            {_g.upcoming.length > 0 && (
              <div class="months-grid">
                {_g.upcoming.map(o => (
                  <a href={o.href} class="month-item" style="text-decoration:none;color:inherit">
                  <div>
                    <div class="month-name">{o.name} {o.year}</div>
                    <div class="month-note">{fmtGShort(o.date, true)}</div>
                  </div>
                </a>
                ))}
              </div>
            )}
            {_g.past.length > 0 && (
              <details class="occ-past">
                <summary>مناسبات {_yr} التي مضت ({_g.past.length})</summary>
                <div class="months-grid" style="margin-top:10px">
                  {_g.past.map(o => (
                    <a href={o.href} class="month-item" style="text-decoration:none;color:inherit">
                  <div>
                    <div class="month-name">{o.name} {o.year}</div>
                    <div class="month-note">{fmtGShort(o.date, true)}</div>
                  </div>
                </a>
                  ))}
                </div>
              </details>
            )}
          </div>
        ); })}
      </section>

      <!-- Hijri month browse (SEO internal links) -->
      <section class="card section-card" style="order:5">
        <h2 class="section-h2">تصفّح الأشهر الهجرية {_curHy} هـ</h2>
        <p class="section-p" style="margin-bottom:14px">استكشف أشهر العام الهجري شهرًا شهرًا، بمعانيها ومناسباتها وتواريخها الميلادية</p>
        <div class="months-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
          {_monthLinks.map((m, i) => (
            <a href={m.href} class="month-item" style="text-decoration:none;color:inherit">
              <span class="month-num">{i + 1}</span>
              <div><div class="month-name">{m.name}</div><div class="month-note">{_monthNotesShort[i]}</div><div style="font-size:12px;color:var(--accent);font-weight:600;margin-top:3px">{_monthGreg[i]}</div></div>
            </a>
          ))}
        </div>
      </section>

            <!-- Key months across Hijri years (SEO internal links to month pages) -->
      <section class="card section-card" style="order:5">
        <h2 class="section-h2">أشهر بارزة عبر السنوات الهجرية</h2>
        <p class="section-p" style="margin-bottom:16px">انتقل مباشرةً إلى شهر المناسبة في أي سنة هجرية تريدها — مع تاريخه الميلادي المقابل</p>
        <div style="display:flex;flex-direction:column;gap:16px">
          {_keyMonthRows.map(row => (
            <div>
              <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:9px">
                <span style="font-weight:700;font-size:15.5px">{row.name}</span>
                <span style="font-size:12.5px;color:var(--muted)">{row.note}</span>
              </div>
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                {row.years.map(y => (
                  <a href={y.href} class="yr-chip" aria-label={`${row.name} ${y.hy} هـ`}>
                    <span class="yc-h">{y.hy} هـ</span>
                    <span class="yc-g">{y.gy}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
        <style>
          .yr-chip { display:inline-flex; flex-direction:column; align-items:center; gap:1px; padding:7px 14px; border-radius:11px; background:var(--surface2); border:1px solid var(--border); text-decoration:none; transition:border-color .2s, transform .2s, box-shadow .2s; }
          .yr-chip:hover { border-color:var(--accent); transform:translateY(-1px); box-shadow:var(--shadow); }
          .yr-chip .yc-h { font-weight:700; font-size:13.5px; color:var(--accent); }
          .yr-chip .yc-g { font-size:11.5px; color:var(--muted); }
        </style>
      </section>

      <!-- On this day in Hijri history (في مثل هذا اليوم الهجري) — manuscript card (order:2 → right after the converter, before upcoming occasions) -->
      <section class="card section-card" style="order:2;position:relative;overflow:hidden;background:linear-gradient(140deg,#10312f 0%,#0c4a44 55%,#0a5a54 100%);border-color:transparent;color:#eafaf6">
        <span aria-hidden="true" style="position:absolute;top:-24px;inset-inline-end:-10px;font-size:110px;opacity:.09;transform:rotate(12deg);color:#fbbf24">✦</span>
        <span aria-hidden="true" style="position:absolute;bottom:-34px;inset-inline-start:-12px;font-size:120px;opacity:.09;color:#fbbf24">☾</span>
        <span id="otd-ghost" aria-hidden="true" style="position:absolute;bottom:-38px;inset-inline-end:6px;font-size:clamp(80px,14vw,150px);font-weight:800;line-height:1;color:rgba(251,191,36,.10);pointer-events:none;font-variant-numeric:tabular-nums">{_otdCur.year.replace(' هـ','')}</span>

        <div style="position:relative">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:4px">
            <h2 class="section-h2" style="margin:0;color:#fff">📜 في مثل هذا اليوم الهجري</h2>
            <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);font-weight:700;font-size:12.5px;color:#d5efe9">☾ اليوم {_otdH.d} {_otdMonthName} {_otdH.y} هـ</span>
          </div>
          <p style="margin:0 0 16px;font-size:13px;color:#9fd4c9">{_otd.exact
            ? 'صفحة من ذاكرة الأمة تُقلَّب كل يوم — حدثٌ وقع في مثل هذا اليوم الهجري'
            : `لم يثبت حدثٌ بعينه بتاريخ اليوم (${_otdH.d} ${_otdMonthName})، فإليك من أبرز أحداث الشهر:`}</p>

          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
            <span id="otd-ago" style={`display:${_otdCur.ago !== null ? 'inline-flex' : 'none'};align-items:center;gap:6px;padding:6px 15px;border-radius:999px;background:#fbbf24;color:#4a2b00;font-weight:800;font-size:13.5px;box-shadow:0 3px 10px rgba(0,0,0,.25)`}>⏳ قبل {_otdCur.ago} سنة</span>
            <span id="otd-year" style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(251,191,36,.5);color:#ffd97a;font-weight:700;font-size:13px">{_otdCur.year}</span>
            <span id="otd-day" style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.12);color:#d5efe9;font-weight:700;font-size:13px">{_otdCur.hDate}</span>
            <span id="otd-flag" style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(94,234,212,.16);color:#8ff5e2;font-weight:700;font-size:12.5px">{_otdCur.hd === _otdH.d ? '✨ حدث هذا اليوم نفسه' : `من أبرز أحداث شهر ${_otdMonthName}`}</span>
          </div>

          <div style="display:flex;gap:14px;align-items:flex-start">
            <span id="otd-icon" aria-hidden="true" style="font-size:44px;line-height:1.2;flex:0 0 auto;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35))">{_otdCur.icon}</span>
            <div style="flex:1 1 auto;min-width:0">
              <h3 style="margin:0 0 8px;font-size:clamp(18px,2.8vw,23px);font-weight:800;line-height:1.6">
                <a id="otd-title" href={_otdCur.path} style="color:#fff;text-decoration:none">{_otdCur.title}</a>
              </h3>
              <p id="otd-summary" class="section-p" style="color:#d9efe9;margin:0">{_otdCur.summary}</p>
            </div>
          </div>

          <div id="otd-disp" style={`margin-top:14px;display:${_otdCur.disputed ? 'flex' : 'none'};gap:9px;align-items:flex-start;padding:11px 14px;border-radius:12px;background:rgba(251,191,36,.13);border:1px solid rgba(251,191,36,.4)`}>
            <span aria-hidden="true" style="font-size:16px;line-height:1.5">⚠️</span>
            <p style="margin:0;font-size:12.5px;line-height:1.9;color:#ffe9b3"><strong>اختلاف الروايات:</strong> <span id="otd-disp-txt">{_otdCur.disputed}</span></p>
          </div>
          <p style="margin:12px 0 0;font-size:12.5px;color:#9fd4c9">📚 المصدر: <span id="otd-src">{_otdCur.source}</span></p>

          <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <a id="otd-read" href={_otdCur.path} style="display:inline-flex;align-items:center;gap:7px;padding:11px 22px;border-radius:999px;background:#fbbf24;color:#4a2b00;font-weight:800;font-size:14px;text-decoration:none;box-shadow:0 4px 14px rgba(0,0,0,.25)">اقرأ القصة كاملة ›</a>
            <a id="otd-wa" href={_otdWa} target="_blank" rel="noopener" aria-label="مشاركة الحدث على واتساب" style="display:inline-flex;align-items:center;gap:7px;padding:11px 20px;border-radius:999px;background:#25D366;color:#fff;font-weight:700;font-size:14px;text-decoration:none">
