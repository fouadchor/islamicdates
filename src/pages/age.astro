---
import Layout from '../layouts/Layout.astro';
import AgeIsland from '../components/AgeIsland';

const canonical = 'https://islamicdates.org/age/';
const title = 'حاسبة العمر بالهجري · احسب عمرك بالتقويم الهجري والميلادي';
const description = 'حاسبة العمر بالهجري: احسب عمرك بالسنوات والأشهر والأيام وفق التقويم الهجري والميلادي، واعرف تاريخ ميلادك الهجري ويوم مولدك والعدّ التنازلي لعيد ميلادك القادم.';

const faq = [
  { q: 'كيف أحسب عمري بالتقويم الهجري؟', a: 'استخدم حاسبة العمر أعلاه: أدخل تاريخ ميلادك (هجرياً أو ميلادياً) وستظهر لك عمرك بالسنوات والأشهر والأيام وفق التقويمين الهجري والميلادي فوراً، مع تاريخ ميلادك في كلا التقويمين.' },
  { q: 'لماذا يختلف عمري الهجري عن عمري الميلادي؟', a: 'لأن السنة الهجرية القمرية أقصر من السنة الميلادية بنحو 11 يوماً، فيكون عمرك بالتقويم الهجري أكبر قليلاً من عمرك الميلادي، ويزداد الفرق بمقدار سنة كاملة كل 33 سنة تقريباً.' },
  { q: 'كيف أعرف تاريخ ميلادي بالهجري ويوم مولدي؟', a: 'أدخل تاريخ ميلادك الميلادي في الحاسبة، وستظهر لك تاريخ ميلادك الهجري المقابل، ويوم الأسبوع الذي وُلدت فيه، إضافةً إلى إجمالي الأيام التي عشتها.' },
  { q: 'هل حساب العمر دقيق؟', a: 'يُحسب العمر فلكياً وفق تقويم أم القرى المعتمد في السعودية. وقد يختلف التاريخ بمقدار يوم واحد عن التقويم المعتمد على رؤية الهلال المباشرة في بعض الدول.' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://islamicdates.org/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'حاسبة العمر بالهجري', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'حاسبة العمر بالهجري', 'url': canonical,
    'applicationCategory': 'UtilitiesApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en', 'ur'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ar" jsonLd={jsonLd} arPath="/age/" enPath="/en/age/" urPath="/ur/age/">
  <header class="site-header">
    <div class="header-start">
      <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">التقويم الهجري</div>
          <div class="tagline">حاسبة العمر</div>
        </div>
      </a>
      <a href="/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>الرئيسية</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">حاسبة العمر بالهجري</h1>
        <p class="section-p" style="margin-top:8px">احسب عمرك بدقّة وفق التقويمين الهجري والميلادي. أدخل تاريخ ميلادك — هجرياً أو ميلادياً — لتعرف عمرك بالسنوات والأشهر والأيام، وتاريخ ميلادك في كلا التقويمين، ويوم الأسبوع الذي وُلدت فيه، والعدّ التنازلي لعيد ميلادك القادم.</p>
      </section>

      <AgeIsland lang="ar" client:load />

      <section class="card section-card">
        <h2 class="section-h2">كيف يُحسب العمر بالهجري؟</h2>
        <p class="section-p">يُحوّل تاريخ ميلادك إلى التقويم الهجري ثم يُقارن باليوم الحالي لحساب الفارق بالسنوات والأشهر والأيام. ولأن السنة الهجرية أقصر من الميلادية بنحو 11 يوماً، يكون عمرك بالهجري أكبر قليلاً من عمرك الميلادي.</p>
        <h2 class="section-h2" style="margin-top:22px">الفرق بين العمر الهجري والميلادي</h2>
        <p class="section-p">يتراكم فارق الأحد عشر يوماً سنوياً حتى يبلغ سنة كاملة كل 33 سنة ميلادية تقريباً. لذلك من وُلد قبل 33 سنة ميلادية يكون عمره نحو 34 سنة هجرية. تعرض الحاسبة الرقمين معاً لتوضيح الفرق.</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">أسئلة شائعة</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">أدوات ذات صلة</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/" style="color:var(--accent);text-decoration:none">التقويم الهجري وتاريخ اليوم</a>
          <a href="/#converter" style="color:var(--accent);text-decoration:none">محوّل التاريخ الهجري والميلادي</a>
          <a href="/zakat/" style="color:var(--accent);text-decoration:none">حاسبة الزكاة</a>
          <a href="/prayer-times/" style="color:var(--accent);text-decoration:none">مواقيت الصلاة</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    الحساب وفق تقويم أم القرى
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
  </footer>
</Layout>
