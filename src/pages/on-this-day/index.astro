---
import Layout from '../../layouts/Layout.astro';
import { OTD_EVENTS, otdPath, fmtHDay, whatsappHref, eventForDay, eventsOfMonth } from '../../lib/onthisday';
import { H_MON_AR } from '../../lib/data';
import { g2h, todayUTC } from '../../lib/hijri';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');

const h = g2h(todayUTC());
const rot = new Date().getUTCFullYear();
const { ev, exact } = eventForDay(h.m, h.d, rot);
const todayHStr = `${h.d} ${H_MON_AR[h.m - 1]} ${h.y} هـ`;
const waHref = whatsappHref(ev);

const canonical = 'https://islamicdates.org/on-this-day/';
const title = 'في مثل هذا اليوم الهجري · أحداث التاريخ الإسلامي يوماً بيوم';
const description = 'حدث تاريخي إسلامي لكل يوم هجري: الغزوات والفتوحات ووفيات الأعلام بمصادرها الموثوقة، مع قصة كاملة لكل حدث وتنبيه عند اختلاف الروايات في التاريخ.';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: 'في مثل هذا اليوم الهجري', url: canonical, inLanguage: 'ar', description,
    isPartOf: { '@type': 'WebSite', name: 'التقويم الهجري', url: 'https://islamicdates.org/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://islamicdates.org/' },
    { '@type': 'ListItem', position: 2, name: 'في مثل هذا اليوم الهجري', item: canonical },
  ] },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ar" jsonLd={jsonLd}
  arPath="/on-this-day/" enPath="/en/on-this-day/" urPath="/ur/on-this-day/">
  <header class="site-header">
    <div class="header-start">
      <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">التقويم الهجري</div>
          <div class="tagline">في مثل هذا اليوم الهجري</div>
        </div>
      </a>
      <a href="/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>الرئيسية</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="border-color:var(--accent)">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:12px">
          <span aria-hidden="true" style="font-size:22px;line-height:1;color:var(--accent)">📜</span>
          <h1 class="section-h2" style="margin:0;font-size:22px">في مثل هذا اليوم الهجري</h1>
        </div>
        <p class="section-p" style="margin-bottom:16px">اليوم <strong>{todayHStr}</strong> وفق تقويم أم القرى.</p>

        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
          <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:700;font-size:13.5px">☾ {fmtHDay(ev.hm, ev.hd)}</span>
          <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:var(--gold-soft);color:var(--gold-deep);font-weight:700;font-size:13.5px">{ev.year}</span>
          {!exact && <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:var(--accent-soft);color:var(--muted);font-weight:600;font-size:12.5px">من أبرز أحداث شهر {H_MON_AR[ev.hm - 1]}</span>}
        </div>

        <h2 style="margin:0 0 10px;font-size:clamp(19px,3vw,24px);font-weight:700;line-height:1.5">
          <a href={otdPath(ev.slug)} style="color:inherit;text-decoration:none">{ev.title}</a>
        </h2>
        <p class="section-p">{ev.summary}</p>

        {ev.disputed && (
          <div style="margin-top:14px;display:flex;gap:10px;align-items:flex-start;padding:12px 15px;border-radius:12px;background:rgba(251,191,36,.12);border:1px solid rgba(217,164,6,.35)">
            <span aria-hidden="true" style="font-size:17px;line-height:1.4">⚠️</span>
            <p style="margin:0;font-size:13px;line-height:1.9;color:var(--text)"><strong>اختلاف الروايات:</strong> {ev.disputed}</p>
          </div>
        )}

        <p style="margin:14px 0 0;font-size:13px;color:var(--muted)">📚 المصدر: {ev.source}</p>

        <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap">
          <a href={otdPath(ev.slug)} style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:11px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;text-decoration:none">اقرأ القصة كاملة ›</a>
          <a href={waHref} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:11px;background:#25D366;color:#fff;font-weight:700;font-size:14px;text-decoration:none">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            شارك على واتساب
          </a>
        </div>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">أرشيف الأحداث بالشهور الهجرية</h2>
        <p class="section-p" style="margin-bottom:6px">{OTD_EVENTS.length} حدثاً موثقاً بمصادره، ونضيف المزيد باستمرار. الأيام التي لا حدث موثقاً فيها بتاريخها الدقيق يُعرض فيها أقرب حدث في الشهر نفسه.</p>
        {H_MON_AR.map((mName, i) => {
          const evs = eventsOfMonth(i + 1);
          if (!evs.length) return null;
          return (
            <div style="margin-top:22px">
              <h3 style="margin:0 0 12px;font-size:16px;font-weight:700;color:var(--accent)">{mName}</h3>
              <div class="months-grid">
                {evs.map(e => (
                  <a href={otdPath(e.slug)} class="month-item" style="text-decoration:none;color:inherit">
                    <span class="month-num">{e.hd}</span>
                    <div>
                      <div class="month-name">{e.title}</div>
                      <div class="month-note">{e.year}{e.disputed ? ' · ⚠️ في تاريخه خلاف' : ''}</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </section>
    </main>
  </div>
</Layout>
