---
import Layout from '../layouts/Layout.astro';
import PrintCalendarIsland from '../components/PrintCalendarIsland';

const canonical = 'https://islamicdates.org/printable/';
const title = 'تقويم هجري للطباعة · حمّل التقويم الهجري PDF و PNG (شهري وسنوي)';
const description = 'تقويم هجري جاهز للطباعة والتحميل بصيغة PDF أو PNG — شهرياً أو سنة كاملة، بالتاريخ الهجري والميلادي ومناسباته وفق تقويم أم القرى. اختر السنة واطبع أو نزّل بنقرة.';

const faq = [
  { q: 'هل التقويم مجاني للطباعة والمشاركة؟', a: 'نعم، يمكنك تنزيل التقويم الهجري وطباعته ومشاركته مجاناً، سواء شهراً واحداً أو السنة كاملة، دون أي قيود.' },
  { q: 'ما صيغ التحميل المتاحة؟', a: 'يمكنك التحميل بصيغة PDF المناسبة للطباعة على ورق A4، أو بصيغة صورة PNG عالية الدقة للمشاركة على وسائل التواصل والمواقع.' },
  { q: 'هل التقويم بالتاريخ الهجري والميلادي معاً؟', a: 'نعم، يعرض كل يوم رقمه الهجري مع التاريخ الميلادي المقابل، ويُبرز المناسبات الإسلامية ويوم اليوم بلون مميز.' },
  { q: 'على أي تقويم يعتمد الحساب؟', a: 'يعتمد على تقويم أم القرى المحسوب فلكياً. وقد تختلف بدايات بعض الأشهر بمقدار يوم حسب رؤية الهلال المباشرة في بعض الدول.' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://islamicdates.org/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'تقويم هجري للطباعة', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'تقويم هجري للطباعة', 'url': canonical,
    'applicationCategory': 'UtilitiesApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en', 'ur'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ar" jsonLd={jsonLd} arPath="/printable/" enPath="/en/printable/" urPath="/ur/printable/">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <header class="site-header no-print">
    <div class="header-start">
      <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">التقويم الهجري</div>
          <div class="tagline">تقويم للطباعة</div>
        </div>
      </a>
      <a href="/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>الرئيسية</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card no-print" style="order:1">
        <h1 class="section-h2" style="font-size:25px">تقويم هجري للطباعة والتحميل</h1>
        <p class="section-p" style="margin-top:8px">حمّل التقويم الهجري جاهزاً للطباعة بصيغة PDF أو صورة PNG — شهراً واحداً أو السنة كاملة. اختر السنة الهجرية ثم نزّل الملف أو اطبعه مباشرة. يعرض كل يوم بالتاريخ الهجري والميلادي مع إبراز المناسبات الإسلامية وتمييز يوم اليوم.</p>
      </section>

      <PrintCalendarIsland lang="ar" client:load />

      <section class="card section-card no-print">
        <h2 class="section-h2">كيف أطبع التقويم أو أحمّله؟</h2>
        <p class="section-p">اختر «السنة كاملة» أو «شهر واحد»، وحدّد السنة الهجرية بالزرّين + و −. ثم اضغط «تنزيل PDF» للحصول على ملف جاهز للطباعة على ورق A4، أو «تنزيل PNG» لصورة عالية الدقة للمشاركة، أو «طباعة» لطباعته فوراً أو حفظه بصيغة PDF من نافذة الطباعة.</p>
      </section>

      <section class="card section-card no-print">
        <h2 class="section-h2">أسئلة شائعة</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside class="no-print">
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">أدوات ذات صلة</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/" style="color:var(--accent);text-decoration:none">التقويم الهجري وتاريخ اليوم</a>
          <a href="/#converter" style="color:var(--accent);text-decoration:none">محوّل التاريخ الهجري والميلادي</a>
          <a href="/age/" style="color:var(--accent);text-decoration:none">حاسبة العمر بالهجري</a>
          <a href="/zakat/" style="color:var(--accent);text-decoration:none">حاسبة الزكاة</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer no-print">
    الحساب وفق تقويم أم القرى
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
  </footer>

  <style is:global>
    @media print {
      .site-nav, .no-print { display: none !important; }
      .layout { display: block !important; padding: 0 !important; max-width: 100% !important; }
      main { gap: 0 !important; }
      #print-sheet { border: none !important; box-shadow: none !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      @page { margin: 10mm; }
    }
  </style>
</Layout>
