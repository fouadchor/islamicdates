---
import Layout from '../layouts/Layout.astro';
import PrayerTimesIsland from '../components/PrayerTimesIsland';
import PrayerDirectory from '../components/PrayerDirectory.astro';
import NearbyMosquesIsland from '../components/NearbyMosquesIsland';

const ar = true;
const canonical = 'https://islamicdates.org/prayer-times/';
const title = 'مواقيت الصلاة اليوم حسب موقعك · الفجر والظهر والعصر والمغرب والعشاء';
const description = 'مواقيت الصلاة اليوم (الفجر، الشروق، الظهر، العصر، المغرب، العشاء) محسوبة فلكياً حسب موقعك مع العد التنازلي للصلاة القادمة، وعدة طرق حساب منها أم القرى.';

const faq = [
  { q: 'كيف تُحسب مواقيت الصلاة في هذا الموقع؟', a: 'تُحسب المواقيت فلكياً اعتماداً على إحداثيات موقعك (خط الطول والعرض) وزاوية الشمس، وفق طريقة الحساب التي تختارها مثل أم القرى أو رابطة العالم الإسلامي. يمكنك السماح بالوصول إلى موقعك أو اختيار مدينتك يدوياً.' },
  { q: 'ما الفرق بين طرق الحساب المختلفة؟', a: 'تختلف الطرق في زاوية الشمس المعتمدة لحساب الفجر والعشاء. فمثلاً تعتمد أم القرى زاوية 18.5° للفجر والعشاء بعد المغرب بـ90 دقيقة، بينما تعتمد رابطة العالم الإسلامي 18° للفجر و17° للعشاء. اختر الطريقة المعتمدة في بلدك.' },
  { q: 'ما الفرق بين العصر عند الجمهور والحنفية؟', a: 'يبدأ وقت العصر عند جمهور الفقهاء عندما يصير ظل الشيء مثله، وعند الحنفية عندما يصير ظل الشيء مثليه، فيتأخر وقت العصر قليلاً في المذهب الحنفي. يمكنك اختيار المذهب من الإعدادات.' },
  { q: 'هل المواقيت دقيقة تماماً؟', a: 'المواقيت محسوبة بدقة فلكية عالية، لكنها قد تختلف بدقائق قليلة عن الجداول الرسمية بسبب اختلاف الارتفاع ودرجة الانكسار الجوي وطريقة التقريب. يُنصح بمراجعة الإعلان الرسمي في بلدك للاحتياط.' },
  { q: 'كيف أجد الجوامع القريبة من مكاني؟', a: 'في قسم «الجوامع القريبة من مكاني» أسفل مواقيت الصلاة، اضغط زر «اعرض الجوامع القريبة مني» واسمح للمتصفح بالوصول إلى موقعك، فتظهر لك أقرب المساجد مرتّبة حسب المسافة مع رابط اتجاهات لكل مسجد. البيانات من خرائط OpenStreetMap ولا يُخزَّن موقعك لدينا.' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://islamicdates.org/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'مواقيت الصلاة', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'مواقيت الصلاة', 'url': canonical,
    'applicationCategory': 'UtilitiesApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ar" jsonLd={jsonLd} arPath="/prayer-times/" enPath="/en/prayer-times/" urPath="/ur/prayer-times/">
  <header class="site-header">
    <div class="header-start">
    <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">التقويم الهجري</div>
        <div class="tagline">مواقيت الصلاة</div>
      </div>
    </a>
      <a href="/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>الرئيسية</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">مواقيت الصلاة اليوم</h1>
        <p class="section-p" style="margin-top:8px">اعرف مواقيت الصلاة الخمس (الفجر، الظهر، العصر، المغرب، العشاء) ووقت الشروق حسب موقعك، مع عدّ تنازلي للصلاة القادمة وإمكانية اختيار طريقة الحساب.</p>
      </section>

      <PrayerTimesIsland lang="ar" client:load />

      <NearbyMosquesIsland lang="ar" client:visible />

      <PrayerDirectory lang="ar" />

      <section class="card section-card" style="order:3">
        <h2 class="section-h2">عن مواقيت الصلاة</h2>
        <p class="section-p">الصلوات الخمس المفروضة هي الفجر والظهر والعصر والمغرب والعشاء، وتتحدّد أوقاتها بحركة الشمس: فالفجر يبدأ بطلوع الفجر الصادق، والظهر بعد زوال الشمس عن وسط السماء، والعصر حين يصير ظل الشيء مثله، والمغرب بغروب الشمس، والعشاء بمغيب الشفق الأحمر. ولأن هذه اللحظات تعتمد على موقع الشمس في السماء فإنها تختلف باختلاف المكان والتاريخ.</p>
        <h2 class="section-h2" style="margin-top:22px">طرق الحساب</h2>
        <p class="section-p">تعتمد المؤسسات الإسلامية زوايا مختلفة للشمس لتحديد الفجر والعشاء، ومن أشهرها تقويم أم القرى في السعودية، ورابطة العالم الإسلامي، والهيئة المصرية، وجامعة كراتشي، وطريقة أمريكا الشمالية (ISNA). اختر الطريقة المعتمدة في بلدك للحصول على أدق النتائج.</p>
      </section>

      <section class="card section-card" style="order:4">
        <h2 class="section-h2">أسئلة شائعة</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="ad-slot"><span class="ad-label">مساحة إعلانية</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">أدوات ذات صلة</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/" style="color:var(--accent);text-decoration:none">التقويم الهجري الكامل وتاريخ اليوم</a>
          <a href="/" style="color:var(--accent);text-decoration:none">محوّل التاريخ الهجري والميلادي</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    المواقيت محسوبة فلكياً · للأغراض التقريبية
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
  </footer>
</Layout>
