---
import Layout from '../../layouts/Layout.astro';
import KhatmaGrid from '../../components/KhatmaGrid';
import { getKhatma, getParts, summarise, validSlug, type KhatmaView } from '../../lib/khatma';

// Live, shared state: a khatma changes whenever anyone claims or finishes a
// part, so this page is rendered per request and never cached at the edge.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const slug = Astro.params.slug;
const db = (Astro.locals as App.Locals)?.runtime?.env?.DB ?? null;

let view: KhatmaView | null = null;
let problem: 'bad-link' | 'not-found' | 'unavailable' | null = null;

if (!validSlug(slug)) {
  problem = 'bad-link';
} else if (!db) {
  problem = 'unavailable';
} else {
  const k = await getKhatma(db, slug);
  if (!k) {
    problem = 'not-found';
  } else {
    // Rendered without a reader token: the browser re-asks with its own token on
    // mount, which is what turns "held by someone" into "held by you".
    view = summarise(k, await getParts(db, slug), null);
  }
}

if (problem === 'bad-link' || problem === 'not-found') Astro.response.status = 404;
if (problem === 'unavailable') Astro.response.status = 503;

const isNew = Astro.url.searchParams.get('new') === '1';
const canonical = `https://islamicdates.org/khatma/${slug}/`;
const title = view ? `ختمة «${view.title}» · اختر جزءاً واقرأه` : 'ختمة غير موجودة';
const description = view
  ? `شارك في ختمة «${view.title}»: اكتمل ${view.done} من ٣٠ جزءاً. اختر جزءاً متاحاً واقرأه، ثم أكّد إتمامه.`
  : 'الختمة المطلوبة غير متاحة.';
---
<Layout title={title} description={description} canonical={canonical} lang="ar" arPath={`/khatma/${slug}/`} altLangs={false} noindex={true}>
  <header class="site-header">
    <div class="header-start">
      <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">التقويم الهجري</div>
          <div class="tagline">ختمة جماعية</div>
        </div>
      </a>
      <a href="/khatma/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>ختمة جديدة</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      {view ? (
        <>
          {isNew && (
            <section class="card section-card kh-new-note" style="order:0">
              <p><strong>أُنشئت الختمة.</strong> انسخ رابط هذه الصفحة وأرسله إلى مجموعتكم؛ كل من يفتحه يستطيع أخذ جزء فوراً. احتفظ بالرابط عندك، فهو طريقك الوحيد للعودة إليها.</p>
            </section>
          )}

          <section class="card section-card" style="order:1">
            <h1 class="section-h2" style="font-size:24px">{view.title}</h1>
            <p class="section-p" style="margin-top:8px">اختر جزءاً متاحاً فيُحجز باسمك، ثم اقرأه بلسانك وأكّد إتمامه. من قرأ جزءاً فله أجر ما قرأ، والعدّاد يُظهر ما اكتمل من الأجزاء الثلاثين.</p>
          </section>

          <section class="card section-card" style="order:2">
            <KhatmaGrid initial={view} client:load />
          </section>

          <section class="card section-card" style="order:3">
            <h2 class="section-h2">تذكير</h2>
            <p class="section-p">القراءة تكون باللسان لا بمجرّد النظر. وليست العبرة بسرعة الإنهاء بل بالإتقان والتدبّر، فإن ضاق وقتك عن جزئك فأرجعه بزرّ «إرجاع» ليأخذه غيرك. وهذه ختمة قراءة جماعية عامة ليس فيها إهداء ثواب لأحد؛ من أراد الدعاء لميت فليدعُ له بنفسه.</p>
          </section>
        </>
      ) : (
        <section class="card section-card" style="order:1">
          <h1 class="section-h2" style="font-size:24px">
            {problem === 'unavailable' ? 'الخدمة غير متاحة حالياً' : 'لم نجد هذه الختمة'}
          </h1>
          <p class="section-p" style="margin-top:8px">
            {problem === 'unavailable'
              ? 'تعذّر الوصول إلى بيانات الختمات في هذه اللحظة. أعد المحاولة بعد قليل.'
              : 'الرابط غير صحيح أو أن الختمة لم تعد موجودة. تأكّد من نسخ الرابط كاملاً، أو ابدأ ختمة جديدة.'}
          </p>
          <p class="section-p" style="margin-top:12px"><a href="/khatma/" style="color:var(--accent)">إنشاء ختمة جديدة</a></p>
        </section>
      )}
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">أدوات ذات صلة</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/khatma/" style="color:var(--accent);text-decoration:none">ابدأ ختمة جماعية جديدة</a>
          <a href="/imsakiyah/" style="color:var(--accent);text-decoration:none">إمساكية رمضان حسب مدينتك</a>
          <a href="/dua/" style="color:var(--accent);text-decoration:none">أدعية وأذكار</a>
          <a href="/prayer-times/" style="color:var(--accent);text-decoration:none">مواقيت الصلاة حسب المدينة</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    ختمة جماعية بلا تسجيل · الاسم اختياري ولا نحفظ بيانات شخصية
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
  </footer>

  <style is:global>
    .kh-new-note p { margin:0; font-size:14.5px; line-height:1.85; color:var(--muted); }
    .kh-new-note strong { color:var(--text); }

    .kh-progress { margin-bottom:14px; }
    .kh-bar { height:10px; border-radius:99px; background:var(--accent-soft); overflow:hidden; }
    .kh-bar span { display:block; height:100%; background:var(--accent); border-radius:99px; transition:width .35s ease; }
    .kh-count { margin:8px 0 0; font-size:15px; }
    .kh-count strong { font-size:17px; color:var(--accent-strong); }
    .kh-sub { color:var(--muted); font-size:14px; }
    .kh-complete { margin:0 0 14px; padding:12px 14px; border-radius:12px; background:var(--accent-soft); font-size:14.5px; line-height:1.8; }
    .kh-complete a { color:var(--accent-strong); font-weight:700; }
    .kh-mine-note { margin:0 0 12px; padding:11px 13px; border-radius:12px; background:var(--gold-soft); color:var(--gold-deep); font-size:14px; line-height:1.8; }
    .kh-err { margin:0 0 12px; padding:11px 13px; border-radius:12px; background:#fdecea; color:#b42318; font-size:14px; }

    .kh-grid { list-style:none; margin:0; padding:0; display:grid; gap:10px; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); }
    .kh-cell { display:flex; flex-direction:column; }
    .kh-face {
      font:inherit; text-align:start; width:100%; cursor:pointer;
      display:flex; flex-direction:column; gap:3px;
      padding:11px 12px; border-radius:14px; border:1px solid var(--border);
      background:var(--surface); color:var(--text); transition:border-color .15s, background .15s, transform .12s;
    }
    .kh-face:hover:not([disabled]) { border-color:var(--accent); transform:translateY(-1px); }
    .kh-face[disabled] { cursor:default; }
    .kh-face:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
    .kh-n { font-size:19px; font-weight:800; line-height:1.1; color:var(--accent-strong); }
    .kh-name { font-size:14px; font-weight:600; }
    .kh-range { font-size:12px; color:var(--muted); }
    .kh-tag { margin-top:5px; font-size:12px; font-weight:700; }
    .kh-take { color:var(--accent-strong); }

    .kh-done .kh-face { background:var(--accent-soft); border-color:transparent; }
    .kh-done .kh-n, .kh-done .kh-tag { color:var(--accent-strong); }
    .kh-held .kh-face { opacity:.62; }
    .kh-held .kh-n { color:var(--muted); }
    .kh-mine .kh-face { border-color:var(--gold); background:var(--gold-soft); }
    .kh-mine .kh-n, .kh-mine .kh-tag { color:var(--gold-deep); }

    .kh-actions { display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }
    .kh-actions button, .kh-read {
      font:inherit; font-size:13px; font-weight:700; padding:7px 11px; border-radius:10px; border:0;
      background:var(--accent); color:var(--accent-contrast); cursor:pointer; text-decoration:none;
    }
    .kh-actions button:hover, .kh-read:hover { background:var(--accent-strong); }
    .kh-ghost { background:transparent !important; color:var(--muted) !important; border:1px solid var(--border) !important; }
    .kh-ghost:hover { color:var(--text) !important; }

    .kh-modal { position:fixed; inset:0; z-index:60; background:rgba(9,25,31,.5); display:grid; place-items:center; padding:18px; }
    .kh-sheet { width:min(420px, 100%); background:var(--surface); border-radius:18px; padding:20px; box-shadow:var(--shadow-lift); }
    .kh-sheet h3 { margin:0 0 4px; font-size:17px; }
    .kh-hint { margin:0 0 14px; font-size:13px; color:var(--muted); }
    .kh-sheet label { display:block; font-size:14px; font-weight:600; margin-bottom:6px; }
    .kh-sheet input { font:inherit; width:100%; padding:11px 13px; border:1px solid var(--border); border-radius:12px; background:var(--bg); color:var(--text); }
    .kh-note { margin:12px 0 0; font-size:13px; color:var(--muted); line-height:1.8; }
    .kh-sheet-actions { display:flex; gap:8px; margin-top:16px; }
    .kh-sheet-actions button { font:inherit; font-weight:700; padding:11px 16px; border-radius:12px; border:0; background:var(--accent); color:var(--accent-contrast); cursor:pointer; }

    .kh-share { margin-top:18px; padding-top:16px; border-top:1px solid var(--border); }
    .kh-share p { margin:0 0 9px; font-size:14px; color:var(--muted); }
    .kh-share-row { display:flex; gap:8px; flex-wrap:wrap; }
    .kh-wa, .kh-share-row button {
      font:inherit; font-size:14px; font-weight:700; padding:10px 15px; border-radius:12px; border:0;
      background:var(--accent); color:var(--accent-contrast); text-decoration:none; cursor:pointer;
    }
    @media (max-width:480px) {
      .kh-grid { grid-template-columns:repeat(auto-fill, minmax(135px, 1fr)); }
    }
  </style>
</Layout>
