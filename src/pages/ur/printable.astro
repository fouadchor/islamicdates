---
import Layout from '../../layouts/Layout.astro';
import PrintCalendarIsland from '../../components/PrintCalendarIsland';

const canonical = 'https://islamicdates.org/ur/printable/';
const title = 'پرنٹ کے قابل ہجری کیلنڈر · PDF اور PNG ڈاؤن لوڈ کریں (مہینہ و پورا سال)';
const description = 'مفت پرنٹ کے قابل ہجری کیلنڈر — PDF یا PNG میں ڈاؤن لوڈ کریں، ایک مہینہ یا پورا سال، ہجری و عیسوی تاریخوں اور اسلامی مناسبتوں کے ساتھ، اُمّ القریٰ تقویم کے مطابق۔ سال منتخب کریں اور ایک کلک میں پرنٹ یا ڈاؤن لوڈ کریں۔';

const faq = [
  { q: 'کیا کیلنڈر پرنٹ اور شیئر کرنے کے لیے مفت ہے؟', a: 'جی ہاں۔ آپ ہجری کیلنڈر — ایک مہینہ یا پورا سال — مفت ڈاؤن لوڈ، پرنٹ اور شیئر کر سکتے ہیں، بغیر کسی پابندی کے۔' },
  { q: 'کون سے ڈاؤن لوڈ فارمیٹ دستیاب ہیں؟', a: 'آپ A4 پرنٹنگ کے لیے موزوں PDF، یا سوشل میڈیا اور ویب سائٹس پر شیئر کرنے کے لیے اعلیٰ ریزولوشن PNG تصویر ڈاؤن لوڈ کر سکتے ہیں۔' },
  { q: 'کیا اس میں ہجری اور عیسوی دونوں تاریخیں ہیں؟', a: 'جی ہاں۔ ہر دن اپنے ہجری نمبر کے ساتھ متعلقہ عیسوی تاریخ دکھاتا ہے، اور اسلامی مناسبتیں اور آج کا دن نمایاں ہوتے ہیں۔' },
  { q: 'یہ کس تقویم پر مبنی ہے؟', a: 'یہ فلکی طور پر شمار کردہ اُمّ القریٰ تقویم پر مبنی ہے۔ بعض ممالک میں مقامی رؤیتِ ہلال کے مطابق بعض مہینوں کا آغاز ایک دن مختلف ہو سکتا ہے۔' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ہوم', 'item': 'https://islamicdates.org/ur/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'پرنٹ کے قابل ہجری کیلنڈر', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'پرنٹ کے قابل ہجری کیلنڈر', 'url': canonical,
    'applicationCategory': 'UtilitiesApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en', 'ur'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ur" jsonLd={jsonLd} arPath="/printable/" enPath="/en/printable/" urPath="/ur/printable/">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <header class="site-header no-print">
    <div class="header-start">
      <a href="/ur/" class="logo" aria-label="ہوم پیج پر جائیں">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">ہجری کیلنڈر</div>
          <div class="tagline">پرنٹ کیلنڈر</div>
        </div>
      </a>
      <a href="/ur/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>ہوم</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card no-print" style="order:1">
        <h1 class="section-h2" style="font-size:25px">پرنٹ کے قابل ہجری کیلنڈر</h1>
        <p class="section-p" style="margin-top:8px">پرنٹ کے لیے تیار ہجری کیلنڈر PDF یا PNG تصویر کے طور پر ڈاؤن لوڈ کریں — ایک مہینہ یا پورا سال۔ ہجری سال منتخب کریں، پھر فائل ڈاؤن لوڈ کریں یا براہِ راست پرنٹ کریں۔ ہر دن ہجری اور عیسوی تاریخ کے ساتھ دکھایا جاتا ہے، اسلامی مناسبتیں اور آج کا دن نمایاں ہوتا ہے۔</p>
      </section>

      <PrintCalendarIsland lang="ur" client:load />

      <section class="card section-card no-print">
        <h2 class="section-h2">کیلنڈر کیسے پرنٹ یا ڈاؤن لوڈ کریں؟</h2>
        <p class="section-p">«پورا سال» یا «ایک مہینہ» منتخب کریں اور + اور − بٹن سے ہجری سال مقرر کریں۔ پھر A4 کے لیے تیار فائل کے لیے «PDF ڈاؤن لوڈ»، شیئر کرنے کے لیے اعلیٰ ریزولوشن تصویر کے لیے «PNG ڈاؤن لوڈ»، یا فوراً پرنٹ کرنے یا پرنٹ ونڈو سے PDF محفوظ کرنے کے لیے «پرنٹ» دبائیں۔</p>
      </section>

      <section class="card section-card no-print">
        <h2 class="section-h2">اکثر پوچھے جانے والے سوالات</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside class="no-print">
      <div class="ad-slot"><span class="ad-label">اشتہار</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">متعلقہ اوزار</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/ur/" style="color:var(--accent);text-decoration:none">ہجری کیلنڈر اور آج کی تاریخ</a>
          <a href="/ur/#converter" style="color:var(--accent);text-decoration:none">ہجری ⇄ عیسوی کنورٹر</a>
          <a href="/ur/age/" style="color:var(--accent);text-decoration:none">ہجری عمر کیلکولیٹر</a>
          <a href="/ur/zakat/" style="color:var(--accent);text-decoration:none">زکوٰۃ کیلکولیٹر</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer no-print">
    حساب اُمّ القریٰ تقویم کے مطابق
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/ur/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">رازداری پالیسی</a>
  </footer>

  <style is:global>
    @media print {
      .site-nav, .no-print { display: none !important; }
      .layout { display: block !important; padding: 0 !important; max-width: 100% !important; }
      main { gap: 0 !important; }
      #print-sheet { border: none !important; box-shadow: none !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      @page { margin: 10mm; }
    }
  </style>
</Layout>
