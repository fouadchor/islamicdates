---
import KhatmaPage from '../../../components/KhatmaPage.astro';
import { loadKhatma, statusFor } from '../../../lib/khatma-load';

// حالة مشتركة حيّة: تتغيّر الختمة كلما حجز أحدهم جزءاً أو أتمّه،
// فتُبنى الصفحة عند كل طلب ولا تُخزَّن على الحافة.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

// التحميل هنا لا داخل المكوّن: Astro يبثّ الاستجابة، فرمزُ حالةٍ يُضبط بعد
// أول await داخل مكوّن ابن يصل متأخراً وتخرج الصفحة بـ 200.
const loaded = await loadKhatma(Astro.params.slug, (Astro.locals as App.Locals)?.runtime?.env?.DB ?? null);
Astro.response.status = statusFor(loaded.problem);
---
<KhatmaPage lang="ur" loaded={loaded} />
