---
import Layout from '../../layouts/Layout.astro';
import { getL } from '../../lib/data';

const L = getL('ur');
const canonical = 'https://islamicdates.org/ur/about/';
const title = 'ہجری تقویم کیا ہے؟ اُمّ القریٰ اور تاریخ کے حساب کی مکمل گائیڈ';
const description = 'ہجری تقویم کی گائیڈ: یہ کیا ہے، فلکی طور پر اس کا حساب کیسے ہوتا ہے، اُمّ القریٰ تقویم اور رؤیتِ ہلال میں فرق، اور اکثر پوچھے جانے والے سوالات۔';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ہوم', 'item': 'https://islamicdates.org/ur/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'ہجری تقویم گائیڈ', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': L.faqItems.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ur" jsonLd={jsonLd} arPath="/about/" enPath="/en/about/" urPath="/ur/about/">
  <header class="site-header">
    <div class="header-start">
      <a href="/ur/" class="logo" aria-label="ہوم پیج پر جائیں">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">ہجری کیلنڈر</div>
          <div class="tagline">ہجری تقویم گائیڈ</div>
        </div>
      </a>
      <a href="/ur/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>ہوم</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <img src="/images/hero-calendar.svg"
        alt="نمایاں دن والا ماہانہ کیلنڈر کارڈ اور سنہرا ہلال — ہجری کیلنڈر کی تصویری علامت"
        width="1200" height="420" fetchpriority="high" decoding="async"
        style="width:100%;height:auto;border-radius:16px;display:block" />
      <section class="card section-card">
        <h1 class="section-h2" style="font-size:25px">{L.whatIsTitle}</h1>
        <p class="section-p" style="margin-top:8px">{L.whatIsBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.diffTitle}</h2>
        <p class="section-p">{L.diffBody}</p>
        <h2 class="section-h2" style="margin-top:22px">{L.howTitle}</h2>
        <p class="section-p">{L.howBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.aboutTitle}</h2>
        <p class="section-p">{L.aboutBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.faqTitle}</h2>
        {L.faqItems.map((f, i) => (
          <div class="faq-item" style={i === L.faqItems.length - 1 ? 'border-bottom:none' : ''}>
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="ad-slot"><span class="ad-label">اشتہار</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">متعلقہ اوزار</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/ur/" style="color:var(--accent);text-decoration:none">ہجری کیلنڈر اور آج کی تاریخ</a>
          <a href="/ur/#converter" style="color:var(--accent);text-decoration:none">ہجری ⇄ عیسوی کنورٹر</a>
          <a href="/ur/prayer-times/" style="color:var(--accent);text-decoration:none">مقام کے مطابق مواقیتِ نماز</a>
          <a href="/ur/zakat/" style="color:var(--accent);text-decoration:none">زکوٰۃ کیلکولیٹر</a>
          <a href="/ur/widget/" style="color:var(--accent);text-decoration:none">آپ کی سائٹ کے لیے ہجری تاریخ ویجٹ</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    حساب اُمّ القریٰ تقویم کے مطابق
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/ur/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">رازداری پالیسی</a>
  </footer>
</Layout>
