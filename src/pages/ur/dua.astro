---
import Layout from '../../layouts/Layout.astro';
import DuaPage from '../../components/DuaPage.astro';
import { DUA_PAGE, DUA_SECTIONS, DUA_HUB_FAQ } from '../../lib/duas';

const canonical = 'https://islamicdates.org/ur/dua/';
const P = DUA_PAGE.ur;
const description = 'قرآن و سنت سے مستند دعائیں اور اذکار: صبح و شام کے اذکار، قرآنی دعائیں، پریشانی اور تنگی کی دعائیں اور روزمرہ کی دعائیں — ہر ایک اپنے حوالے کے ساتھ۔';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ہوم', 'item': 'https://islamicdates.org/ur/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'دعا', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', 'name': 'دعا و اذکار کے حصے', 'itemListElement': DUA_SECTIONS.map((s, i) => ({ '@type': 'ListItem', 'position': i + 1, 'name': s.title.ur, 'url': `https://islamicdates.org/ur/dua/${s.id}/` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': DUA_HUB_FAQ.map(f => ({ '@type': 'Question', 'name': f.q.ur, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a.ur } })) },
]);
---
<Layout title={P.title} description={description} canonical={canonical} lang="ur" jsonLd={jsonLd} arPath="/dua/" enPath="/en/dua/" urPath="/ur/dua/">
  <DuaPage lang="ur" />
</Layout>
