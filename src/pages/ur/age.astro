---
import Layout from '../../layouts/Layout.astro';
import AgeIsland from '../../components/AgeIsland';

const canonical = 'https://islamicdates.org/ur/age/';
const title = 'ہجری عمر کیلکولیٹر · اپنی عمر ہجری اور عیسوی تقویم میں معلوم کریں';
const description = 'مفت ہجری عمر کیلکولیٹر: اپنی عمر سال، ماہ اور دن میں ہجری اور عیسوی دونوں تقویموں کے مطابق معلوم کریں، اپنی ہجری تاریخِ پیدائش، پیدائش کا دن، اور اگلی سالگرہ کا عددِ معکوس دیکھیں۔';

const faq = [
  { q: 'میں اپنی عمر ہجری تقویم میں کیسے معلوم کروں؟', a: 'اوپر دیا گیا کیلکولیٹر استعمال کریں: اپنی تاریخِ پیدائش (ہجری یا عیسوی) درج کریں اور یہ فوراً آپ کی عمر سال، ماہ اور دن میں دونوں تقویموں کے مطابق دکھا دے گا، ساتھ ہی ہر تقویم میں آپ کی تاریخِ پیدائش بھی۔' },
  { q: 'میری ہجری عمر عیسوی عمر سے مختلف کیوں ہے؟', a: 'قمری ہجری سال عیسوی سال سے تقریباً 11 دن چھوٹا ہوتا ہے، اس لیے آپ کی ہجری عمر عیسوی عمر سے قدرے زیادہ ہوتی ہے، اور یہ فرق ہر تقریباً 33 سال میں ایک پورے سال کے برابر بڑھ جاتا ہے۔' },
  { q: 'میں اپنی ہجری تاریخِ پیدائش اور پیدائش کا دن کیسے معلوم کروں؟', a: 'اپنی عیسوی تاریخِ پیدائش درج کریں، کیلکولیٹر اس کے مطابق ہجری تاریخِ پیدائش، وہ دن جس میں آپ پیدا ہوئے، اور آپ نے کل کتنے دن گزارے، سب دکھا دے گا۔' },
  { q: 'کیا عمر کا حساب درست ہے؟', a: 'عمر کا حساب سعودی عرب میں رائج اُمّ القریٰ تقویم کے مطابق فلکی طور پر کیا جاتا ہے۔ براہِ راست رؤیتِ ہلال پر انحصار کرنے والے بعض ممالک میں تاریخ تقریباً ایک دن مختلف ہو سکتی ہے۔' },
];

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ہوم', 'item': 'https://islamicdates.org/ur/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'ہجری عمر کیلکولیٹر', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'ہجری عمر کیلکولیٹر', 'url': canonical,
    'applicationCategory': 'UtilitiesApplication', 'operatingSystem': 'Web', 'inLanguage': ['ar', 'en', 'ur'],
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ur" jsonLd={jsonLd} arPath="/age/" enPath="/en/age/" urPath="/ur/age/">
  <header class="site-header">
    <div class="header-start">
      <a href="/ur/" class="logo" aria-label="ہوم پیج پر جائیں">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">ہجری کیلنڈر</div>
          <div class="tagline">عمر کیلکولیٹر</div>
        </div>
      </a>
      <a href="/ur/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>ہوم</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">ہجری عمر کیلکولیٹر</h1>
        <p class="section-p" style="margin-top:8px">ہجری اور عیسوی دونوں تقویموں کے مطابق اپنی درست عمر معلوم کریں۔ اپنی تاریخِ پیدائش — ہجری یا عیسوی — درج کریں تاکہ آپ کو سال، ماہ اور دن میں عمر، ہر تقویم میں تاریخِ پیدائش، وہ دن جس میں آپ پیدا ہوئے، اور اگلی سالگرہ کا عددِ معکوس معلوم ہو سکے۔</p>
      </section>

      <AgeIsland lang="ur" client:load />

      <section class="card section-card">
        <h2 class="section-h2">ہجری عمر کیسے نکالی جاتی ہے؟</h2>
        <p class="section-p">آپ کی تاریخِ پیدائش کو ہجری تقویم میں تبدیل کر کے آج سے موازنہ کیا جاتا ہے تاکہ سال، ماہ اور دن کا فرق نکالا جا سکے۔ چونکہ قمری ہجری سال عیسوی سال سے تقریباً 11 دن چھوٹا ہے، اس لیے آپ کی ہجری عمر عیسوی عمر سے قدرے زیادہ نکلتی ہے۔</p>
        <h2 class="section-h2" style="margin-top:22px">ہجری اور عیسوی عمر میں فرق</h2>
        <p class="section-p">ہر سال کے 11 دن جمع ہو کر تقریباً ہر 33 عیسوی سال میں ایک پورا سال بن جاتے ہیں۔ یعنی جو شخص 33 عیسوی سال پہلے پیدا ہوا وہ تقریباً 34 ہجری سال کا ہوتا ہے۔ کیلکولیٹر دونوں اعداد ساتھ ساتھ دکھاتا ہے تاکہ فرق واضح ہو۔</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">اکثر پوچھے جانے والے سوالات</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="ad-slot"><span class="ad-label">اشتہار</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">متعلقہ اوزار</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/ur/" style="color:var(--accent);text-decoration:none">ہجری کیلنڈر اور آج کی تاریخ</a>
          <a href="/ur/#converter" style="color:var(--accent);text-decoration:none">ہجری ⇄ عیسوی کنورٹر</a>
          <a href="/ur/zakat/" style="color:var(--accent);text-decoration:none">زکوٰۃ کیلکولیٹر</a>
          <a href="/ur/prayer-times/" style="color:var(--accent);text-decoration:none">مواقیتِ نماز</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    حساب اُمّ القریٰ تقویم کے مطابق
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/ur/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">رازداری پالیسی</a>
  </footer>
</Layout>
