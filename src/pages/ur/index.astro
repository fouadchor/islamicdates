---
import Layout from '../../layouts/Layout.astro';
import TodayIsland from '../../components/TodayIsland';
import CalendarIsland from '../../components/CalendarIsland';
import ConverterIsland from '../../components/ConverterIsland';
import UpcomingIsland from '../../components/UpcomingIsland';
import SidebarExtras from '../../components/SidebarExtras.astro';
import { getL } from '../../lib/data';
import { HADITHS, hadithOfDay } from '../../lib/hadiths';
import { OCCASIONS, occLoc, occurrencesInGYear, occBasePath, fmtGShort } from '../../lib/occasions';
import { g2h, todayUTC } from '../../lib/hijri';
import { monthBasePath, monthName, H_YEAR_START, H_YEAR_END } from '../../lib/months';
import { H_MON_UR } from '../../lib/data';
import { eventForDay, otdContent, otdIcon, otdAgo, fmtHDayL, otdPathL, whatsappHrefL } from '../../lib/onthisday.i18n';

// --- Request-time SSR + fresh CDN cache (fixes stale build-time date) ---
export const prerender = false;
// Keep the edge copy fresh: expires at the next Riyadh midnight, capped to 1h,
// so the server-rendered date can never sit a day behind.
const _tParts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Riyadh', hourCycle: 'h23', hour: '2-digit', minute: '2-digit', second: '2-digit' }).formatToParts(new Date());
const _tp = (t: string) => Number(_tParts.find(p => p.type === t)?.value ?? 0);
const _secsToMidnight = 86400 - (_tp('hour') * 3600 + _tp('minute') * 60 + _tp('second'));
const _ttl = Math.max(60, Math.min(_secsToMidnight, 3600));
Astro.response.headers.set('Cache-Control', `public, max-age=0, s-maxage=${_ttl}, stale-while-revalidate=86400`);
// ------------------------------------------------------------------------

const _curHy = Math.min(Math.max(g2h(todayUTC()).y, H_YEAR_START), H_YEAR_END);
const _monthLinks = Array.from({ length: 12 }, (_, i) => ({ name: monthName(i + 1, 'ur'), href: monthBasePath(_curHy, i + 1, 'ur') }));
const _monthNotesShort = ['ہجری سال کا آغاز اور ایک حرمت والا مہینہ، جسے عاشورہ کا روزہ زینت بخشتا ہے','عربوں کے سفر کے موسم میں خالی گھروں کی نسبت سے موسوم','نبی کریم ﷺ کی ولادت کا مہینہ — دل سیرت کو یاد کرتے ہیں','چوتھا مہینہ، عربوں کے ہاں موسمِ بہار کی تکمیل','جمادی — سخت سردی میں پانی جم جانے کی نسبت سے','دونوں جمادیوں کا آخری، حرمت والے مہینوں کی طرف لے جاتا ہے','حرمت والا مہینہ، اسی میں شبِ معراج (اسراء و معراج) ہے','اعمال اٹھائے جاتے ہیں؛ رمضان کی تیاری میں کثرتِ صیام','روزوں اور قرآن کا مہینہ، اسی میں شبِ قدر ہے','عید الفطر سے آغاز؛ چھ مستحب روزے اس کے بعد','حرمت والا مہینہ، حجاج حج کی تیاری کرتے ہیں','حج اور عید الاضحیٰ — اس کے پہلے دس دن سال کے بہترین دن'];

const lang = 'ur';
const L = getL('ur');
const _h = hadithOfDay(new Date());

// «اِسی ہجری دن» — آج کا واقعہ (ہر درخواست پر SSR)
const _otdH = g2h(todayUTC());
const _otd = eventForDay(_otdH.m, _otdH.d, new Date().getUTCFullYear());
const _ev = _otd.ev;
const _c = otdContent(_ev, 'ur');
const _otdAgoN = otdAgo(_ev, _otdH.y);
const _otdIcon = otdIcon(_ev);
const _otdPath = otdPathL(_ev.slug, 'ur');
const _otdWa = whatsappHrefL(_ev, 'ur');
const _otdHDate = fmtHDayL(_ev.hm, _ev.hd, 'ur');
const _otdMonthName = H_MON_UR[_otdH.m - 1];

const _featured = OCCASIONS.map(o => o.slug); // all occasions, ordered by date below
const _homeYears = (() => { const y = new Date().getUTCFullYear(); return [y, y+1]; })();
const occLinks = [];
for (const _y of _homeYears) {
  for (const _slug of _featured) {
    const _o = OCCASIONS.find(x => x.slug === _slug);
    if (!_o) continue;
    const _occ = occurrencesInGYear(_o.hm, _o.hd, _y)[0];
    if (_occ) occLinks.push({ name: occLoc(_o, 'ur').name, year: _y, href: occBasePath(_slug, _y, 'ur'), date: _occ.date });
  }
}
occLinks.sort((a, b) => a.year - b.year || a.date.getTime() - b.date.getTime());

const jsonLd = JSON.stringify([
  {
    "@context":"https://schema.org","@type":"WebApplication",
    "name":"ہجری کیلنڈر","alternateName":"Hijri Calendar",
    "url":"https://islamicdates.org/ur/",
    "description":"اُمّ القریٰ تقویم کے مطابق آج کی ہجری تاریخ عیسوی کے ساتھ، ہجری مہینوں کی فہرست، ہجری ⇄ عیسوی فوری کنورٹر اور آنے والی اسلامی مناسبتیں۔",
    "applicationCategory":"UtilitiesApplication","operatingSystem":"Web",
    "inLanguage":["ar","en","ur"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}
  }
]);
---

<Layout
  title="آج کی ہجری تاریخ · ہجری اور عیسوی تاریخ کنورٹر | اُمّ القریٰ تقویم"
  description="اُمّ القریٰ تقویم کے مطابق آج کی ہجری (اسلامی) تاریخ عیسوی تاریخ کے ساتھ، ہجری مہینوں کی فہرست، ہجری ⇄ عیسوی فوری کنورٹر اور آنے والی اسلامی مناسبتیں۔"
  canonical="https://islamicdates.org/ur/"
  lang="ur"
  jsonLd={jsonLd}
>
  <header class="site-header">
    <a href="/ur/" class="logo" style="text-decoration:none;color:inherit" aria-label="ہوم">
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L.brand}</div>
        <div class="tagline">{L.tagline}</div>
      </div>
    </a>
  </header>

  <div class="layout">
    <main>
      <TodayIsland lang="ur" client:load />

      <CalendarIsland lang="ur" client:load />

      <div id="converter" style="scroll-margin-top:64px"><ConverterIsland lang="ur" client:visible /></div>

      <!-- اِسی ہجری دن (order:2 → کنورٹر کے فوراً بعد، آنے والی مناسبتوں سے پہلے) -->
      <section class="card section-card" style="order:2;position:relative;overflow:hidden;background:linear-gradient(140deg,#10312f 0%,#0c4a44 55%,#0a5a54 100%);border-color:transparent;color:#eafaf6">
        <span aria-hidden="true" style="position:absolute;top:-24px;inset-inline-end:-10px;font-size:110px;opacity:.09;transform:rotate(12deg);color:#fbbf24">✦</span>
        <span aria-hidden="true" style="position:absolute;bottom:-34px;inset-inline-start:-12px;font-size:120px;opacity:.09;color:#fbbf24">☾</span>
        <span aria-hidden="true" style="position:absolute;bottom:-38px;inset-inline-end:6px;font-size:clamp(80px,14vw,150px);font-weight:800;line-height:1;color:rgba(251,191,36,.10);pointer-events:none;font-variant-numeric:tabular-nums">{_c.year.replace(/[^0-9]/g,'')}</span>

        <div style="position:relative">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:4px">
            <h2 class="section-h2" style="margin:0;color:#fff">📜 اِسی ہجری دن</h2>
            <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);font-weight:700;font-size:12.5px;color:#d5efe9">☾ آج {_otdH.d} {_otdMonthName} {_otdH.y}ھ</span>
          </div>
          <p style="margin:0 0 16px;font-size:13px;color:#9fd4c9">امت کی یادداشت کا ایک ورق جو ہر دن پلٹتا ہے — اِسی ہجری دن کا ایک تاریخی واقعہ</p>

          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
            {_otdAgoN !== null && <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 15px;border-radius:999px;background:#fbbf24;color:#4a2b00;font-weight:800;font-size:13.5px;box-shadow:0 3px 10px rgba(0,0,0,.25)">⏳ {_otdAgoN} سال پہلے</span>}
            <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(251,191,36,.5);color:#ffd97a;font-weight:700;font-size:13px">{_c.year}</span>
            <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.12);color:#d5efe9;font-weight:700;font-size:13px">{_otdHDate}</span>
            <span style="display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;background:rgba(94,234,212,.16);color:#8ff5e2;font-weight:700;font-size:12.5px">{_ev.hd === _otdH.d ? '✨ اِسی دن کا واقعہ' : `${_otdMonthName} کے نمایاں واقعات میں سے`}</span>
          </div>

          <div style="display:flex;gap:14px;align-items:flex-start">
            <span aria-hidden="true" style="font-size:44px;line-height:1.2;flex:0 0 auto;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35))">{_otdIcon}</span>
            <div style="flex:1 1 auto;min-width:0">
              <h3 style="margin:0 0 8px;font-size:clamp(18px,2.8vw,23px);font-weight:800;line-height:1.7">
                <a href={_otdPath} style="color:#fff;text-decoration:none">{_c.title}</a>
              </h3>
              <p class="section-p" style="color:#d9efe9;margin:0">{_c.summary}</p>
            </div>
          </div>

          {_c.disputed && (
            <div style="margin-top:14px;display:flex;gap:9px;align-items:flex-start;padding:11px 14px;border-radius:12px;background:rgba(251,191,36,.13);border:1px solid rgba(251,191,36,.4)">
              <span aria-hidden="true" style="font-size:16px;line-height:1.5">⚠️</span>
              <p style="margin:0;font-size:12.5px;line-height:1.9;color:#ffe9b3"><strong>روایات کا اختلاف:</strong> {_c.disputed}</p>
            </div>
          )}
          <p style="margin:12px 0 0;font-size:12.5px;color:#9fd4c9">📚 مأخذ: {_c.source}</p>

          <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <a href={_otdPath} style="display:inline-flex;align-items:center;gap:7px;padding:11px 22px;border-radius:999px;background:#fbbf24;color:#4a2b00;font-weight:800;font-size:14px;text-decoration:none;box-shadow:0 4px 14px rgba(0,0,0,.25)">مکمل کہانی پڑھیں ›</a>
            <a href={_otdWa} target="_blank" rel="noopener" aria-label="واٹس ایپ پر شیئر کریں" style="display:inline-flex;align-items:center;gap:7px;padding:11px 20px;border-radius:999px;background:#25D366;color:#fff;font-weight:700;font-size:14px;text-decoration:none">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              واٹس ایپ پر شیئر کریں
            </a>
            <a href="/ur/on-this-day/" style="font-size:13.5px;font-weight:700;color:#8ff5e2;text-decoration:none">مکمل آرکائیو ›</a>
          </div>
        </div>
      </section>

      <div style="order:3"><UpcomingIsland lang="ur" client:visible /></div>

      <!-- Decorative section divider -->
      <img src="/images/divider-ornament.svg" alt="" role="presentation" width="1200" height="70"
        loading="lazy" decoding="async" style="order:5;width:100%;height:auto;display:block;margin:-2px 0" />

      <section id="occasions" class="card section-card" style="order:5;scroll-margin-top:64px">
        <h2 class="section-h2">اسلامی مناسبتوں کی تاریخیں</h2>
        <p class="section-p" style="margin-bottom:14px">ہر مناسبت کی ہجری اور عیسوی تاریخ عددِ معکوس کے ساتھ جانیں</p>
        {_homeYears.map((_yr, _i) => (
          <div style={`margin-top:${_i === 0 ? 4 : 26}px`}>
            <h3 style="margin:0 0 12px;font-size:16px;font-weight:700;color:var(--accent)">{_yr} کی مناسبتیں</h3>
            <div class="months-grid">
              {occLinks.filter(o => o.year === _yr).map(o => (
                <a href={o.href} class="month-item" style="text-decoration:none;color:inherit">
                  <div>
                    <div class="month-name">{o.name} {o.year}</div>
                    <div class="month-note">{fmtGShort(o.date, 'ur')}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="card section-card" style="order:5">
        <h2 class="section-h2">{_curHy} ھ کے ہجری مہینے دیکھیں</h2>
        <p class="section-p" style="margin-bottom:14px">ہجری سال کو مہینہ بہ مہینہ دیکھیں — معانی، مناسبتیں اور عیسوی تاریخیں</p>
        <div class="months-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
          {_monthLinks.map((m, i) => (
            <a href={m.href} class="month-item" style="text-decoration:none;color:inherit">
              <span class="month-num">{i + 1}</span>
              <div><div class="month-name">{m.name}</div><div class="month-note">{_monthNotesShort[i]}</div></div>
            </a>
          ))}
        </div>
      </section>

      <section class="card section-card" style="order:7;background:var(--gold-soft);border-color:var(--gold-soft)">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:10px">
          <span aria-hidden="true" style="font-size:22px;line-height:1;color:var(--gold-deep)">☾</span>
          <h2 class="section-h2" style="margin:0;color:var(--gold-deep)">آج کی حدیث</h2>
        </div>
        <img src="/images/hadith-ornament.svg" alt="" role="presentation" width="900" height="130"
          loading="lazy" decoding="async" style="display:block;margin:2px auto 8px;width:100%;max-width:440px;height:auto" />
        <div style="position:relative;padding:4px 2px 0">
          <span aria-hidden="true" style="position:absolute;top:-22px;inset-inline-start:-2px;font-size:60px;line-height:1;color:var(--gold);opacity:.22;font-family:Georgia,serif">”</span>
          <blockquote id="hadith-text" style="margin:0;border:0;padding:0;font-size:clamp(18px,2.7vw,24px);line-height:2.05;font-weight:700;color:var(--text);text-wrap:pretty">«{_h.ur}»</blockquote>
        </div>
        <div style="margin-top:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span id="hadith-src" style="display:inline-block;padding:5px 14px;border-radius:999px;background:var(--gold-deep);color:#fff;font-weight:700;font-size:13px">{_h.urSrc}</span>
          <span style="color:var(--muted);font-size:12.5px">صحیح بخاری و مسلم سے</span>
        </div>
      </section>
      <script define:vars={{ hList: HADITHS.map(h => ({ t: h.ur, s: h.urSrc })) }}>
        (function () {
          var d = new Date();
          var start = Date.UTC(d.getFullYear(), 0, 0);
          var day = Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - start) / 86400000);
          var h = hList[((day % hList.length) + hList.length) % hList.length];
          var t = document.getElementById('hadith-text');
          var s = document.getElementById('hadith-src');
          if (t) t.textContent = '«' + h.t + '»';
          if (s) s.textContent = h.s;
        })();
      </script>

      <section class="card section-card" style="order:8">
        <h2 class="section-h2">ہجری تقویم کیا ہے؟</h2>
        <p class="section-p">ہجری تقویم ایک قمری تقویم ہے جس کا سال بارہ قمری مہینوں (تقریباً 354 دن) پر مشتمل ہے، اور اس کا آغاز نبی کریم ﷺ کی ہجرت (622 عیسوی) سے ہوتا ہے۔ یہ سائٹ اُمّ القریٰ تقویم کے مطابق آج کی ہجری تاریخ عیسوی کے ساتھ دکھاتی ہے، نیز ہجری ⇄ عیسوی کا فوری کنورٹر، اہم اسلامی مناسبتیں اور مواقیتِ نماز فراہم کرتی ہے۔</p>
        <a href="/ur/about/" style="margin-top:14px;display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:11px;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;text-decoration:none">مکمل گائیڈ پڑھیں
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </a>
      </section>
    </main>

    <aside class="rail-start">
      <a href="/ur/prayer-times/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">مواقیتِ نماز</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">آپ کے مقام کے مطابق آج کے اوقات</span></span>
      </a>

      <a href="/ur/mosques-near-me/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11Z"/></svg>
        </span>
        <span><span style="display:block;font-weight:700;font-size:15.5px;color:var(--accent)">میرے قریب مساجد</span><span style="display:block;font-size:13px;color:var(--muted);margin-top:2px">قریب ترین مساجد، راستے کے ساتھ</span></span>
      </a>

      <a href="/ur/qibla/" class="card" style="padding:16px 18px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:13px;border-color:var(--accent)">
        <span style="width:40px;height:40px;flex:0 0 auto;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        </span>
