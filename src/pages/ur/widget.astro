---
import { OCCASIONS, occLoc } from '../../lib/occasions';
import Layout from '../../layouts/Layout.astro';

const canonical = 'https://islamicdates.org/ur/widget/';
const title = 'مفت اسلامی ویجٹس · ہجری تاریخ، رمضان و عید کا عدِ معکوس، مواقیتِ نماز';
const description = 'اپنی ویب سائٹ کے لیے تین مفت ویجٹس: آج کی ہجری تاریخ، رمضان و عید اور دیگر مناسبتوں کا عدِ معکوس، اور آپ کے شہر کے مواقیتِ نماز۔ کوڈ کاپی پیسٹ کریں — ہر روز خودکار اپ ڈیٹ۔';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ہوم', 'item': 'https://islamicdates.org/ur/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'ہجری تاریخ ویجٹ', 'item': canonical },
  ] },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ur" jsonLd={jsonLd} arPath="/widget/" enPath="/en/widget/" urPath="/ur/widget/">
  <header class="site-header">
    <div class="header-start">
      <a href="/ur/" class="logo" aria-label="ہوم پیج پر جائیں">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">ہجری کیلنڈر</div>
          <div class="tagline">ہجری تاریخ ویجٹ</div>
        </div>
      </a>
      <a href="/ur/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>ہوم</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">آپ کی ویب سائٹ کے لیے مفت اسلامی ویجٹس</h1>
        <p class="section-p" style="margin-top:8px">اپنی ویب سائٹ یا بلاگ میں ایک منٹ سے کم میں شامل کریں: آج کی ہجری تاریخ، رمضان و عید اور دیگر مناسبتوں کا عدِ معکوس، یا اپنے شہر کے مواقیتِ نماز۔ قسم اور ترتیبات منتخب کریں، پھر کوڈ کاپی کر کے پیسٹ کریں — ویجٹ خودکار اپ ڈیٹ ہوتا ہے۔</p>
      </section>

      <section class="card section-card" style="order:2">
        <h2 class="section-h2">۱. اپنی ترتیبات منتخب کریں</h2>
        <div style="display:grid;gap:18px;margin-top:14px">
          <div>
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">ویجٹ کی قسم</div>
            <div class="wopts" data-group="type">
              <button type="button" data-val="date" class="wopt is-on">آج کی تاریخ</button>
              <button type="button" data-val="countdown" class="wopt">مناسبتوں کا عدِ معکوس</button>
              <button type="button" data-val="prayer" class="wopt">مواقیتِ نماز</button>
            </div>
          </div>
          <div>
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">زبان</div>
            <div class="wopts" data-group="lang">
              <button type="button" data-val="ur" class="wopt is-on">اردو</button>
              <button type="button" data-val="ar" class="wopt">عربی</button>
              <button type="button" data-val="en" class="wopt">English</button>
            </div>
          </div>
          <div>
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">تھیم</div>
            <div class="wopts" data-group="theme">
              <button type="button" data-val="light" class="wopt is-on">روشن</button>
              <button type="button" data-val="dark" class="wopt">تاریک</button>
              <button type="button" data-val="auto" class="wopt">خودکار</button>
            </div>
          </div>
          <div id="w-occ-row" style="display:none">
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">مناسبت</div>
            <select id="w-occ" class="wsel">
              {OCCASIONS.map(o => <option value={o.slug} selected={o.slug === 'ramadan'}>{occLoc(o, 'ur').name}</option>)}
            </select>
          </div>
          <div id="w-city-row" style="display:none">
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">شہر</div>
            <select id="w-city" class="wsel">
              <option value="makkah" selected>مکہ مکرمہ</option>
              <option value="madinah">مدینہ منورہ</option>
              <option value="riyadh">ریاض</option>
              <option value="doha">دوحہ</option>
              <option value="dubai">دبئی</option>
              <option value="kuwait">کویت سٹی</option>
              <option value="cairo">قاہرہ</option>
              <option value="amman">عمان</option>
              <option value="damascus">دمشق</option>
              <option value="istanbul">استنبول</option>
              <option value="london">لندن</option>
              <option value="paris">پیرس</option>
              <option value="newyork">نیویارک</option>
              <option value="karachi">کراچی</option>
              <option value="jakarta">جکارتہ</option>
            </select>
          </div>
        </div>
      </section>

      <section class="card section-card" style="order:3">
        <h2 class="section-h2">۲. پیش منظر</h2>
        <div style="margin-top:14px;background:var(--surface2);border:1px dashed var(--border);border-radius:14px;padding:18px;display:flex;justify-content:center">
          <iframe id="w-preview" src="/embed/?lang=ur&theme=light" title="آج کی ہجری تاریخ" width="360" height="150" loading="lazy" style="border:0;width:100%;max-width:360px;height:150px;overflow:hidden"></iframe>
        </div>
      </section>

      <section class="card section-card" style="order:4">
        <h2 class="section-h2">۳. کوڈ کاپی کریں</h2>
        <p class="section-p" style="margin:8px 0 12px">اس کوڈ کو اپنے صفحے میں وہاں پیسٹ کریں جہاں آپ ویجٹ دکھانا چاہتے ہیں۔</p>
        <textarea id="w-code" readonly rows="4" style="width:100%;box-sizing:border-box;padding:13px;border-radius:11px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:1.6;direction:ltr;text-align:left;resize:vertical"></textarea>
        <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
          <button type="button" id="w-copy" style="padding:11px 20px;border-radius:11px;border:none;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;cursor:pointer">کوڈ کاپی کریں</button>
        </div>
        <p class="section-p" style="margin-top:14px;font-size:13px">کوڈ میں سائٹ کا ایک چھوٹا لنک شامل ہے — مفت سروس کی حمایت کے لیے اسے برقرار رکھنے پر ہم شکر گزار ہیں۔</p>
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">متعلقہ اوزار</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/ur/" style="color:var(--accent);text-decoration:none">ہجری کیلنڈر اور آج کی تاریخ</a>
          <a href="/ur/prayer-times/" style="color:var(--accent);text-decoration:none">مواقیتِ نماز</a>
          <a href="/ur/zakat/" style="color:var(--accent);text-decoration:none">زکوٰۃ کیلکولیٹر</a>
          <a href="/ur/about/" style="color:var(--accent);text-decoration:none">ہجری تقویم گائیڈ</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    حساب اُمّ القریٰ تقویم کے مطابق
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/ur/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">رازداری پالیسی</a>
  </footer>

  <style>
    .wopts { display: flex; flex-wrap: wrap; gap: 8px; }
    .wopt { padding: 9px 16px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-weight: 700; font-size: 14px; cursor: pointer; transition: all .15s; }
    .wopt.is-on { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
    .wsel { width: 100%; max-width: 340px; padding: 10px 12px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 14px; font-weight: 600; }
  </style>

  <script>
    (function () {
      var state = { type: 'date', lang: 'ur', theme: 'light', occasion: 'ramadan', city: 'makkah' };
      var H = { date: 150, countdown: 235, prayer: 265 };
      var TITLES = {
        ar: { date: 'التاريخ الهجري اليوم', countdown: 'العد التنازلي للمناسبات الإسلامية', prayer: 'مواقيت الصلاة' },
        en: { date: "Today's Hijri date", countdown: 'Islamic occasions countdown', prayer: 'Prayer times' },
        ur: { date: 'آج کی ہجری تاریخ', countdown: 'اسلامی مناسبتوں کا عدِ معکوس', prayer: 'مواقیتِ نماز' }
      };
      var ATTRIB = { ar: 'التقويم الهجري — islamicdates.org', en: 'Hijri Calendar — islamicdates.org', ur: 'ہجری کیلنڈر — islamicdates.org' };
      var preview = document.getElementById('w-preview');
      var codeEl = document.getElementById('w-code');
      var copyBtn = document.getElementById('w-copy');
      var occRow = document.getElementById('w-occ-row');
      var cityRow = document.getElementById('w-city-row');
      var occSel = document.getElementById('w-occ');
      var citySel = document.getElementById('w-city');

      function qs() {
        var q = '?type=' + state.type + '&lang=' + state.lang + '&theme=' + state.theme;
        if (state.type === 'countdown') q += '&occasion=' + state.occasion;
        if (state.type === 'prayer') q += '&city=' + state.city;
        return q;
      }

      function build() {
        if (occRow) occRow.style.display = state.type === 'countdown' ? '' : 'none';
        if (cityRow) cityRow.style.display = state.type === 'prayer' ? '' : 'none';
        var h = H[state.type];
        if (preview) { preview.src = '/embed/' + qs(); preview.height = h; preview.style.height = h + 'px'; }
        var titleAttr = (TITLES[state.lang] || TITLES.ar)[state.type];
        var attrib = ATTRIB[state.lang] || ATTRIB.ar;
        var code =
          '<iframe src="https://islamicdates.org/embed/' + qs() + '" title="' + titleAttr + '" width="360" height="' + h + '" loading="lazy" style="border:0;width:100%;max-width:360px"></iframe>\n' +
          '<div style="font:13px system-ui,sans-serif;margin-top:6px"><a href="https://islamicdates.org/" target="_blank" rel="noopener">' + attrib + '</a></div>';
        if (codeEl) codeEl.value = code;
      }

      document.querySelectorAll('.wopts').forEach(function (group) {
        group.addEventListener('click', function (e) {
          var btn = e.target.closest('.wopt');
          if (!btn) return;
          var g = group.getAttribute('data-group');
          state[g] = btn.getAttribute('data-val');
          group.querySelectorAll('.wopt').forEach(function (b) { b.classList.toggle('is-on', b === btn); });
          build();
        });
      });

      if (occSel) occSel.addEventListener('change', function () { state.occasion = occSel.value; build(); });
      if (citySel) citySel.addEventListener('change', function () { state.city = citySel.value; build(); });

      if (copyBtn) copyBtn.addEventListener('click', function () {
        if (!codeEl) return;
        codeEl.select();
        try { navigator.clipboard.writeText(codeEl.value); } catch (e) { try { document.execCommand('copy'); } catch (e2) {} }
        var t = copyBtn.textContent;
        copyBtn.textContent = 'کاپی ہو گیا ✓';
        setTimeout(function () { copyBtn.textContent = t; }, 1800);
      });

      build();
    })();
  </script>
</Layout>
