---
import Layout from '../layouts/Layout.astro';
import { getL } from '../lib/data';

const L = getL(true);
const canonical = 'https://islamicdates.org/about/';
const title = 'ما هو التقويم الهجري؟ دليل شامل عن تقويم أم القرى وحساب التاريخ';
const description = 'دليل التقويم الهجري: ما هو، كيف يُحسب فلكياً، والفرق بين تقويم أم القرى ورؤية الهلال، مع أسئلة شائعة عن التاريخ الهجري والميلادي.';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://islamicdates.org/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'دليل التقويم الهجري', 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': L.faqItems.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ar" jsonLd={jsonLd} altPath="/en/about/" xDefaultPath="/about/">
  <header class="site-header">
    <div class="header-start">
      <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">التقويم الهجري</div>
          <div class="tagline">دليل التقويم الهجري</div>
        </div>
      </a>
      <a href="/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>الرئيسية</span>
      </a>
    </div>
    <a href="/en/about/" class="lang-btn">EN</a>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">{L.whatIsTitle}</h1>
        <p class="section-p" style="margin-top:8px">{L.whatIsBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.diffTitle}</h2>
        <p class="section-p">{L.diffBody}</p>
        <h2 class="section-h2" style="margin-top:22px">{L.howTitle}</h2>
        <p class="section-p">{L.howBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.aboutTitle}</h2>
        <p class="section-p">{L.aboutBody}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{L.faqTitle}</h2>
        {L.faqItems.map((f, i) => (
          <div class="faq-item" style={i === L.faqItems.length - 1 ? 'border-bottom:none' : ''}>
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="ad-slot"><span class="ad-label">مساحة إعلانية</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">أدوات ذات صلة</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/" style="color:var(--accent);text-decoration:none">التقويم الهجري وتاريخ اليوم</a>
          <a href="/#converter" style="color:var(--accent);text-decoration:none">محوّل التاريخ الهجري والميلادي</a>
          <a href="/prayer-times/" style="color:var(--accent);text-decoration:none">مواقيت الصلاة حسب موقعك</a>
          <a href="/zakat/" style="color:var(--accent);text-decoration:none">حاسبة الزكاة</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    الحساب وفق تقويم أم القرى
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
  </footer>
</Layout>
