---
import { OCCASIONS, occLoc } from '../lib/occasions';
import Layout from '../layouts/Layout.astro';

const canonical = 'https://islamicdates.org/widget/';
const title = 'ويدجت إسلامية لموقعك · التاريخ الهجري وعدّاد المناسبات ومواقيت الصلاة';
const description = 'ثلاث ويدجت مجانية لموقعك أو مدونتك: التاريخ الهجري اليوم، العدّ التنازلي لرمضان والأعياد، ومواقيت الصلاة لمدينتك. انسخ الكود وألصقه — تُحدَّث تلقائياً كل يوم وفق تقويم أم القرى.';

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://islamicdates.org/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'ويدجت التاريخ الهجري', 'item': canonical },
  ] },
]);
---
<Layout title={title} description={description} canonical={canonical} lang="ar" jsonLd={jsonLd} arPath="/widget/" enPath="/en/widget/" urPath="/ur/widget/">
  <header class="site-header">
    <div class="header-start">
      <a href="/" class="logo" aria-label="الانتقال إلى الصفحة الرئيسية">
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">التقويم الهجري</div>
          <div class="tagline">ويدجت التاريخ الهجري</div>
        </div>
      </a>
      <a href="/" class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>الرئيسية</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:25px">ويدجت إسلامية مجانية لموقعك</h1>
        <p class="section-p" style="margin-top:8px">أضِف إلى موقعك أو مدونتك في دقيقة: تاريخ اليوم الهجري، أو عدّاداً تنازلياً لرمضان والأعياد والمناسبات، أو مواقيت الصلاة لمدينتك. اختر النوع والإعدادات، ثم انسخ الكود وألصقه — تُحدَّث الويدجت تلقائياً دون أي صيانة منك.</p>
      </section>

      <section class="card section-card" style="order:2">
        <h2 class="section-h2">١. اختر الإعدادات</h2>
        <div style="display:grid;gap:18px;margin-top:14px">
          <div>
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">نوع الويدجت</div>
            <div class="wopts" data-group="type">
              <button type="button" data-val="date" class="wopt is-on">تاريخ اليوم</button>
              <button type="button" data-val="countdown" class="wopt">عدّاد المناسبات</button>
              <button type="button" data-val="prayer" class="wopt">مواقيت الصلاة</button>
            </div>
          </div>
          <div>
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">اللغة</div>
            <div class="wopts" data-group="lang">
              <button type="button" data-val="ar" class="wopt is-on">عربي</button>
              <button type="button" data-val="en" class="wopt">English</button>
              <button type="button" data-val="ur" class="wopt">اردو</button>
            </div>
          </div>
          <div>
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">النمط</div>
            <div class="wopts" data-group="theme">
              <button type="button" data-val="light" class="wopt is-on">فاتح</button>
              <button type="button" data-val="dark" class="wopt">داكن</button>
              <button type="button" data-val="auto" class="wopt">تلقائي</button>
            </div>
          </div>
          <div id="w-occ-row" style="display:none">
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">المناسبة</div>
            <select id="w-occ" class="wsel">
              {OCCASIONS.map(o => <option value={o.slug} selected={o.slug === 'ramadan'}>{occLoc(o, 'ar').name}</option>)}
            </select>
          </div>
          <div id="w-city-row" style="display:none">
            <div style="font-size:13.5px;font-weight:700;color:var(--muted);margin-bottom:8px">المدينة</div>
            <select id="w-city" class="wsel">
              <option value="makkah" selected>مكة المكرمة</option>
              <option value="madinah">المدينة المنورة</option>
              <option value="riyadh">الرياض</option>
              <option value="doha">الدوحة</option>
              <option value="dubai">دبي</option>
              <option value="kuwait">الكويت</option>
              <option value="cairo">القاهرة</option>
              <option value="amman">عمّان</option>
              <option value="damascus">دمشق</option>
              <option value="istanbul">إسطنبول</option>
              <option value="london">لندن</option>
              <option value="paris">باريس</option>
              <option value="newyork">نيويورك</option>
              <option value="karachi">كراتشي</option>
              <option value="jakarta">جاكرتا</option>
            </select>
          </div>
        </div>
      </section>

      <section class="card section-card" style="order:3">
        <h2 class="section-h2">٢. المعاينة</h2>
        <div style="margin-top:14px;background:var(--surface2);border:1px dashed var(--border);border-radius:14px;padding:18px;display:flex;justify-content:center">
          <iframe id="w-preview" src="/embed/?lang=ar&theme=light" title="التاريخ الهجري اليوم" width="360" height="150" loading="lazy" style="border:0;width:100%;max-width:360px;height:150px;overflow:hidden"></iframe>
        </div>
      </section>

      <section class="card section-card" style="order:4">
        <h2 class="section-h2">٣. انسخ الكود</h2>
        <p class="section-p" style="margin:8px 0 12px">ألصِق هذا الكود في المكان الذي تريد ظهور الويدجت فيه داخل صفحة موقعك.</p>
        <textarea id="w-code" readonly rows="4" style="width:100%;box-sizing:border-box;padding:13px;border-radius:11px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:1.6;direction:ltr;text-align:left;resize:vertical"></textarea>
        <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
          <button type="button" id="w-copy" style="padding:11px 20px;border-radius:11px;border:none;background:var(--accent);color:var(--accent-contrast);font-weight:700;font-size:14px;cursor:pointer">نسخ الكود</button>
        </div>
        <p class="section-p" style="margin-top:14px;font-size:13px">يتضمّن الكود رابطاً صغيراً إلى الموقع — نشكر إبقاءه لدعم استمرار الخدمة مجاناً.</p>
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">أدوات ذات صلة</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href="/" style="color:var(--accent);text-decoration:none">التقويم الهجري وتاريخ اليوم</a>
          <a href="/prayer-times/" style="color:var(--accent);text-decoration:none">مواقيت الصلاة</a>
          <a href="/zakat/" style="color:var(--accent);text-decoration:none">حاسبة الزكاة</a>
          <a href="/about/" style="color:var(--accent);text-decoration:none">دليل التقويم الهجري</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    الحساب وفق تقويم أم القرى
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href="/privacy/" style="color:var(--muted);text-decoration:none;font-size:13px">سياسة الخصوصية</a>
  </footer>

  <style>
    .wopts { display: flex; flex-wrap: wrap; gap: 8px; }
    .wopt { padding: 9px 16px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-weight: 700; font-size: 14px; cursor: pointer; transition: all .15s; }
    .wopt.is-on { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
    .wsel { width: 100%; max-width: 340px; padding: 10px 12px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 14px; font-weight: 600; }
  </style>

  <script>
    (function () {
      var state = { type: 'date', lang: 'ar', theme: 'light', occasion: 'ramadan', city: 'makkah' };
      var H = { date: 150, countdown: 235, prayer: 265 };
      var TITLES = {
        ar: { date: 'التاريخ الهجري اليوم', countdown: 'العد التنازلي للمناسبات الإسلامية', prayer: 'مواقيت الصلاة' },
        en: { date: "Today's Hijri date", countdown: 'Islamic occasions countdown', prayer: 'Prayer times' },
        ur: { date: 'آج کی ہجری تاریخ', countdown: 'اسلامی مناسبتوں کا عدِ معکوس', prayer: 'مواقیتِ نماز' }
      };
      var ATTRIB = { ar: 'التقويم الهجري — islamicdates.org', en: 'Hijri Calendar — islamicdates.org', ur: 'ہجری کیلنڈر — islamicdates.org' };
      var preview = document.getElementById('w-preview');
      var codeEl = document.getElementById('w-code');
      var copyBtn = document.getElementById('w-copy');
      var occRow = document.getElementById('w-occ-row');
      var cityRow = document.getElementById('w-city-row');
      var occSel = document.getElementById('w-occ');
      var citySel = document.getElementById('w-city');

      function qs() {
        var q = '?type=' + state.type + '&lang=' + state.lang + '&theme=' + state.theme;
        if (state.type === 'countdown') q += '&occasion=' + state.occasion;
        if (state.type === 'prayer') q += '&city=' + state.city;
        return q;
      }

      function build() {
        if (occRow) occRow.style.display = state.type === 'countdown' ? '' : 'none';
        if (cityRow) cityRow.style.display = state.type === 'prayer' ? '' : 'none';
        var h = H[state.type];
        if (preview) { preview.src = '/embed/' + qs(); preview.height = h; preview.style.height = h + 'px'; }
        var titleAttr = (TITLES[state.lang] || TITLES.ar)[state.type];
        var attrib = ATTRIB[state.lang] || ATTRIB.ar;
        var code =
          '<iframe src="https://islamicdates.org/embed/' + qs() + '" title="' + titleAttr + '" width="360" height="' + h + '" loading="lazy" style="border:0;width:100%;max-width:360px"></iframe>\n' +
          '<div style="font:13px system-ui,sans-serif;margin-top:6px"><a href="https://islamicdates.org/" target="_blank" rel="noopener">' + attrib + '</a></div>';
        if (codeEl) codeEl.value = code;
      }

      document.querySelectorAll('.wopts').forEach(function (group) {
        group.addEventListener('click', function (e) {
          var btn = e.target.closest('.wopt');
          if (!btn) return;
          var g = group.getAttribute('data-group');
          state[g] = btn.getAttribute('data-val');
          group.querySelectorAll('.wopt').forEach(function (b) { b.classList.toggle('is-on', b === btn); });
          build();
        });
      });

      if (occSel) occSel.addEventListener('change', function () { state.occasion = occSel.value; build(); });
      if (citySel) citySel.addEventListener('change', function () { state.city = citySel.value; build(); });

      if (copyBtn) copyBtn.addEventListener('click', function () {
        if (!codeEl) return;
        codeEl.select();
        try { navigator.clipboard.writeText(codeEl.value); } catch (e) { try { document.execCommand('copy'); } catch (e2) {} }
        var t = copyBtn.textContent;
        copyBtn.textContent = 'تم النسخ ✓';
        setTimeout(function () { copyBtn.textContent = t; }, 1800);
      });

      build();
    })();
  </script>
</Layout>
