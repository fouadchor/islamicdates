---
// redeploy marker 2026-06-29 — trilingual (ar / en / ur)
import { type Lang, pick } from '../lib/data';
import { OCCASIONS, occLoc, occBasePath, occurrencesInGYear, fmtGShort, isoUTC } from '../lib/occasions';
interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: Lang;
  jsonLd?: string;
  // Path (no domain) of each language version of this page — used for hreflang + switcher.
  arPath?: string;
  enPath?: string;
  urPath?: string;
  /** false = صفحة عربية فقط: لا تُصدر hreflang لنسخ لغوية غير موجودة. */
  altLangs?: boolean;
  /** Keep the page out of the index while still passing link equity. */
  noindex?: boolean;
}
const { title, description, canonical, lang, jsonLd, arPath = '/', enPath = '/en/', urPath = '/ur/', altLangs = true, noindex = false } = Astro.props;
const dir = lang === 'en' ? 'ltr' : 'rtl';
const ogLocale = pick(lang, 'ar_AR', 'en_US', 'ur_PK');
const base = 'https://islamicdates.org';
const langs: { code: Lang; path: string; label: string }[] = [
  { code: 'ar', path: arPath, label: 'عربي' },
  { code: 'en', path: enPath, label: 'EN' },
  { code: 'ur', path: urPath, label: 'اردو' },
];

const _navHome = pick(lang, '/', '/en/', '/ur/');
const _navPrayer = pick(lang, '/prayer-times/', '/en/prayer-times/', '/ur/prayer-times/');
const _navZakat = pick(lang, '/zakat/', '/en/zakat/', '/ur/zakat/');
const _navDua = pick(lang, '/dua/', '/en/dua/', '/ur/dua/');
const _navFasting = pick(lang, '/fasting/', '/en/fasting/', '/ur/fasting/');
const _navAbout = pick(lang, '/about/', '/en/about/', '/ur/about/');
const _navOtd = pick(lang, '/on-this-day/', '/en/on-this-day/', '/ur/on-this-day/');
const _lblOtd = pick(lang, 'في مثل هذا اليوم الهجري', 'On this day in Hijri history', 'اِسی ہجری دن');
const _navMosques = pick(lang, '/mosques-near-me/', '/en/mosques-near-me/', '/ur/mosques-near-me/');
const _lblMosques = pick(lang, 'الجوامع القريبة من مكاني', 'Mosques Near Me', 'میرے قریب مساجد');
const _navQibla = pick(lang, '/qibla/', '/en/qibla/', '/ur/qibla/');
const _lblQibla = pick(lang, 'اتجاه القبلة', 'Qibla Direction', 'قبلہ کا رخ');
// Nav-only short labels: the full English labels overflow the single-row desktop nav.
const _navLblQibla = pick(lang, 'اتجاه القبلة', 'Qibla', 'قبلہ کا رخ');
const _navLblZakat = pick(lang, 'حاسبة الزكاة', 'Zakat', 'زکوٰۃ کیلکولیٹر');
const _labels = {
  home: pick(lang, 'الرئيسية', 'Home', 'ہوم'),
  conv: pick(lang, 'المحوّل', 'Converter', 'کنورٹر'),
  prayer: pick(lang, 'مواقيت الصلاة', 'Prayer Times', 'مواقیتِ نماز'),
  zakat: pick(lang, 'حاسبة الزكاة', 'Zakat Calculator', 'زکوٰۃ کیلکولیٹر'),
  dua: pick(lang, 'الدعاء', 'Duʿaʾ', 'دعا'),
  fasting: pick(lang, 'أيام الصيام', 'Fasting', 'روزے'),
  occ: pick(lang, 'المناسبات', 'Occasions', 'مناسبتیں'),
  guide: pick(lang, 'الدليل', 'Guide', 'رہنمائی'),
};
// Split drives the compact mobile bar only: primary items stay in the bar at every
// width, the rest collapse into the "More" menu below 860px. Desktop concatenates
// them back in the original order, so the wide nav is unchanged.
const navPrimary = [
  { h: _navHome, t: _labels.home },
  { h: _navHome + '#converter', t: _labels.conv },
  { h: _navPrayer, t: _labels.prayer },
];
const navSecondary = [
  { h: _navQibla, t: _navLblQibla },
  { h: _navZakat, t: _navLblZakat },
  { h: _navDua, t: _labels.dua },
  { h: _navFasting, t: _labels.fasting },
  { h: _navHome + '#occasions', t: _labels.occ },
  { h: _navAbout, t: _labels.guide },
];
const navItems = [...navPrimary, ...navSecondary];
const _lblKids = pick(lang, 'ركن الصغار', 'Kids Corner', 'بچوں کا گوشہ');
const _lblMore = pick(lang, 'المزيد', 'More', 'مزید');
const _lblMoreMenu = pick(lang, 'قائمة إضافية', 'More menu', 'مزید مینو');
const _lblLanguage = pick(lang, 'اللغة', 'Language', 'زبان');
// Current path (normalised with trailing slash) → active nav highlighting.
const _curPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const _isActive = (h: string) => !h.includes('#') && h === _curPath;
const _themeLabel = pick(lang, 'تبديل الوضع الليلي', 'Toggle dark mode', 'ڈارک موڈ تبدیل کریں');
const _topLabel = pick(lang, 'العودة إلى الأعلى', 'Back to top', 'اوپر جائیں');

// ——— Sitemap footer (language-aware, site-wide) ———
const _navAge = pick(lang, '/age/', '/en/age/', '/ur/age/');
const _navPrint = pick(lang, '/printable/', '/en/printable/', '/ur/printable/');
const _navWidget = pick(lang, '/widget/', '/en/widget/', '/ur/widget/');
const _navPrivacy = pick(lang, '/privacy/', '/en/privacy/', '/ur/privacy/');
const _navContact = pick(lang, '/contact/', '/en/contact/', '/ur/contact/');
const _fBrand = pick(lang, 'التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر');
const _fTagline = pick(lang,
  'تقويم أم القرى: تحويل التواريخ، مواقيت الصلاة، والمناسبات الإسلامية في مكان واحد.',
  'Umm al-Qura calendar: date conversion, prayer times, and Islamic occasions in one place.',
  'اُمّ القریٰ تقویم: تاریخوں کی تبدیلی، مواقیتِ نماز اور اسلامی مناسبتیں ایک جگہ۔');
const _fRights = pick(lang, 'الحساب وفق تقويم أم القرى', 'Calculated per the Umm al-Qura calendar', 'حساب اُمّ القریٰ تقویم کے مطابق');
const _colQuick = pick(lang, 'روابط سريعة', 'Quick links', 'فوری روابط');
const _colTools = pick(lang, 'الأدوات', 'Tools', 'ٹولز');
const _colOcc = pick(lang, 'المناسبات', 'Occasions', 'مناسبتیں');
const _lblAge = pick(lang, 'حاسبة العمر بالهجري', 'Hijri age calculator', 'ہجری عمر کیلکولیٹر');
const _lblPrint = pick(lang, 'تقويم هجري للطباعة', 'Printable calendar', 'پرنٹ کے قابل کیلنڈر');
const _lblWidget = pick(lang, 'ويدجت لموقعك', 'Widget for your site', 'آپ کی سائٹ کے لیے ویجٹ');
const _lblPrivacy = pick(lang, 'سياسة الخصوصية', 'Privacy Policy', 'رازداری پالیسی');
const _lblContact = pick(lang, 'اتصل بنا', 'Contact', 'رابطہ');
const _fLangLabel = (c: Lang) => c === 'ar' ? 'العربية' : c === 'en' ? 'English' : 'اردو';
const _footYear = new Date().getUTCFullYear();
const _footNow = Date.now();
const _footOccSlugs = ['ramadan', 'eid-al-fitr', 'eid-al-adha', 'day-of-arafah', 'laylat-al-qadr', 'ashura', 'mawlid-al-nabi', 'islamic-new-year', 'isra-and-miraj'];
const _footOcc = _footOccSlugs.map(_s => {
  const _o = OCCASIONS.find(x => x.slug === _s);
  if (!_o) return null;
  let _gy = _footYear;
  for (let _y = _footYear; _y <= _footYear + 1; _y++) {
    const _hit = occurrencesInGYear(_o.hm, _o.hd, _y).find(oc => oc.date.getTime() >= _footNow);
    if (_hit) { _gy = _y; break; }
  }
  return { name: occLoc(_o, lang).name, href: occBasePath(_s, _gy, lang) };
}).filter(Boolean) as { name: string; href: string }[];

// ——— Upcoming-occasion banner (site-wide, under the nav) ———
// Build-time list of the next few occurrences; a tiny inline script re-picks the
// first future one at view time (and fixes the countdown), so static pages never go stale.
const _bnList = OCCASIONS.flatMap(o => {
  const out: { s: string; n: string; gy: number; href: string; d: string; dt: string }[] = [];
  for (let y = _footYear; y <= _footYear + 1; y++) {
    for (const oc of occurrencesInGYear(o.hm, o.hd, y)) {
      if (oc.date.getTime() >= _footNow - 86400000) {
        out.push({ s: o.slug, n: occLoc(o, lang).name, gy: y, href: occBasePath(o.slug, y, lang), d: isoUTC(oc.date), dt: fmtGShort(oc.date, lang) });
      }
    }
  }
  return out;
}).sort((a, b) => (a.d < b.d ? -1 : 1)).slice(0, 4);
const _bn = _bnList[0];
const _bnToday = Math.floor(_footNow / 86400000) * 86400000;
const _bnDays = _bn ? Math.max(0, Math.round((Date.parse(_bn.d) - _bnToday) / 86400000)) : 0;
const _bnCount = _bn ? pick(lang,
  _bnDays === 0 ? 'اليوم' : `باقٍ ${_bnDays} يوم`,
  _bnDays === 0 ? 'Today' : `${_bnDays} days left`,
  _bnDays === 0 ? 'آج' : `${_bnDays} دن باقی`) : '';
const _bnClose = pick(lang, 'إخفاء', 'Dismiss', 'چھپائیں');
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={`${noindex ? 'noindex' : 'index'}, follow, max-image-preview:large`} />
  <meta name="theme-color" content="#0d9488" />
  <link rel="canonical" href={canonical} />
  {altLangs && langs.map(l => <link rel="alternate" hreflang={l.code} href={`${base}${l.path}`} />)}
  {!altLangs && <link rel="alternate" hreflang="ar" href={`${base}${arPath}`} />}
  <link rel="alternate" hreflang="x-default" href={`${base}${arPath}`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://islamicdates.org/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://islamicdates.org/og-image.png" />
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  <script is:inline>
    // Set theme before first paint (no flash). Manual choice wins; system preference otherwise.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'dark' && t !== 'light') t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        if (t === 'dark') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#122129');
        }
      } catch (e) {}
    })();
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3QNF278Y3B"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3QNF278Y3B');
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1722763564281190" crossorigin="anonymous"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    button { font-family: inherit; cursor: pointer; }
    input, select { outline: none; font-family: inherit; }
    ::selection { background: rgba(13,148,136,.22); }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

    :root {
      color-scheme: light;
      --bg: #eef2f6;
      --surface: #ffffff;
      --surface2: #f5f8fa;
      --text: #0f2730;
      --muted: #5b7682;
      --accent: #0d9488;
      --accent-strong: #0b7d73;
      --accent-contrast: #ffffff;
      --accent-soft: #d4f4ee;
      --accent-glow: rgba(13,148,136,.07);
      --border: #e3eaef;
      --gold: #c98a16;
      --gold-soft: #f6ecd6;
      --gold-deep: #8a5f12;
      --holy: #0ea5e9;
      --radius: 18px;
      /* Height of the sticky nav, and the offset #anchor targets must clear to
         land below it. Both step down per breakpoint alongside the nav itself. */
      --nav-h: 47px;
      --anchor-offset: 56px;
      --shadow: 0 1px 2px rgba(13,40,48,.06), 0 10px 30px rgba(13,40,48,.05);
      --shadow-lift: 0 4px 10px rgba(13,40,48,.08), 0 16px 40px rgba(13,40,48,.10);
      --nav-bg: linear-gradient(90deg, #0b7d73, #0d9488 55%, #109c8b);
    }
    [data-theme="dark"] {
      color-scheme: dark;
      --bg: #0c161b;
      --surface: #122129;
      --surface2: #182b34;
      --text: #e6eff1;
      --muted: #90a9b2;
      --accent: #17ab9c;
      --accent-strong: #129084;
      --accent-contrast: #ffffff;
      --accent-soft: rgba(23,171,156,.16);
      --accent-glow: rgba(23,171,156,.06);
      --border: #233a44;
      --gold: #d7a13a;
      --gold-soft: #2a2212;
      --gold-deep: #e3b45c;
      --holy: #38bdf8;
      --shadow: 0 1px 2px rgba(0,0,0,.35), 0 10px 30px rgba(0,0,0,.30);
      --shadow-lift: 0 4px 10px rgba(0,0,0,.40), 0 16px 40px rgba(0,0,0,.38);
      --nav-bg: linear-gradient(90deg, #0e3d3c, #10504b 55%, #115a53);
    }
    /* Hadith source chip uses gold-deep as a background in the page markup — restyle for dark. */
    [data-theme="dark"] #hadith-src { background: var(--gold-soft) !important; color: var(--gold-deep) !important; border: 1px solid rgba(215,161,58,.4); }

    [lang="ar"] { font-family: 'IBM Plex Sans Arabic', sans-serif; }
    [lang="en"] { font-family: 'Plus Jakarta Sans', sans-serif; }
    [lang="ur"] { font-family: 'Noto Naskh Arabic', 'IBM Plex Sans Arabic', serif; }

    @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
    @keyframes pop { from { opacity:0; transform:scale(.96); } to { opacity:1; transform:none; } }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    a.card { transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
    a.card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); border-color: var(--accent) !important; }

    body {
      min-height: 100vh;
      background: var(--bg);
      background-image: radial-gradient(1100px 420px at 50% -120px, var(--accent-glow), transparent 70%);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      transition: background-color .25s ease, color .25s ease;
    }

    .site-nav {
      position: sticky; top: 0; z-index: 40;
      background: var(--nav-bg);
      box-shadow: var(--shadow);
    }
    .site-nav-inner {
      max-width: 1180px; margin: 0 auto;
      display: flex; align-items: stretch; gap: 8px;
      padding: 0 12px;
    }
    .nav-links {
      display: flex; gap: 2px; flex: 1 1 auto; min-width: 0;
      overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    }
    .nav-links::-webkit-scrollbar { display: none; }
    .site-nav .nav-kids { flex: 0 0 auto; }
    .site-nav .nav-link {
      color: var(--accent-contrast); text-decoration: none;
      font-weight: 600; font-size: 14px; white-space: nowrap;
      padding: 13px 15px; opacity: .88;
      border-bottom: 3px solid transparent;
      transition: opacity .2s, background .2s, border-color .2s;
    }
    .site-nav .nav-link:hover { opacity: 1; background: rgba(255,255,255,.14); }
    .site-nav .nav-link.active { opacity: 1; border-bottom-color: rgba(255,255,255,.92); font-weight: 700; }

    .nav-actions { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; padding: 5px 0; }
    .theme-toggle {
      width: 34px; height: 34px; border-radius: 999px; border: none;
      background: rgba(255,255,255,.14); color: var(--accent-contrast);
      display: inline-flex; align-items: center; justify-content: center;
      transition: background .2s, transform .2s;
    }
    .theme-toggle:hover { background: rgba(255,255,255,.26); transform: rotate(12deg); }
    .theme-toggle .ic-sun { display: none; }
    .theme-toggle .ic-moon { display: block; }
    [data-theme="dark"] .theme-toggle .ic-sun { display: block; }
    [data-theme="dark"] .theme-toggle .ic-moon { display: none; }

    .lang-switch {
      display: flex; align-items: center; gap: 3px;
      background: rgba(255,255,255,.13);
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 999px; padding: 3px;
    }
    .lang-switch .lang-globe {
      width: 14px; height: 14px; flex: 0 0 auto; opacity: .85;
      color: var(--accent-contrast);
      margin-inline-start: 8px; margin-inline-end: 3px;
    }
    .lang-switch a {
      color: var(--accent-contrast); text-decoration: none;
      font-weight: 700; font-size: 12.5px; line-height: 1;
      padding: 7px 12px; border-radius: 999px; opacity: .85;
      transition: background .2s, opacity .2s, color .2s;
    }
    .lang-switch a:hover { opacity: 1; background: rgba(255,255,255,.18); }
    .lang-switch a.on {
      background: var(--accent-contrast); color: var(--accent); opacity: 1;
      box-shadow: 0 1px 5px rgba(0,0,0,.2);
    }

    .site-header {
      position: relative; z-index: 1;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 22px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    .site-header .logo {
      display: flex; align-items: center; gap: 13px;
    }
    .site-header .logo-icon {
      width: 44px; height: 44px; flex: 0 0 auto;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
      color: var(--accent-contrast);
      box-shadow: 0 3px 10px rgba(13,148,136,.35);
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; line-height: 1;
    }
    .site-header .brand { font-weight: 700; font-size: 19px; white-space: nowrap; line-height: 1.2; }
    .site-header .tagline { font-size: 12.5px; color: var(--muted); line-height: 1.2; }
    .lang-btn {
      padding: 9px 13px; border-radius: 11px;
      border: 1px solid var(--border); background: var(--surface2);
      color: var(--text); font-weight: 700; font-size: 14px;
      text-decoration: none; display: inline-block;
      transition: border-color .2s, color .2s;
    }
    .lang-btn:hover { border-color: var(--accent); color: var(--accent); }

    .header-start { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    a.logo { text-decoration: none; color: inherit; border-radius: 12px; transition: opacity .2s; }
    a.logo:hover { opacity: .88; }
    a.logo:hover .logo-icon { transform: scale(1.06) rotate(-6deg); }
    .site-header .logo-icon { transition: transform .25s ease; }
    .home-btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 14px; border-radius: 11px;
      background: var(--accent); color: var(--accent-contrast);
      font-weight: 700; font-size: 14px; text-decoration: none;
      border: 1px solid var(--accent);
      box-shadow: 0 1px 2px rgba(13,40,48,.08);
      transition: background .2s, transform .2s, box-shadow .2s;
    }
    .home-btn:hover { background: var(--accent-strong); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(13,148,136,.25); }
    .home-btn:active { transform: translateY(0); }
    .home-btn svg { display: block; }

    .layout {
      max-width: 1440px; margin: 0 auto;
      padding: 22px 20px 50px;
      display: grid; gap: 22px; align-items: start;
      grid-template-columns: 300px minmax(0, 1fr) 300px;
      grid-template-areas: "railstart main railend";
    }
    .layout > main { grid-area: main; }
    .layout > .rail-start { grid-area: railstart; }
    .layout > .rail-end { grid-area: railend; }
    main { min-width: 0; display: flex; flex-direction: column; gap: 20px; }
    aside { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 88px; align-self: start; }

    /* Tablet: main + one stacked rail column */
    @media (max-width: 1200px) {
      .layout {
        grid-template-columns: minmax(0, 1fr) 320px;
        grid-template-areas: "main railstart" "main railend";
      }
    }
    /* Small tablet / mobile: single column */
    @media (max-width: 820px) {
      .layout {
        grid-template-columns: 1fr;
        grid-template-areas: "main" "railstart" "railend";
      }
      aside { position: static; }
    }

    .section-card { padding: 24px 28px; }
    .quicklinks { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
    .quicklinks a { display: inline-flex; align-items: center; padding: 9px 15px; border-radius: 11px; background: var(--surface2); border: 1px solid var(--border); color: var(--accent); font-weight: 700; font-size: 14px; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
    .quicklinks a:hover { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
    .section-h2 { margin: 0 0 8px; font-size: 19px; font-weight: 700; line-height: 1.3; }
    .section-h2::after { content: ''; display: block; width: 30px; height: 3px; margin-top: 7px; border-radius: 2px; background: linear-gradient(90deg, var(--gold), var(--accent)); opacity: .9; }
    .section-p { margin: 0; color: var(--muted); line-height: 1.85; font-size: 15px; text-wrap: pretty; }

    .months-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; margin-top: 14px; }
    .month-item { display: flex; gap: 11px; align-items: flex-start; padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface2); transition: border-color .2s, transform .2s, box-shadow .2s; }
    a.month-item:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
    a.month-item:hover .month-name { color: var(--accent); }
    .month-num { flex: 0 0 auto; width: 27px; height: 27px; border-radius: 8px; background: var(--gold-soft); color: var(--gold-deep); font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; }
    .month-name { font-weight: 700; font-size: 14.5px; transition: color .2s; }
    .month-note { font-size: 12.5px; color: var(--muted); margin-top: 2px; line-height: 1.5; }

    .faq-item { padding: 13px 0; border-bottom: 1px solid var(--border); }
    .faq-q { margin: 0; font-weight: 700; font-size: 15.5px; }
    .faq-a { margin: 6px 0 0; color: var(--muted); line-height: 1.75; font-size: 14.5px; text-wrap: pretty; }

    .ad-slot {
      border: 1px dashed var(--border); border-radius: var(--radius);
      background: var(--surface2); min-height: 250px;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 8px; color: var(--muted); text-align: center; padding: 22px;
    }
    .ad-label { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }

    /* Old one-line per-page footer is superseded by the sitemap footer (.sm-footer) below. */
    .site-footer { display: none !important; }

    /* ——— Sitemap footer ——— */
    .sm-footer {
      background: linear-gradient(180deg, #0e463f 0%, #0a322e 100%);
      color: #dcece8; border-top: 3px solid #14b8a6;
      font-size: 15px; line-height: 1.7;
    }
    .sm-footer a { color: inherit; text-decoration: none; transition: color .18s ease, padding .18s ease; }
    .sm-inner { max-width: 1180px; margin: 0 auto; padding: 46px 24px 22px; }
    .sm-grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1fr; gap: 32px; align-items: start; }
    .sm-brand { max-width: 320px; }
    .sm-logo { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 700; color: #fff; }
    .sm-logo-mark { color: #5eead4; font-size: 24px; line-height: 1; }
    .sm-tagline { margin: 14px 0 0; color: #8aa9a3; font-size: 14px; line-height: 1.85; }
    .sm-langs { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
    .sm-langs a { padding: 6px 15px; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; font-size: 13px; color: #c7ded9; }
    .sm-langs a:hover { border-color: #5eead4; color: #fff; }
    .sm-langs a.on { background: #14b8a6; border-color: #14b8a6; color: #fff; font-weight: 600; }
    .sm-col-title { margin: 0 0 20px; padding-bottom: 12px; font-size: 13px; font-weight: 700; letter-spacing: .3px; color: #fff; position: relative; }
    .sm-col-title::after { content: ''; position: absolute; bottom: 0; inset-inline-end: 0; width: 28px; height: 2px; background: #14b8a6; border-radius: 2px; }
    .sm-col ul { list-style: none; margin: 0; padding: 0; }
    .sm-col li { margin: 0 0 13px; }
    .sm-col a { color: #b7d1cc; font-size: 14.5px; display: inline-block; }
    .sm-col a:hover { color: #fff; padding-inline-start: 4px; }
    .sm-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: 34px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.1); }
    .sm-copy { margin: 0; color: #8aa9a3; font-size: 13.5px; }
    .sm-legal { display: flex; gap: 22px; flex-wrap: wrap; }
    .sm-legal a { color: #b7d1cc; font-size: 13.5px; }
    .sm-legal a:hover { color: #fff; }

    /* ——— Upcoming-occasion banner ——— */
    .occ-banner {
      position: relative; z-index: 1;
      display: flex; align-items: center; justify-content: center;
      min-height: 40px; padding: 7px 46px;
      background: var(--accent-soft);
      border-bottom: 1px solid var(--border);
      font-size: 14px; text-align: center;
    }
    .occ-banner > a {
      display: inline-flex; align-items: center; gap: 9px; flex-wrap: wrap; justify-content: center;
      color: var(--text); text-decoration: none; min-width: 0;
    }
    .occ-banner strong { color: var(--accent-strong); font-weight: 800; white-space: nowrap; }
    .occ-banner > a:hover strong { text-decoration: underline; }
    .occ-banner-count {
      background: var(--accent); color: var(--accent-contrast);
      border-radius: 999px; padding: 3px 11px;
      font-weight: 700; font-size: 12.5px; white-space: nowrap;
    }
    .occ-banner-close {
      position: absolute; inset-inline-end: 8px; top: 50%; transform: translateY(-50%);
      width: 28px; height: 28px; border-radius: 999px; border: none;
      background: transparent; color: var(--muted); font-size: 15px; line-height: 1;
      display: flex; align-items: center; justify-content: center;
      transition: background .2s, color .2s;
    }
    .occ-banner-close:hover { background: rgba(0,0,0,.08); color: var(--text); }
    [data-theme="dark"] .occ-banner-close:hover { background: rgba(255,255,255,.12); }
    @media (max-width: 700px) { .occ-banner { font-size: 13px; padding: 6px 40px; } }

    .back-top {
      position: fixed; bottom: 22px; inset-inline-end: 22px; z-index: 50;
      width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--border);
      background: var(--surface); color: var(--accent);
      display: flex; align-items: center; justify-content: center;
      box-shadow: var(--shadow-lift);
      opacity: 0; pointer-events: none; transform: translateY(8px);
      transition: opacity .25s ease, transform .25s ease, background .2s;
    }
    .back-top.show { opacity: 1; pointer-events: auto; transform: none; }
    .back-top:hover { background: var(--accent); color: var(--accent-contrast); }

    .site-nav .nav-kids { align-self: center; margin: 0 4px; padding: 8px 16px; border-radius: 999px; border-bottom: none; opacity: 1; font-weight: 800; color: #4a2b00; background: linear-gradient(135deg, #fbbf24, #fb7185); box-shadow: 0 2px 10px rgba(0,0,0,.22); transition: transform .2s, box-shadow .2s, filter .2s; }
    .site-nav .nav-kids:hover { opacity: 1; filter: brightness(1.07); transform: scale(1.05); box-shadow: 0 4px 14px rgba(0,0,0,.28); background: linear-gradient(135deg, #fcd34d, #fda4af); }

    /* ——— Nav: wrap into pill rows once the single row no longer fits ——— */
    @media (max-width: 1100px) {
      :root { --nav-h: 104px; --anchor-offset: 112px; }
      .site-nav-inner { flex-wrap: wrap; align-items: center; padding: 9px 10px; gap: 8px; }
      .nav-links { flex-wrap: wrap; overflow-x: visible; gap: 6px; }
      .site-nav .nav-link {
        padding: 7px 13px; font-size: 13px; opacity: 1;
        border-bottom: none; border-radius: 999px;
        background: rgba(255,255,255,.13);
      }
      .site-nav .nav-link.active { background: rgba(255,255,255,.95); color: var(--accent-strong); }
      .site-nav .nav-kids { margin: 0; }
      .nav-actions { padding: 0; margin-inline-start: auto; }
    }

    /* ——— Compact single-row mobile nav (≤860px) ———
       Above this width every nav item sits in the bar and these controls are
       inert; below it the bar keeps only the primary items plus a "More" menu
       that holds the rest along with the language and theme controls. */
    .nav-more-btn, .nav-menu { display: none; }

    @media (max-width: 860px) {
      :root { --nav-h: 56px; --anchor-offset: 64px; }

      .site-nav-inner {
        flex-wrap: nowrap; align-items: center;
        gap: 4px; padding: 0 8px; min-height: var(--nav-h);
      }
      .nav-links { flex-wrap: nowrap; overflow-x: auto; gap: 2px; align-items: center; }
      /* Everything that is not primary is reachable through the More menu instead. */
      .site-nav .nav-links > :not(.nav-pri) { display: none; }
      .site-nav .nav-link.nav-pri {
        display: inline-flex; align-items: center;
        min-height: 44px; padding: 0 11px;
        font-size: 13px; border-radius: 10px;
        background: transparent; border-bottom: none;
      }
      .site-nav .nav-link.nav-pri.active { background: rgba(255,255,255,.95); color: var(--accent-strong); }

      .nav-actions { padding: 0; margin-inline-start: auto; gap: 0; }
      .nav-actions .theme-toggle, .nav-actions .lang-switch { display: none; }

      .nav-more-btn {
        display: inline-flex; align-items: center; gap: 5px;
        min-height: 44px; padding: 0 12px;
        border: 1px solid rgba(255,255,255,.28); border-radius: 10px;
        background: rgba(255,255,255,.14); color: var(--accent-contrast);
        font-weight: 700; font-size: 13px; white-space: nowrap;
        transition: background .2s;
      }
      .nav-more-btn:hover { background: rgba(255,255,255,.26); }
      .nav-more-btn .chev { transition: transform .2s ease; }
      .nav-more-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }

      .nav-menu {
        display: block;
        position: absolute; top: 100%; inset-inline: 0; z-index: 45;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow-lift);
        max-height: 0; overflow: hidden;
        /* visibility keeps the collapsed links out of the tab order, which
           max-height alone would not do. */
        visibility: hidden;
        transition: max-height .25s ease, visibility .25s ease;
      }
      .nav-menu.open { max-height: 75vh; overflow-y: auto; visibility: visible; }
      .nav-menu-inner { padding: 8px 8px 12px; }
      .site-nav .nav-menu a.nav-link {
        display: flex; align-items: center;
        min-height: 48px; padding: 0 14px;
        color: var(--text); font-size: 15px; font-weight: 600;
        background: transparent; border-bottom: none; border-radius: 10px; opacity: 1;
      }
      .site-nav .nav-menu a.nav-link:hover { background: var(--surface2); }
      .site-nav .nav-menu a.nav-link.active { background: var(--accent-soft); color: var(--accent-strong); }
      .site-nav .nav-menu a.nav-kids {
        margin: 6px 0 0; padding: 0 14px; border-radius: 10px;
        color: #4a2b00; background: linear-gradient(135deg, #fbbf24, #fb7185);
      }

      .nav-menu-foot {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--border);
      }
      .nav-menu-langs { display: flex; gap: 6px; flex: 1 1 auto; flex-wrap: wrap; }
      .nav-menu-langs a {
        display: inline-flex; align-items: center;
        min-height: 44px; padding: 0 14px; border-radius: 10px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--text); font-weight: 700; font-size: 14px; text-decoration: none;
      }
      .nav-menu-langs a.on { background: var(--accent); border-color: var(--accent); color: var(--accent-contrast); }
      .site-nav .nav-menu .theme-toggle {
        width: auto; min-height: 44px; gap: 8px; padding: 0 14px;
        border-radius: 10px; border: 1px solid var(--border);
        background: var(--surface2); color: var(--text);
        font-weight: 700; font-size: 14px;
      }
      .site-nav .nav-menu .theme-toggle:hover { background: var(--accent-soft); transform: none; }
    }

    /* ——— Mobile ——— */
    @media (max-width: 860px) {
      .sm-grid { grid-template-columns: 1fr 1fr; }
      .sm-brand { grid-column: 1 / -1; max-width: none; }
    }
    @media (max-width: 700px) {
      .site-header { padding: 12px 14px; }
      .site-header .brand { font-size: 17px; }
      .site-header .logo-icon { width: 40px; height: 40px; font-size: 21px; }
      .layout { padding: 14px 12px 44px; gap: 16px; }
      main { gap: 16px; }
      .section-card { padding: 20px 16px; }
      aside { position: static; max-width: none; min-width: 0; flex: 1 1 100%; }
      .back-top { bottom: 16px; inset-inline-end: 14px; }
    }
    @media (max-width: 520px) {
      .sm-inner { padding: 36px 18px 18px; }
      .sm-grid { grid-template-columns: 1fr; gap: 28px; }
      .sm-bottom { justify-content: flex-start; }
    }
    @media print {
      .site-nav, .back-top, .sm-footer, .occ-banner { display: none !important; }
    }
  </style>
</head>
<body>
  <nav class="site-nav" aria-label={pick(lang, 'التنقل الرئيسي', 'Main navigation', 'مرکزی نیویگیشن')}>
    <div class="site-nav-inner">
      <div class="nav-links">
        {navPrimary.map(it => <a class={`nav-link nav-pri${_isActive(it.h) ? ' active' : ''}`} href={it.h} aria-current={_isActive(it.h) ? 'page' : undefined}>{it.t}</a>)}
        {navSecondary.map(it => <a class={`nav-link${_isActive(it.h) ? ' active' : ''}`} href={it.h} aria-current={_isActive(it.h) ? 'page' : undefined}>{it.t}</a>)}
        <a class="nav-link nav-kids" href="/kids/">🌙 {_lblKids}</a>
      </div>
      <div class="nav-actions">
        <button type="button" class="nav-more-btn" id="nav-more" aria-expanded="false" aria-controls="nav-menu" aria-haspopup="true">
          {_lblMore}
          <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label={_themeLabel} title={_themeLabel}>
          <svg class="ic-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="ic-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <div class="lang-switch" role="group" aria-label={_lblLanguage}>
          <svg class="lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          {langs.map(l => <a href={l.path} class={l.code === lang ? 'on' : ''} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>)}
        </div>
      </div>
    </div>
    <div class="nav-menu" id="nav-menu" aria-label={_lblMoreMenu}>
      <div class="nav-menu-inner">
        {navSecondary.map(it => <a class={`nav-link${_isActive(it.h) ? ' active' : ''}`} href={it.h} aria-current={_isActive(it.h) ? 'page' : undefined}>{it.t}</a>)}
        <a class="nav-link nav-kids" href="/kids/">🌙 {_lblKids}</a>
        <div class="nav-menu-foot">
          <div class="nav-menu-langs" role="group" aria-label={_lblLanguage}>
            {langs.map(l => <a href={l.path} class={l.code === lang ? 'on' : ''} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{_fLangLabel(l.code)}</a>)}
          </div>
          <button type="button" class="theme-toggle" aria-label={_themeLabel} title={_themeLabel}>
            <svg class="ic-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="ic-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </button>
        </div>
      </div>
    </div>
  </nav>
  {_bn && (
    <div class="occ-banner" id="occ-banner">
      <a href={_bn.href} id="occ-bn-link">
        <span aria-hidden="true">🌙</span>
        <strong id="occ-bn-name">{_bn.n} {_bn.gy}</strong>
        <span id="occ-bn-date" style="color:var(--muted)">{_bn.dt}</span>
        <span class="occ-banner-count" id="occ-bn-count">{_bnCount}</span>
      </a>
      <button type="button" class="occ-banner-close" id="occ-bn-close" aria-label={_bnClose} title={_bnClose}>✕</button>
    </div>
  )}
  {_bn && (
    <script is:inline define:vars={{ bnItems: _bnList, bnLang: lang }}>
      (function () {
        var el = document.getElementById('occ-banner');
        if (!el) return;
        try {
          var now = new Date();
          var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()); // local calendar day, matching the homepage countdown
          var item = null;
          for (var i = 0; i < bnItems.length; i++) {
            if (Date.parse(bnItems[i].d + 'T00:00:00Z') >= today) { item = bnItems[i]; break; }
          }
          if (!item || localStorage.getItem('occBannerHide') === item.s + item.gy) { el.style.display = 'none'; return; }
          var days = Math.round((Date.parse(item.d + 'T00:00:00Z') - today) / 86400000);
          document.getElementById('occ-bn-link').setAttribute('href', item.href);
          document.getElementById('occ-bn-name').textContent = item.n + ' ' + item.gy;
          document.getElementById('occ-bn-date').textContent = item.dt;
          document.getElementById('occ-bn-count').textContent =
            days === 0 ? (bnLang === 'ar' ? 'اليوم' : bnLang === 'ur' ? 'آج' : 'Today')
            : (bnLang === 'ar' ? 'باقٍ ' + days + ' يوم' : bnLang === 'ur' ? days + ' دن باقی' : days + (days === 1 ? ' day left' : ' days left'));
          document.getElementById('occ-bn-close').addEventListener('click', function () {
            try { localStorage.setItem('occBannerHide', item.s + item.gy); } catch (e) {}
            el.style.display = 'none';
          });
        } catch (e) {}
      })();
    </script>
  )}
  <slot />
  <footer class="sm-footer" role="contentinfo">
    <div class="sm-inner">
      <div class="sm-grid">
        <div class="sm-brand">
          <a class="sm-logo" href={_navHome}><span class="sm-logo-mark" aria-hidden="true">☾</span><span>{_fBrand}</span></a>
          <p class="sm-tagline">{_fTagline}</p>
          <div class="sm-langs">
            {langs.map(l => <a href={l.path} class={l.code === lang ? 'on' : ''} hreflang={l.code} lang={l.code}>{_fLangLabel(l.code)}</a>)}
          </div>
        </div>

        <nav class="sm-col" aria-label={_colQuick}>
          <h3 class="sm-col-title">{_colQuick}</h3>
          <ul>
            <li><a href={_navHome}>{_labels.home}</a></li>
            <li><a href={_navHome + '#converter'}>{_labels.conv}</a></li>
            <li><a href={_navHome + '#occasions'}>{_labels.occ}</a></li>
            <li><a href={_navOtd}>{_lblOtd}</a></li>
            <li><a href={_navAbout}>{_labels.guide}</a></li>
          </ul>
        </nav>

        <nav class="sm-col" aria-label={_colTools}>
          <h3 class="sm-col-title">{_colTools}</h3>
          <ul>
            <li><a href={_navPrayer}>{_labels.prayer}</a></li>
            <li><a href={_navMosques}>{_lblMosques}</a></li>
            <li><a href={_navQibla}>{_lblQibla}</a></li>
            <li><a href={_navZakat}>{_labels.zakat}</a></li>
            <li><a href={_navAge}>{_lblAge}</a></li>
            <li><a href={_navFasting}>{_labels.fasting}</a></li>
            <li><a href={_navDua}>{_labels.dua}</a></li>
            <li><a href={_navPrint}>{_lblPrint}</a></li>
            <li><a href={_navWidget}>{_lblWidget}</a></li>
          </ul>
        </nav>

        <nav class="sm-col" aria-label={_colOcc}>
          <h3 class="sm-col-title">{_colOcc}</h3>
          <ul>
            {_footOcc.map(o => <li><a href={o.href}>{o.name}</a></li>)}
          </ul>
        </nav>
      </div>

      <div class="sm-bottom">
        <p class="sm-copy">© {_footYear} {_fBrand} · islamicdates.org — {_fRights}</p>
        <nav class="sm-legal" aria-label={pick(lang, 'روابط قانونية', 'Legal', 'قانونی روابط')}>
          <a href={_navPrivacy}>{_lblPrivacy}</a>
          <a href={_navContact}>{_lblContact}</a>
        </nav>
      </div>
    </div>
  </footer>
  <button type="button" class="back-top" id="back-top" aria-label={_topLabel} title={_topLabel}>
    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>
  <script is:inline>
    (function () {
      // Two toggles exist: one in the bar (wide) and one in the More menu (mobile).
      Array.prototype.forEach.call(document.querySelectorAll('.theme-toggle'), function (tog) {
        tog.addEventListener('click', function () {
          var el = document.documentElement;
          var next = el.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          el.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', next === 'dark' ? '#122129' : '#0d9488');
        });
      });

      var moreBtn = document.getElementById('nav-more');
      var navMenu = document.getElementById('nav-menu');
      if (moreBtn && navMenu) {
        var setMenu = function (open) {
          navMenu.classList.toggle('open', open);
          moreBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        moreBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          setMenu(!navMenu.classList.contains('open'));
        });
        // Close on outside click, on Escape, and after following a link.
        document.addEventListener('click', function (e) {
          if (navMenu.classList.contains('open') && !navMenu.contains(e.target)) setMenu(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && navMenu.classList.contains('open')) { setMenu(false); moreBtn.focus(); }
        });
        navMenu.addEventListener('click', function (e) {
          if (e.target.closest && e.target.closest('a')) setMenu(false);
        });
      }
      var bt = document.getElementById('back-top');
      if (bt) {
        var onScroll = function () { bt.classList.toggle('show', window.scrollY > 600); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        bt.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      }
    })();
  </script>
</body>
</html>
