---
import Layout from '../layouts/Layout.astro';
import CityPrayerIsland from './CityPrayerIsland';
import {
  type PtCity, type PtCountry, citiesOfCountry, cityMethod, cityPath, countryPath, ptBase,
} from '../lib/cities';
import { METHODS } from '../lib/prayer';
import { qiblaBearing, qiblaDistanceKm } from '../lib/qibla';
import { type Lang, pick } from '../lib/data';

interface Props { lang: Lang; country: PtCountry; city: PtCity }
const { lang, country, city } = Astro.props;

const cityName    = pick(lang, city.ar, city.en, city.ur);
const countryName = pick(lang, country.ar, country.en, country.ur);
const method      = cityMethod(city);
const methodName  = pick(lang, METHODS[method].ar, METHODS[method].en, METHODS[method].ur);
const bearing     = qiblaBearing(city.lat, city.lng).toFixed(1);
const distKm      = qiblaDistanceKm(city.lat, city.lng);

const canonical = `https://islamicdates.org${cityPath(country.slug, city.slug, lang)}`;
const nearby = citiesOfCountry(country.code).filter(c => c.slug !== city.slug);

const title = pick(lang,
  `مواقيت الصلاة في ${cityName} اليوم · ${countryName} — الفجر والظهر والعصر والمغرب والعشاء`,
  `Prayer Times in ${cityName} Today · ${countryName} — Fajr, Dhuhr, Asr, Maghrib & Isha`,
  `${cityName} میں آج کے اوقاتِ نماز · ${countryName} — فجر، ظہر، عصر، مغرب اور عشاء`);

const description = pick(lang,
  `مواقيت الصلاة اليوم في ${cityName}، ${countryName}: الفجر، الشروق، الظهر، العصر، المغرب، العشاء، مع جدول شهري كامل واتجاه القبلة والعد التنازلي للصلاة القادمة. الحساب وفق ${methodName}.`,
  `Today's prayer times in ${cityName}, ${countryName}: Fajr, Sunrise, Dhuhr, Asr, Maghrib and Isha, with a full monthly timetable, Qibla direction and a live countdown to the next prayer. Calculated per ${methodName}.`,
  `${cityName}، ${countryName} میں آج کے اوقاتِ نماز: فجر، طلوعِ آفتاب، ظہر، عصر، مغرب اور عشاء، مکمل ماہانہ جدول، قبلہ کا رخ اور اگلی نماز کے لیے الٹی گنتی کے ساتھ۔ حساب ${methodName} کے مطابق۔`);

const faq = [
  {
    q: pick(lang, `كيف تُحسب مواقيت الصلاة في ${cityName}؟`, `How are prayer times in ${cityName} calculated?`, `${cityName} میں اوقاتِ نماز کیسے نکالے جاتے ہیں؟`),
    a: pick(lang,
      `تُحسب المواقيت فلكياً اعتماداً على إحداثيات ${cityName} (${city.lat.toFixed(2)}°، ${city.lng.toFixed(2)}°) وزاوية الشمس، وفق طريقة ${methodName} المعتمدة في ${countryName}. يمكنك تغيير طريقة الحساب من الإعدادات.`,
      `Times are calculated astronomically from the coordinates of ${cityName} (${city.lat.toFixed(2)}°, ${city.lng.toFixed(2)}°) and the sun's angle, using the ${methodName} method commonly used in ${countryName}. You can change the method in the settings.`,
      `اوقات ${cityName} کے محلِ وقوع (${city.lat.toFixed(2)}°، ${city.lng.toFixed(2)}°) اور سورج کے زاویے کی بنیاد پر ${methodName} کے مطابق نکالے جاتے ہیں جو ${countryName} میں رائج ہے۔ ترتیبات سے طریقہ بدلا جا سکتا ہے۔`),
  },
  {
    q: pick(lang, `ما اتجاه القبلة في ${cityName}؟`, `What is the Qibla direction in ${cityName}?`, `${cityName} میں قبلہ کا رخ کیا ہے؟`),
    a: pick(lang,
      `اتجاه القبلة من ${cityName} هو ${bearing}° من الشمال الحقيقي باتجاه عقارب الساعة، والمسافة إلى الكعبة المشرفة نحو ${distKm} كم.`,
      `The Qibla from ${cityName} is ${bearing}° clockwise from true north; the distance to the Kaaba is about ${distKm} km.`,
      `${cityName} سے قبلہ حقیقی شمال سے ${bearing}° (گھڑی وار) ہے، اور کعبہ شریف تقریباً ${distKm} کلومیٹر دور ہے۔`),
  },
  {
    q: pick(lang, 'هل المواقيت دقيقة تماماً؟', 'Are the times exactly accurate?', 'کیا اوقات بالکل درست ہیں؟'),
    a: pick(lang,
      'المواقيت محسوبة بدقة فلكية عالية لكنها قد تختلف بدقائق قليلة عن الجداول الرسمية بسبب الارتفاع والانكسار الجوي وطريقة التقريب. يُنصح بمراجعة الإعلان الرسمي المحلي.',
      'Times are astronomically precise but may differ by a few minutes from official timetables due to altitude, atmospheric refraction and rounding. Check your local official announcement for precision.',
      'اوقات فلکی اعتبار سے درست ہیں لیکن بلندی، انکسارِ نور اور تقریب کی وجہ سے سرکاری جدولوں سے چند منٹ مختلف ہو سکتے ہیں۔ احتیاطاً مقامی سرکاری اعلان دیکھیں۔'),
  },
];

const homeHref = pick(lang, '/', '/en/', '/ur/');
const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': pick(lang, 'الرئيسية', 'Home', 'ہوم'), 'item': `https://islamicdates.org${homeHref}` },
    { '@type': 'ListItem', 'position': 2, 'name': pick(lang, 'مواقيت الصلاة', 'Prayer Times', 'اوقاتِ نماز'), 'item': `https://islamicdates.org${ptBase(lang)}` },
    { '@type': 'ListItem', 'position': 3, 'name': countryName, 'item': `https://islamicdates.org${countryPath(country.slug, lang)}` },
    { '@type': 'ListItem', 'position': 4, 'name': cityName, 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })) },
]);

const t = {
  brand:    pick(lang, 'التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر'),
  tagline:  pick(lang, 'مواقيت الصلاة', 'Prayer Times', 'اوقاتِ نماز'),
  home:     pick(lang, 'الرئيسية', 'Home', 'ہوم'),
  homeAria: pick(lang, 'الانتقال إلى الصفحة الرئيسية', 'Go to homepage', 'ہوم پیج پر جائیں'),
  h1:       pick(lang, `مواقيت الصلاة في ${cityName} اليوم`, `Prayer Times in ${cityName} Today`, `${cityName} میں آج کے اوقاتِ نماز`),
  intro:    pick(lang,
    `مواقيت الصلاة الخمس ووقت الشروق في ${cityName}، ${countryName}، مع عدّ تنازلي للصلاة القادمة، وجدول شهري كامل، واتجاه القبلة. الحساب الافتراضي وفق ${methodName} ويمكن تغييره.`,
    `The five daily prayers and sunrise time in ${cityName}, ${countryName}, with a live countdown to the next prayer, a full monthly timetable and the Qibla direction. Default method: ${methodName} (changeable).`,
    `${cityName}، ${countryName} میں پانچ نمازوں اور طلوعِ آفتاب کے اوقات، اگلی نماز کی الٹی گنتی، مکمل ماہانہ جدول اور قبلہ کے رخ کے ساتھ۔ طے شدہ طریقہ: ${methodName} (قابلِ تبدیلی)۔`),
  nearby:   pick(lang, `مدن أخرى في ${countryName}`, `Other cities in ${countryName}`, `${countryName} کے دوسرے شہر`),
  allCities: pick(lang, `كل مدن ${countryName} ←`, `All cities in ${countryName} →`, `${countryName} کے تمام شہر ←`),
  faqTitle: pick(lang, 'أسئلة شائعة', 'FAQ', 'عام سوالات'),
  tools:    pick(lang, 'أدوات ذات صلة', 'Related tools', 'متعلقہ اوزار'),
  mainTool: pick(lang, 'مواقيت الصلاة حسب موقعك', 'Prayer times for your location', 'آپ کے مقام کے اوقاتِ نماز'),
  fullCal:  pick(lang, 'التقويم الهجري الكامل وتاريخ اليوم', "Full Hijri calendar & today's date", 'مکمل ہجری کیلنڈر اور آج کی تاریخ'),
  footer:   pick(lang, 'المواقيت محسوبة فلكياً · للأغراض التقريبية', 'Astronomically calculated · for reference', 'اوقات فلکی حساب سے · تقریبی مقاصد کے لیے'),
  privacy:  pick(lang, 'سياسة الخصوصية', 'Privacy Policy', 'رازداری پالیسی'),
};
---
<Layout title={title} description={description} canonical={canonical} lang={lang} jsonLd={jsonLd}
  arPath={cityPath(country.slug, city.slug, 'ar')} enPath={cityPath(country.slug, city.slug, 'en')} urPath={cityPath(country.slug, city.slug, 'ur')}>
  <header class="site-header">
    <div class="header-start">
      <a href={homeHref} class="logo" aria-label={t.homeAria}>
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">{t.brand}</div>
          <div class="tagline">{t.tagline}</div>
        </div>
      </a>
      <a href={homeHref} class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>{t.home}</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <nav aria-label="breadcrumb" style="font-size:13px;color:var(--muted);margin-bottom:12px;display:flex;flex-wrap:wrap;gap:6px;align-items:center">
        <a href={ptBase(lang)} style="color:var(--accent);text-decoration:none">{t.tagline}</a>
        <span aria-hidden="true">›</span>
        <a href={countryPath(country.slug, lang)} style="color:var(--accent);text-decoration:none">{countryName}</a>
        <span aria-hidden="true">›</span>
        <span>{cityName}</span>
      </nav>

      <section class="card section-card">
        <h1 class="section-h2" style="font-size:24px">{t.h1}</h1>
        <p class="section-p" style="margin-top:8px">{t.intro}</p>
      </section>

      <CityPrayerIsland lang={lang}
        city={{ ar: city.ar, en: city.en, ur: city.ur }}
        country={{ ar: country.ar, en: country.en, ur: country.ur }}
        lat={city.lat} lng={city.lng} zone={city.zone} method={method}
        client:load />

      {nearby.length > 0 && (
        <section class="card section-card">
          <h2 class="section-h2">{t.nearby}</h2>
          <div style="display:flex;flex-wrap:wrap;gap:9px;margin-top:12px">
            {nearby.map(c => (
              <a href={cityPath(country.slug, c.slug, lang)}
                style="padding:8px 14px;border-radius:999px;border:1px solid var(--border);background:var(--surface2);color:var(--text);text-decoration:none;font-size:13.5px;font-weight:600">
                {pick(lang, c.ar, c.en, c.ur)}
              </a>
            ))}
          </div>
          <div style="margin-top:14px">
            <a href={countryPath(country.slug, lang)} style="color:var(--accent);text-decoration:none;font-size:14px;font-weight:700">{t.allCities}</a>
          </div>
        </section>
      )}

      <section class="card section-card">
        <h2 class="section-h2">{t.faqTitle}</h2>
        {faq.map((f, i) => (
          <div class="faq-item" style={i === faq.length - 1 ? 'border-bottom:none' : ''}>
            <p class="faq-q">{f.q}</p>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">{t.tools}</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href={ptBase(lang)} style="color:var(--accent);text-decoration:none">{t.mainTool}</a>
          <a href={homeHref} style="color:var(--accent);text-decoration:none">{t.fullCal}</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    {t.footer}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href={pick(lang, '/privacy/', '/en/privacy/', '/ur/privacy/')} style="color:var(--muted);text-decoration:none;font-size:13px">{t.privacy}</a>
  </footer>
</Layout>
