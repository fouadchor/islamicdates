---
// Homepage prayer-times city block.
// Purpose: give the city prayer-times pages (328 cities x 3 languages) a direct
// internal link from the site's strongest page. Before this they were only
// reachable via /prayer-times/, leaving them several clicks deep.
import { PT_CITIES, PT_COUNTRIES, cityPath, ptBase, type PtLang } from '../lib/cities';
import { pick, type Lang } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = lang as PtLang;

// Curated by search demand across the site's main markets. Each entry is a
// [countryCode, citySlug] pair resolved against PT_CITIES, so a bad slug drops
// the card at build time rather than shipping a broken link.
const PICKS: [string, string][] = [
  ['sa', 'makkah'], ['sa', 'madinah'], ['sa', 'riyadh'], ['sa', 'jeddah'],
  ['eg', 'cairo'], ['eg', 'alexandria'],
  ['ae', 'dubai'], ['ae', 'abu-dhabi'],
  ['kw', 'kuwait-city'], ['qa', 'doha'], ['bh', 'manama'], ['om', 'muscat'],
  ['jo', 'amman'], ['ps', 'jerusalem'], ['lb', 'beirut'], ['sy', 'damascus'],
  ['iq', 'baghdad'], ['ye', 'sanaa'], ['tr', 'istanbul'],
  ['pk', 'karachi'], ['pk', 'lahore'], ['in', 'delhi'], ['in', 'mumbai'],
  ['bd', 'dhaka'], ['id', 'jakarta'], ['my', 'kuala-lumpur'],
  ['ma', 'casablanca'], ['dz', 'algiers'], ['tn', 'tunis'], ['sd', 'khartoum'],
  ['gb', 'london'], ['us', 'new-york'], ['fr', 'paris'], ['ca', 'toronto'],
];

const cities = PICKS.map(([cc, slug]) => {
  const country = PT_COUNTRIES.find(c => c.code === cc);
  const city = PT_CITIES.find(c => c.cc === cc && c.slug === slug);
  if (!country || !city) return null;
  return { slug, name: city[l], country: country[l], href: cityPath(country.slug, city.slug, l) };
}).filter((c): c is NonNullable<typeof c> => c !== null);

// Twelve shown, the rest folded into a <details>: every link stays in the DOM
// (crawlable), but the block costs a third of the height it did as 34 cards.
// Which twelve depends on who reads each language.
const FIRST: Record<PtLang, string[]> = {
  ar: ['makkah', 'madinah', 'riyadh', 'jeddah', 'cairo', 'dubai', 'kuwait-city', 'doha', 'amman', 'baghdad', 'casablanca', 'algiers'],
  en: ['london', 'new-york', 'toronto', 'paris', 'dubai', 'makkah', 'madinah', 'istanbul', 'kuala-lumpur', 'jakarta', 'karachi', 'cairo'],
  ur: ['karachi', 'lahore', 'delhi', 'mumbai', 'dhaka', 'makkah', 'madinah', 'riyadh', 'jeddah', 'dubai', 'doha', 'london'],
};
const first = FIRST[l].map(s => cities.find(c => c.slug === s)).filter((c): c is NonNullable<typeof c> => !!c);
const more = cities.filter(c => !first.includes(c));

const T = {
  h2: pick(lang, 'مواقيت الصلاة حسب المدينة', 'Prayer Times by City', 'شہر کے اعتبار سے مواقیتِ نماز'),
  p: pick(lang,
    'أوقات الفجر والظهر والعصر والمغرب والعشاء محسوبة فلكياً لكل مدينة، مع اتجاه القبلة والمساجد القريبة.',
    'Fajr, Dhuhr, Asr, Maghrib and Isha times calculated astronomically for each city, with Qibla direction and nearby mosques.',
    'ہر شہر کے لیے فجر، ظہر، عصر، مغرب اور عشاء کے اوقات فلکی حساب سے، قبلہ کے رخ اور قریبی مساجد کے ساتھ۔'),
  all: pick(lang, 'كل المدن والدول', 'All cities & countries', 'تمام شہر اور ممالک'),
  more: (n: number) => pick(lang, `مدن أخرى (${n})`, `More cities (${n})`, `مزید شہر (${n})`),
};
---

<section class="card section-card" style="order:5">
  <h2 class="section-h2">{T.h2}</h2>
  <p class="section-p" style="margin-bottom:2px">{T.p}</p>
  <div class="occ-chips">
    {first.map(c => (
      <a href={c.href} class="occ-chip"><span class="oc-n">{c.name}</span><span class="oc-d">{c.country}</span></a>
    ))}
  </div>
  {more.length > 0 && (
    <details class="fold">
      <summary>{T.more(more.length)}</summary>
      <div class="occ-chips">
        {more.map(c => (
          <a href={c.href} class="occ-chip"><span class="oc-n">{c.name}</span><span class="oc-d">{c.country}</span></a>
        ))}
      </div>
    </details>
  )}
  <a href={ptBase(l)} class="city-all">{T.all} {l === 'en' ? '→' : '←'}</a>
</section>

<style>
  .city-all { display: inline-block; margin-top: 14px; font-size: 13.5px; font-weight: 700; color: var(--accent); text-decoration: none; }
  .city-all:hover { text-decoration: underline; }
</style>
