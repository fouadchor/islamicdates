---
// Searchable directory of prayer-time pages: search island + crawlable country grid.
import PrayerSearchIsland from './PrayerSearchIsland';
import { PT_COUNTRIES, PT_CITIES, citiesOfCountry, countryPath, cityPath } from '../lib/cities';
import { type Lang, pick } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;

const t = {
  title:    pick(lang, 'مواقيت الصلاة حسب المدينة والدولة', 'Prayer times by city and country', 'شہر اور ملک کے لحاظ سے اوقاتِ نماز'),
  sub:      pick(lang,
    'ابحث عن مدينتك أو تصفّح حسب الدولة: لكل مدينة صفحة كاملة فيها مواقيت اليوم، جدول شهري، واتجاه القبلة.',
    'Search for your city or browse by country — every city has a full page with today’s times, a monthly timetable and the Qibla direction.',
    'اپنا شہر تلاش کریں یا ملک کے لحاظ سے دیکھیں — ہر شہر کا مکمل صفحہ ہے جس میں آج کے اوقات، ماہانہ جدول اور قبلہ کا رخ شامل ہے۔'),
  browse:   pick(lang, 'تصفّح حسب الدولة', 'Browse by country', 'ملک کے لحاظ سے دیکھیں'),
  popular:  pick(lang, 'مدن شائعة', 'Popular cities', 'مقبول شہر'),
  cities:   (n: number) => pick(lang, `${n} مدن`, `${n} cities`, `${n} شہر`),
};

const POPULAR: [string, string][] = [
  ['saudi-arabia', 'makkah'], ['saudi-arabia', 'madinah'], ['saudi-arabia', 'riyadh'],
  ['egypt', 'cairo'], ['united-arab-emirates', 'dubai'], ['turkey', 'istanbul'],
  ['pakistan', 'karachi'], ['pakistan', 'lahore'], ['indonesia', 'jakarta'],
  ['united-kingdom', 'london'], ['united-states', 'new-york'], ['morocco', 'casablanca'],
];
const popularCities = POPULAR.map(([co, ci]) => {
  const country = PT_COUNTRIES.find(c => c.slug === co)!;
  const city = PT_CITIES.find(c => c.cc === country.code && c.slug === ci)!;
  return { country, city };
});
---
<section class="card section-card" style="order:2">
  <h2 class="section-h2">{t.title}</h2>
  <p class="section-p" style="margin-top:6px">{t.sub}</p>

  <div style="margin-top:14px">
    <PrayerSearchIsland lang={lang} client:visible />
  </div>

  <h3 style="margin:20px 0 0;font-size:14px;font-weight:700;color:var(--muted);letter-spacing:.05em;text-transform:uppercase">{t.popular}</h3>
  <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:10px">
    {popularCities.map(({ country, city }) => (
      <a href={cityPath(country.slug, city.slug, lang)}
        style="padding:7px 13px;border-radius:999px;border:1px solid var(--border);background:var(--surface2);color:var(--text);text-decoration:none;font-size:13.5px;font-weight:600">
        {pick(lang, city.ar, city.en, city.ur)}
      </a>
    ))}
  </div>

  <h3 style="margin:20px 0 0;font-size:14px;font-weight:700;color:var(--muted);letter-spacing:.05em;text-transform:uppercase">{t.browse}</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:9px;margin-top:10px">
    {PT_COUNTRIES.map(c => {
      const n = citiesOfCountry(c.code).length;
      return (
        <a href={countryPath(c.slug, lang)}
          style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:11px 13px;border-radius:11px;border:1px solid var(--border);background:var(--surface2);color:var(--text);text-decoration:none;font-size:14px;font-weight:600">
          <span>{pick(lang, c.ar, c.en, c.ur)}</span>
          <span style="font-size:11.5px;color:var(--muted);font-weight:600;white-space:nowrap">{t.cities(n)}</span>
        </a>
      );
    })}
  </div>
</section>
