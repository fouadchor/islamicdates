---
// بلاطة الختمة الجماعية داخل شبكة أدوات الصفحة الرئيسية.
import type { Lang } from '../lib/data';
import { khatmaT } from '../lib/khatma-i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = khatmaT(lang);
---
<a href={t.base} class="tool-tile is-primary" data-ga="khatma_tool_tile">
  <span class="tt-i"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v17H6a2 2 0 0 0-2 2Z"/><path d="M9 7h6"/><path d="M9 11h6"/></svg></span>
  <span class="tt-n">{t.toolLabel}<span class="tt-sub">{t.toolSub}</span></span>
</a>
