---
// Sidebar extras: live prayer-times mini and a daily supplication.
// Shared across the ar / en / ur home pages. The upcoming-occasions card that
// used to live here was removed: <main> already renders UpcomingIsland from the
// same MAJOR_OCC_KEYS source, so the two lists were identical on one screen.
import PrayerMiniIsland from './PrayerMiniIsland';
import { type Lang, pick } from '../lib/data';
import { DUA_SECTIONS, srcLabel } from '../lib/duas';

interface Props { lang: Lang }
const { lang } = Astro.props;

const _duaList = DUA_SECTIONS.flatMap(s => s.items)
  .filter(d => d.ar.length <= 140)
  .map(d => ({ ar: d.ar, when: d.when ? pick(lang, d.when.ar, d.when.en, d.when.ur) : '', src: srcLabel(d.src, lang) }));

const _duaHref = pick(lang, '/dua/', '/en/dua/', '/ur/dua/');
const T = {
  duaTitle: pick(lang, 'دعاء اليوم', 'Duʿaʾ of the day', 'آج کی دعا'),
  duaMore: pick(lang, 'المزيد من الأدعية', 'More supplications', 'مزید دعائیں'),
};
---

<PrayerMiniIsland lang={lang} client:visible />


<div class="card" style="padding:18px 20px;background:var(--gold-soft);border-color:var(--gold-soft)">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
    <span aria-hidden="true" style="font-size:18px;line-height:1;color:var(--gold-deep)">☾</span>
    <h3 style="margin:0;font-size:15.5px;font-weight:700;color:var(--gold-deep)">{T.duaTitle}</h3>
  </div>
  <p id="sb-dua-when" style="margin:0 0 6px;font-size:12.5px;color:var(--gold-deep);font-weight:700"></p>
  <p id="sb-dua-text" dir="rtl" style="margin:0;font-size:16px;line-height:2.05;font-weight:700;color:var(--text);text-align:right;font-family:'Noto Naskh Arabic','IBM Plex Sans Arabic',serif">{_duaList[0] ? _duaList[0].ar : ''}</p>
  <p id="sb-dua-src" style="margin:10px 0 0;font-size:12px;color:var(--muted)"></p>
  <a href={_duaHref} style="display:inline-block;margin-top:12px;font-size:13px;color:var(--accent);font-weight:700;text-decoration:none">{T.duaMore} ←</a>
</div>

<script define:vars={{ duaList: _duaList }}>
  (function () {
    if (duaList && duaList.length) {
      var d = new Date();
      var start = Date.UTC(d.getFullYear(), 0, 0);
      var day = Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - start) / 86400000);
      var idx = ((day % duaList.length) + duaList.length) % duaList.length;
      var it = duaList[idx];
      var w = document.getElementById('sb-dua-when');
      var tx = document.getElementById('sb-dua-text');
      var s = document.getElementById('sb-dua-src');
      if (w) w.textContent = it.when || '';
      if (tx) tx.textContent = it.ar;
      if (s) s.textContent = it.src || '';
    }
  })();
</script>
