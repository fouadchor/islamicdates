---
import Layout from '../layouts/Layout.astro';
import {
  convBasePath, fmtHijri, fmtGregorian, fmtGregorianShort, isoDate, monthName,
  convYears, validDaysInMonth, convIsIndexable,
} from '../lib/convert';
import { monthBasePath } from '../lib/months';
import { h2g } from '../lib/hijri';
import { type Lang, pick, hijriEra, wdArr, gMonArr, MONTHS_NOTES_AR, MONTHS_NOTES_EN, MONTHS_NOTES_UR } from '../lib/data';
import { OCCASIONS, occBasePath, G_YEAR_START, G_YEAR_END } from '../lib/occasions';
import { eventsOn } from '../lib/onthisday';
import { otdContent, otdPathL } from '../lib/onthisday.i18n';

interface Props { lang: Lang; hy: number; hm: number; hd: number; }
const { lang, hy, hm, hd } = Astro.props;

const gDate       = h2g(hy, hm, hd);
const allDaysOfMonth = validDaysInMonth(hy, hm);
const hijriLabel  = fmtHijri(hy, hm, hd, lang);
const gregFmt     = fmtGregorian(gDate, lang);
const gregShort   = fmtGregorianShort(gDate, lang);
const monName     = monthName(hm, lang);
const monthHref   = monthBasePath(hy, hm, lang);
const era         = hijriEra(lang);

const canonical = `https://islamicdates.org${convBasePath(hy, hm, hd, lang)}`;

// Thin long-tail dates stay live and linked but out of the index — see convert.ts.
const indexable = convIsIndexable(hy, hm, hd);

// ---- Per-date context ---------------------------------------------------------
// Without this every converter page was the same ~100-word template with only the
// numbers swapped, which is why Google declined to index most of them. Each page
// now carries facts that are true only of this specific Hijri date.
const weekday   = wdArr(lang)[gDate.getUTCDay()];
const gMonth    = gMonArr(lang)[gDate.getUTCMonth()];
const monthNote = pick(lang, MONTHS_NOTES_AR, MONTHS_NOTES_EN, MONTHS_NOTES_UR)[hm - 1];

// A named Islamic occasion falling exactly on this Hijri day, if any.
//
// The occasion pages only exist for G_YEAR_START..G_YEAR_END, while the converter
// covers Hijri years whose dates fall outside that window at both ends — 1445 lands
// in 2023, 1457 in 2036. Linking blind produced 404s (e.g. /ashura-2023/), so the
// link is only offered when the target year was actually generated; the occasion
// itself still gets its name and description either way.
const occDef = OCCASIONS.find(o => o.hm === hm && o.hd === hd);
const occGYear = gDate.getUTCFullYear();
const occLinkable = occGYear >= G_YEAR_START && occGYear <= G_YEAR_END;
const occInfo = occDef ? {
  name: occDef[lang].name,
  what: occDef[lang].what.split('.')[0].trim() + '.',
  href: occLinkable ? occBasePath(occDef.slug, occGYear, lang) : null,
} : null;

// A historical event recorded on this Hijri day (exact matches only — the
// nearest-in-month fallback would repeat across many pages and defeat the point).
const otdEv = eventsOn(hm, hd)[0] ?? null;
const otdInfo = otdEv ? { ...otdContent(otdEv, lang), href: otdPathL(otdEv.slug, lang) } : null;

// Observance notes. Most dates carry no named occasion and no recorded event, so
// these keep even the quietest page saying something true about that exact day.
const dow = gDate.getUTCDay();
const monthLen = allDaysOfMonth.length;
const third = hd <= 10 ? 0 : hd <= 20 ? 1 : 2;
const dayNotes: string[] = [];

if (hd === 13 || hd === 14 || hd === 15) dayNotes.push(pick(lang,
  'من الأيام البيض (13 و14 و15 من كل شهر هجري)، ويُستحب صيامها.',
  'One of the White Days (13th, 14th and 15th of each Hijri month), which are recommended for fasting.',
  'ایامِ بیض میں سے ہے (ہر ہجری مہینے کی 13، 14 اور 15)، اِن کا روزہ مستحب ہے۔'));

if (dow === 1 || dow === 4) dayNotes.push(pick(lang,
  `يوافق ${weekday}، وهو من أيام صيام التطوّع التي كان النبي ﷺ يتحرّاها.`,
  `Falls on ${weekday}, one of the days the Prophet ﷺ regularly kept a voluntary fast.`,
  `${weekday} کو آتا ہے، جو نفلی روزے کے اُن دنوں میں سے ہے جن کا نبی ﷺ اہتمام فرماتے تھے۔`));

if (dow === 5) dayNotes.push(pick(lang,
  'يوافق يوم الجمعة، وفيه صلاة الجمعة وساعة الإجابة.',
  'Falls on Friday, the day of the Jumuʿah prayer and the hour of answered supplication.',
  'جمعہ کے دن آتا ہے، جس میں نمازِ جمعہ اور قبولیتِ دعا کی گھڑی ہے۔'));

if (hm === 1 || hm === 7 || hm === 11 || hm === 12) dayNotes.push(pick(lang,
  `${monName} من الأشهر الحُرم الأربعة التي عظّم الله حرمتها.`,
  `${monName} is one of the four sacred months whose sanctity God magnified.`,
  `${monName} اُن چار حرمت والے مہینوں میں سے ہے جن کی حرمت اللہ نے بڑھائی۔`));

if (hm === 9 && hd >= 21) dayNotes.push(pick(lang,
  'ضمن العشر الأواخر من رمضان، وفيها تُلتمس ليلة القدر.',
  'Within the last ten nights of Ramadan, when Laylat al-Qadr is sought.',
  'رمضان کے آخری عشرے میں ہے، جس میں شبِ قدر تلاش کی جاتی ہے۔'));

dayNotes.push(pick(lang,
  `اليوم ${hd} من أصل ${monthLen} يوماً في ${monName} ${hy} هـ، أي في ${['الثلث الأول','الثلث الثاني','الثلث الأخير'][third]} من الشهر.`,
  `Day ${hd} of ${monthLen} in ${monName} ${hy} AH — the ${['first','second','final'][third]} third of the month.`,
  `${monName} ${hy} ھ کے ${monthLen} دنوں میں سے ${hd}واں دن، یعنی مہینے کا ${['پہلا','دوسرا','آخری'][third]} تہائی حصہ۔`));

// Cross-year comparison: same Hijri day across all generated years
const crossYears = convYears()
  .map(y => {
    try {
      const days = validDaysInMonth(y, hm);
      if (!days.includes(hd)) return null;
      const gd = h2g(y, hm, hd);
      return { hy: y, gDate: gd, href: convBasePath(y, hm, hd, lang), current: y === hy };
    } catch { return null; }
  })
  .filter(Boolean) as { hy: number; gDate: Date; href: string; current: boolean }[];

// Adjacent days in the same month
const allDays = allDaysOfMonth;
const idx     = allDays.indexOf(hd);
const prevDay = idx > 0                  ? allDays[idx - 1] : null;
const nextDay = idx < allDays.length - 1 ? allDays[idx + 1] : null;

const title = pick(lang,
  `تحويل ${hd} ${monName} ${hy} هـ إلى الميلادي — ${gregShort} | التقويم الهجري`,
  `Convert ${hd} ${monName} ${hy} AH to Gregorian — ${gregShort} | Hijri Calendar`,
  `${hd} ${monName} ${hy} ھ کو عیسوی میں بدلیں — ${gregShort} | ہجری کیلنڈر`);

const description = pick(lang,
  `${hd} ${monName} ${hy} هـ يوافق ${gregFmt} ميلادياً. تحويل فوري بين التقويم الهجري والميلادي وفق تقويم أم القرى.`,
  `${hd} ${monName} ${hy} AH corresponds to ${gregFmt}. Instant conversion between the Hijri and Gregorian calendars per the Umm al-Qura standard.`,
  `${hd} ${monName} ${hy} ھ عیسوی ${gregFmt} کے مطابق ہے۔ اُمّ القریٰ معیار کے مطابق ہجری اور عیسوی کے درمیان فوری تبدیلی۔`);

const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1,
      "name": pick(lang, "الرئيسية", "Home", "ہوم"),
      "item": pick(lang, "https://islamicdates.org/", "https://islamicdates.org/en/", "https://islamicdates.org/ur/") },
    { "@type": "ListItem", "position": 2,
      "name": hijriLabel,
      "item": canonical },
  ],
};

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": pick(lang, `ما هو ${hijriLabel} بالميلادي؟`, `What is ${hijriLabel} in Gregorian?`, `${hijriLabel} عیسوی میں کیا ہے؟`),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": pick(lang,
        `${hijriLabel} يوافق ${gregFmt} في التقويم الميلادي وفق تقويم أم القرى.`,
        `${hijriLabel} corresponds to ${gregFmt} in the Gregorian calendar, per the Umm al-Qura standard.`,
        `${hijriLabel} اُمّ القریٰ معیار کے مطابق عیسوی تقویم میں ${gregFmt} کے مطابق ہے۔`)
    }
  }]
};

const jsonLd = JSON.stringify([breadcrumb, faqSchema]);

const homeHref = pick(lang, '/', '/en/', '/ur/');
const privacyHref = pick(lang, '/privacy/', '/en/privacy/', '/ur/privacy/');

const t = {
  h1:          pick(lang, `تحويل ${hd} ${monName} ${hy} هـ إلى الميلادي`, `Convert ${hd} ${monName} ${hy} AH to Gregorian`, `${hd} ${monName} ${hy} ھ کو عیسوی میں بدلیں`),
  answerLabel: pick(lang, 'التاريخ الميلادي الموافق', 'Gregorian equivalent', 'عیسوی مطابقت'),
  hijriLbl:    pick(lang, 'التاريخ الهجري', 'Hijri date', 'ہجری تاریخ'),
  monthLink:   pick(lang, `عرض تقويم ${monName} ${hy} هـ كاملاً`, `View full ${monName} ${hy} AH calendar`, `${monName} ${hy} ھ کا مکمل کیلنڈر دیکھیں`),
  crossTitle:  pick(lang, `${hd} ${monName} عبر السنوات`, `${hd} ${monName} across years`, `${hd} ${monName} مختلف سالوں میں`),
  th_hy:       pick(lang, 'السنة الهجرية', 'Hijri year', 'ہجری سال'),
  th_greg:     pick(lang, 'التاريخ الميلادي', 'Gregorian date', 'عیسوی تاریخ'),
  prevLbl:     pick(lang, 'اليوم السابق', 'Previous day', 'پچھلا دن'),
  nextLbl:     pick(lang, 'اليوم التالي', 'Next day', 'اگلا دن'),
  toolsTitle:  pick(lang, 'أدوات ذات صلة', 'Related tools', 'متعلقہ اوزار'),
  fullCal:     pick(lang, 'التقويم الهجري الكامل وتاريخ اليوم', "Full Hijri calendar & today's date", 'مکمل ہجری کیلنڈر اور آج کی تاریخ'),
  converter:   pick(lang, 'محوّل التاريخ الهجري والميلادي', 'Hijri–Gregorian date converter', 'ہجری–عیسوی تاریخ کنورٹر'),
  howTitle:    pick(lang, 'كيف تُحسب هذه التواريخ؟', 'How are these dates calculated?', 'یہ تاریخیں کیسے نکالی جاتی ہیں؟'),
  howBody:     pick(lang,
    'تُحسب التواريخ هنا فلكياً وفق معايير تقويم أم القرى المعتمد في المملكة العربية السعودية. قد تختلف بعض الدول التي تعتمد رؤية الهلال المباشرة بيوم واحد.',
    'Dates are calculated astronomically per the Umm al-Qura standard used in Saudi Arabia. Countries relying on direct moon sighting may differ by about one day.',
    'یہاں تاریخوں کا حساب سعودی عرب میں رائج اُمّ القریٰ معیار کے مطابق فلکی طور پر کیا جاتا ہے۔ براہِ راست رؤیتِ ہلال پر انحصار کرنے والے بعض ممالک میں تقریباً ایک دن کا فرق ہو سکتا ہے۔'),
  ctxTitle:    pick(lang, `ماذا يميّز ${hd} ${monName}؟`, `What marks ${hd} ${monName}?`, `${hd} ${monName} کی خصوصیت`),
  ctxWeekday:  pick(lang, 'يوم الأسبوع', 'Day of the week', 'ہفتے کا دن'),
  ctxMonth:    pick(lang, `عن شهر ${monName}`, `About ${monName}`, `${monName} کے بارے میں`),
  ctxOcc:      pick(lang, 'مناسبة هذا اليوم', 'Occasion on this day', 'اس دن کی مناسبت'),
  ctxOccMore:  pick(lang, 'تفاصيل المناسبة', 'Occasion details', 'مناسبت کی تفصیل'),
  ctxOtd:      pick(lang, 'في مثل هذا اليوم الهجري', 'On this Hijri day', 'اسی ہجری دن'),
  ctxOtdMore:  pick(lang, 'اقرأ القصة كاملة', 'Read the full story', 'مکمل کہانی پڑھیں'),
  ctxNotes:    pick(lang, 'ملاحظات على هذا اليوم', 'Notes on this day', 'اس دن سے متعلق نکات'),
  brand:       pick(lang, 'التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر'),
  convTag:     pick(lang, 'تحويل التاريخ', 'Date Converter', 'تاریخ کنورٹر'),
  home:        pick(lang, 'الرئيسية', 'Home', 'ہوم'),
  homeAria:    pick(lang, 'الانتقال إلى الصفحة الرئيسية', 'Go to homepage', 'ہوم پیج پر جائیں'),
  footer:      pick(lang, 'الحساب وفق تقويم أم القرى', 'Dates based on the Umm al-Qura calendar · for reference', 'حساب اُمّ القریٰ تقویم کے مطابق'),
  privacy:     pick(lang, 'سياسة الخصوصية', 'Privacy Policy', 'رازداری پالیسی'),
};
---
<Layout title={title} description={description} canonical={canonical} lang={lang} jsonLd={jsonLd}
  arPath={convBasePath(hy, hm, hd, 'ar')} enPath={convBasePath(hy, hm, hd, 'en')} urPath={convBasePath(hy, hm, hd, 'ur')}
  noindex={!indexable}>
  <header class="site-header">
    <div class="header-start">
      <a href={homeHref} class="logo" aria-label={t.homeAria}>
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">{t.brand}</div>
          <div class="tagline">{t.convTag}</div>
        </div>
      </a>
      <a href={homeHref} class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>{t.home}</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <section class="card section-card" style="order:1">
        <h1 class="section-h2" style="font-size:22px">{t.h1}</h1>

        <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start">
          <div>
            <div style="font-size:12px;color:var(--muted);font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-bottom:5px">{t.answerLabel}</div>
            <div style="font-size:28px;font-weight:800;color:var(--accent);line-height:1.2">{gregFmt}</div>
            <div style="font-size:13px;color:var(--muted);margin-top:6px">
              <time datetime={isoDate(gDate)}>{isoDate(gDate)}</time>
            </div>
          </div>
          <div style="padding-inline-start:24px;border-inline-start:2px solid var(--border)">
            <div style="font-size:12px;color:var(--muted);font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-bottom:5px">{t.hijriLbl}</div>
            <div style="font-size:20px;font-weight:700;color:var(--text);line-height:1.3">{hijriLabel}</div>
          </div>
        </div>

        <div style="margin-top:18px">
          <a href={monthHref} style="color:var(--accent);text-decoration:none;font-size:14.5px;font-weight:600">
            ↗ {t.monthLink}
          </a>
        </div>
      </section>

      <section class="card section-card" style="order:1.5">
        <h2 class="section-h2">{t.ctxTitle}</h2>

        <div class="ctx-grid">
          <div class="ctx-item">
            <span class="ctx-label">{t.ctxWeekday}</span>
            <span class="ctx-value">{weekday}</span>
          </div>
          <div class="ctx-item">
            <span class="ctx-label">{t.th_greg}</span>
            <span class="ctx-value">{gMonth} {gDate.getUTCFullYear()}</span>
          </div>
        </div>

        {occInfo && (
          <div class="ctx-block ctx-occ">
            <span class="ctx-label">{t.ctxOcc}</span>
            <p class="ctx-head">{occInfo.name}</p>
            <p class="section-p" style="margin:6px 0 0">{occInfo.what}</p>
            {occInfo.href && <a href={occInfo.href} class="ctx-link">{t.ctxOccMore} ←</a>}
          </div>
        )}

        {otdInfo && (
          <div class="ctx-block">
            <span class="ctx-label">{t.ctxOtd}</span>
            <p class="ctx-head">{otdInfo.title} <span style="font-weight:600;color:var(--muted);font-size:14px">· {otdInfo.year}</span></p>
            <p class="section-p" style="margin:6px 0 0">{otdInfo.summary}</p>
            <a href={otdInfo.href} class="ctx-link">{t.ctxOtdMore} ←</a>
          </div>
        )}

        <div class="ctx-block">
          <span class="ctx-label">{t.ctxNotes}</span>
          <ul class="ctx-notes">
            {dayNotes.map(n => <li>{n}</li>)}
          </ul>
        </div>

        <div class="ctx-block">
          <span class="ctx-label">{t.ctxMonth}</span>
          <p class="section-p" style="margin:6px 0 0">{monthNote}</p>
          <a href={monthHref} class="ctx-link">{t.monthLink} ←</a>
        </div>
      </section>

      {crossYears.length > 1 && (
        <section class="card section-card" style="order:2">
          <h2 class="section-h2">{t.crossTitle}</h2>
          <div style="margin-top:12px;overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;font-size:14.5px">
              <thead>
                <tr>
                  <th style="text-align:start;padding:8px 10px;border-bottom:2px solid var(--border);color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase">{t.th_hy}</th>
                  <th style="text-align:start;padding:8px 10px;border-bottom:2px solid var(--border);color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase">{t.th_greg}</th>
                </tr>
              </thead>
              <tbody>
                {crossYears.map(row => (
                  <tr style={row.current ? 'background:var(--accent-soft)' : ''}>
                    <td style="padding:9px 10px;border-bottom:1px solid var(--border)">
                      <a href={row.href} style={`text-decoration:none;font-weight:${row.current ? '800' : '500'};color:${row.current ? 'var(--accent)' : 'var(--text)'}`}>
                        {row.hy} {era}
                      </a>
                    </td>
                    <td style="padding:9px 10px;border-bottom:1px solid var(--border);color:var(--muted)">
                      {fmtGregorianShort(row.gDate, lang)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="card section-card" style="order:3">
        <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:20px">
          {prevDay ? (
            <a href={convBasePath(hy, hm, prevDay, lang)} style="color:var(--accent);text-decoration:none;font-weight:700;font-size:14px">
              ‹ {t.prevLbl}: {prevDay} {monName}
            </a>
          ) : <span></span>}
          {nextDay ? (
            <a href={convBasePath(hy, hm, nextDay, lang)} style="color:var(--accent);text-decoration:none;font-weight:700;font-size:14px">
              {t.nextLbl}: {nextDay} {monName} ›
            </a>
          ) : <span></span>}
        </div>
        <h2 class="section-h2">{t.howTitle}</h2>
        <p class="section-p">{t.howBody}</p>
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">{t.toolsTitle}</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href={homeHref} style="color:var(--accent);text-decoration:none">{t.fullCal}</a>
          <a href={homeHref} style="color:var(--accent);text-decoration:none">{t.converter}</a>
          <a href={monthHref} style="color:var(--accent);text-decoration:none">{monName} {hy} {era}</a>
        </div>
      </div>
    </aside>
  </div>

  <style>
    .ctx-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
    .ctx-item {
      flex: 1 1 160px; padding: 11px 14px; border-radius: 11px;
      border: 1px solid var(--border); background: var(--surface2);
    }
    .ctx-block { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border); }
    .ctx-block.ctx-occ { border-top: none; padding: 14px 16px; margin-top: 16px; border-radius: 12px; background: var(--accent-soft); }
    .ctx-label {
      display: block; font-size: 11.5px; font-weight: 700; letter-spacing: .05em;
      text-transform: uppercase; color: var(--muted); margin-bottom: 5px;
    }
    .ctx-value { display: block; font-size: 16px; font-weight: 700; }
    .ctx-head { margin: 0; font-size: 16.5px; font-weight: 700; color: var(--accent); }
    .ctx-notes { margin: 8px 0 0; padding-inline-start: 20px; display: flex; flex-direction: column; gap: 7px; }
    .ctx-notes li { font-size: 15px; line-height: 1.85; color: var(--text); }
    .ctx-link { display: inline-block; margin-top: 10px; font-size: 13.5px; font-weight: 700; color: var(--accent); text-decoration: none; }
  </style>

  <footer class="site-footer">
    {t.footer}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href={privacyHref} style="color:var(--muted);text-decoration:none;font-size:13px">{t.privacy}</a>
  </footer>
