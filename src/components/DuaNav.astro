---
import { type Lang } from '../lib/data';
import { DUA_SECTIONS, srcLabel } from '../lib/duas';

interface Props { lang: Lang; currentId?: string }
const { lang, currentId } = Astro.props;

const tool = (p: string) => (lang === 'ar' ? p : `/${lang}${p}`);
const catHref = (id: string) => tool(`/dua/${id}/`);
const L = (ar: string, en: string, ur: string) => (lang === 'ar' ? ar : lang === 'ur' ? ur : en);
const pick = (t: { ar: string; en: string; ur: string }) => (lang === 'ar' ? t.ar : lang === 'ur' ? t.ur : t.en);

const navTitle = L('الأقسام', 'Sections', 'فہرست');
const showLabel = L('عرض المحتوى', 'Show contents', 'مواد دکھائیں');

const ICONS: Record<string, string> = {
  'morning-evening': '🌅', 'quran': '📖', 'distress': '🤲', 'daily': '🌙',
  'parents-family': '👪', 'health-protection': '🩹', 'rizq-tawbah': '🌾',
};

const firstWords = (s: string, n = 5) =>
  s.replace(/\n[\s\S]*$/, '').split(/\s+/).slice(0, n).join(' ');
const itemLabel = (d: typeof DUA_SECTIONS[number]['items'][number]): string => {
  if (d.when) return pick(d.when);
  if (d.src.kind === 'quran') return srcLabel(d.src, lang);
  return firstWords(d.ar) + '…';
};
// In-page anchor when the section is the current page; otherwise link to its page + anchor.
const itemHref = (sectionId: string, i: number) =>
  sectionId === currentId ? `#${sectionId}__${i}` : `${catHref(sectionId)}#${sectionId}__${i}`;
// Open the current section by default; on the hub (no current) open the first.
const isOpen = (id: string, idx: number) => (currentId ? id === currentId : idx === 0);
---
<nav class="dua-nav card" aria-label={navTitle}>
  <div class="dua-nav-title">{navTitle}</div>
  <ul class="dua-nav-list">
    {DUA_SECTIONS.map((s, si) => {
      const open = isOpen(s.id, si);
      const current = s.id === currentId;
      return (
        <li class={`dn-group${open ? ' open' : ''}${current ? ' current' : ''}`} data-group={s.id}>
          <div class="dn-headrow">
            <a class="dn-head" href={catHref(s.id)} aria-current={current ? 'page' : undefined}>
              <span class="dn-ic" aria-hidden="true">{ICONS[s.id] ?? '•'}</span>
              <span class="dn-label">{pick(s.title)}</span>
              <span class="dn-count">{s.items.length}</span>
            </a>
            <button type="button" class="dn-toggle" aria-expanded={open ? 'true' : 'false'} aria-label={showLabel}>
              <svg class="dn-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="dn-subwrap">
            <ul class="dn-sub">
              {s.items.map((d, i) => (
                <li>
                  <a href={itemHref(s.id, i)} data-item={`${s.id}__${i}`}>{itemLabel(d)}</a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      );
    })}
  </ul>
</nav>

<style is:global>
  html { scroll-behavior: smooth; }
</style>

<style>
  .dua-nav {
    padding: 16px 14px;
    max-height: calc(100vh - 90px); overflow-y: auto;
  }
  .dua-nav-title {
    font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); padding: 0 8px 10px; margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .dua-nav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .dn-group { border-radius: 12px; }

  .dn-headrow {
    display: flex; align-items: center; gap: 2px;
    border-radius: 12px; border: 1px solid transparent;
    transition: background .18s, border-color .18s;
  }
  .dn-group.current > .dn-headrow {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .dn-headrow:hover { background: var(--surface2); }
  .dn-group.current > .dn-headrow:hover { background: var(--accent-soft); }

  .dn-head {
    flex: 1 1 auto; min-width: 0;
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; border-radius: 12px;
    color: var(--text); text-decoration: none; font-weight: 700; font-size: 14.5px;
  }
  .dn-group.current > .dn-headrow .dn-head { color: var(--accent); }
  .dn-ic { font-size: 17px; line-height: 1; flex: 0 0 auto; }
  .dn-label { flex: 1 1 auto; line-height: 1.35; min-width: 0; }
  .dn-count {
    flex: 0 0 auto; min-width: 22px; text-align: center;
    font-size: 12px; font-weight: 800; color: var(--muted);
    background: var(--surface2); border-radius: 999px; padding: 2px 8px;
  }
  .dn-group.current > .dn-headrow .dn-count { color: var(--accent); background: var(--surface); }

  .dn-toggle {
    flex: 0 0 auto; display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; margin-inline-end: 4px;
    border: none; background: none; color: var(--muted); cursor: pointer;
    border-radius: 9px; transition: background .15s, color .15s;
  }
  .dn-toggle:hover { background: var(--surface); color: var(--text); }
  .dn-chevron { transition: transform .25s ease; }
  .dn-group.open .dn-toggle .dn-chevron { transform: rotate(180deg); }

  /* Collapsible sub-list (animated via grid-template-rows) */
  .dn-subwrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s ease; }
  .dn-group.open > .dn-subwrap { grid-template-rows: 1fr; }
  .dn-sub { list-style: none; margin: 0; padding: 0; min-height: 0; overflow: hidden; }
  .dn-group.open > .dn-subwrap > .dn-sub { padding: 3px 0 7px; }
  .dn-sub a {
    display: block; position: relative;
    padding: 6px 12px; padding-inline-start: 36px;
    border-radius: 9px; color: var(--muted); text-decoration: none;
    font-size: 13px; font-weight: 600; line-height: 1.5;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: background .15s, color .15s;
  }
  .dn-sub a::before {
    content: ''; position: absolute; inset-inline-start: 19px; top: 50%;
    width: 5px; height: 5px; border-radius: 50%; background: var(--border);
    transform: translateY(-50%); transition: background .15s;
  }
  .dn-sub a:hover { background: var(--surface2); color: var(--text); }
  .dn-sub a.active { background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .dn-sub a.active::before { background: var(--accent); }

  /* On mobile the cards / page content handle navigation. */
  @media (max-width: 959px) { .dua-nav { display: none; } }
</style>

<script>
  // Expand / collapse each section's dropdown.
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.dua-nav .dn-group'));
  groups.forEach(g => {
    const btn = g.querySelector<HTMLButtonElement>('.dn-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const open = g.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  // Highlight the supplication currently in view (only items present on this page).
  const subById = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('.dua-nav .dn-sub a[data-item]'))
      .map(a => [a.dataset.item!, a])
  );
  const items = Array.from(document.querySelectorAll<HTMLElement>('.dua-item[id]'));
  if ('IntersectionObserver' in window && items.length) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter(e => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) {
        const id = (visible[0].target as HTMLElement).id;
        subById.forEach((a, k) => a.classList.toggle('active', k === id));
      }
    }, { rootMargin: '-72px 0px -60% 0px', threshold: 0 });
    items.forEach(i => observer.observe(i));
  }
</script>
