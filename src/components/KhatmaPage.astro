---
// صفحة الختمة الواحدة — نسخة واحدة تخدم اللغات الثلاث.
import Layout from '../layouts/Layout.astro';
import KhatmaGrid from './KhatmaGrid';
import { pick, type Lang } from '../lib/data';
import { khatmaT } from '../lib/khatma-i18n';
import type { Loaded } from '../lib/khatma-load';

// The data is loaded — and the response status set — by the page that renders
// this component, because Astro streams and a status set after an await in here
// would arrive too late. See lib/khatma-load.ts.
interface Props { lang: Lang; loaded: Loaded }
const { lang, loaded } = Astro.props;
const { slug, view, problem } = loaded;
const t = khatmaT(lang);

const isNew = Astro.url.searchParams.get('new') === '1';
const canonical = `https://islamicdates.org${t.base}${slug}/`;
const home = pick(lang, '/', '/en/', '/ur/');
const title = view ? t.khatmaTitle(view.title) : t.notFoundH;
const description = view ? t.khatmaDesc(view.title, view.done) : t.notFoundBody;

// Link preview: one pre-rendered card per language and progress count
// (public/og/khatma/, generated by scripts/gen-khatma-og.mjs). The khatma's own
// name travels in og:title beside it, so the image only has to carry progress.
const ogDone = view ? Math.max(0, Math.min(30, view.done)) : 0;
const ogImage = view ? `https://islamicdates.org/og/khatma/${lang}-${ogDone}.jpg` : undefined;
const ogImageAlt = view ? t.ogAlt(view.title, view.done) : undefined;
---
<Layout title={title} description={description} canonical={canonical} lang={lang}
        arPath={`/khatma/${slug}/`} enPath={`/en/khatma/${slug}/`} urPath={`/ur/khatma/${slug}/`} noindex={true}
        ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <header class="site-header">
    <div class="header-start">
      <a href={home} class="logo" aria-label={t.home}>
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">{pick(lang, 'التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر')}</div>
          <div class="tagline">{t.tagline}</div>
        </div>
      </a>
      <a href={t.base} class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>{t.navNew}</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      {view ? (
        <>
          {isNew && (
            <section class="card section-card kh-new-note" style="order:0;display:none" data-kh-new={slug}>
              <p><strong>{t.newNoteLead}</strong> {t.newNote}</p>
            </section>
          )}

          <section class="card section-card" style="order:1">
            <h1 class="section-h2" style="font-size:24px">{view.title}</h1>
            <p class="section-p" style="margin-top:8px">{t.pageIntro}</p>
          </section>

          <section class="card section-card" style="order:2">
            <KhatmaGrid initial={view} lang={lang} t={t.grid} holdLabel={t.holdText(view.holdHours)} base={t.base}
                        shareUrl={canonical} client:load />
          </section>

          <section class="card section-card" style="order:3">
            <h2 class="section-h2">{t.reminderH}</h2>
            <p class="section-p">{t.reminder}</p>
          </section>
        </>
      ) : (
        <section class="card section-card" style="order:1">
          <h1 class="section-h2" style="font-size:24px">
            {problem === 'unavailable' ? t.unavailableH : t.notFoundH}
          </h1>
          <p class="section-p" style="margin-top:8px">
            {problem === 'unavailable' ? t.unavailableBody : t.notFoundBody}
          </p>
          <p class="section-p" style="margin-top:12px"><a href={t.base} style="color:var(--accent)">{t.createNew}</a></p>
        </section>
      )}
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">{t.relatedH}</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href={t.base} style="color:var(--accent);text-decoration:none">{t.createNew}</a>
          {t.related.slice(0, 4).map(r => (<a href={r.href} style="color:var(--accent);text-decoration:none">{r.label}</a>))}
        </div>
      </div>
    </aside>
  </div>

  {isNew && view && (
    <script is:inline>
      // `?new=1` is the creator's landing flag, but it rides along whenever the
      // address bar is copied, so a link like that reaches the whole group and
      // every reader was told "your khatma is ready — keep this link". The note
      // now ships hidden and is revealed only in the browser that created the
      // khatma (it alone holds the admin key), so the group never sees it, not
      // even for a frame; and the flag is dropped from the address bar either
      // way, so the next copy is clean.
      (function () {
        var note = document.querySelector('[data-kh-new]');
        var mine = true;
        try { mine = !!(note && localStorage.getItem('idk.khatma.admin.' + note.getAttribute('data-kh-new'))); } catch (_) { /* storage blocked: assume the creator */ }
        if (note && mine) note.style.display = '';
        try {
          var u = new URL(location.href);
          u.searchParams.delete('new');
          history.replaceState(history.state, '', u.pathname + (u.search === '?' ? '' : u.search) + u.hash);
        } catch (_) {}
      })();
    </script>
  )}

  <footer class="site-footer">
    {t.footerNote}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href={t.privacyHref} style="color:var(--muted);text-decoration:none;font-size:13px">{t.privacyLabel}</a>
  </footer>
  <style is:global>
    .kh-new-note p { margin:0; font-size:14.5px; line-height:1.85; color:var(--muted); }
    .kh-new-note strong { color:var(--text); }

    .kh-progress { margin-bottom:14px; }
    .kh-bar { height:10px; border-radius:99px; background:var(--accent-soft); overflow:hidden; }
    .kh-bar span { display:block; height:100%; background:var(--accent); border-radius:99px; transition:width .35s ease; }
    .kh-count { margin:8px 0 0; font-size:15px; }
    .kh-count strong { font-size:17px; color:var(--accent-strong); }
    .kh-sub { color:var(--muted); font-size:14px; }
    .kh-complete { margin:0 0 14px; padding:12px 14px; border-radius:12px; background:var(--accent-soft); font-size:14.5px; line-height:1.8; }
    .kh-complete a { color:var(--accent-strong); font-weight:700; }
    .kh-mine-note { margin:0 0 12px; padding:11px 13px; border-radius:12px; background:var(--gold-soft); color:var(--gold-deep); font-size:14px; line-height:1.8; }
    .kh-err { margin:0 0 12px; padding:11px 13px; border-radius:12px; background:#fdecea; color:#b42318; font-size:14px; }

    .kh-grid { list-style:none; margin:0; padding:0; display:grid; gap:10px; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); }
    /* The <li> is the card: its frame holds the face (a button, for taking a
       free juz) and, for the reader's own juz, the action buttons — inside the
       same border. Buttons cannot nest inside the face button, hence the split. */
    .kh-cell {
      display:flex; flex-direction:column;
      border-radius:14px; border:1px solid var(--border); background:var(--surface);
      transition:border-color .15s, background .15s, transform .12s;
    }
    .kh-free:hover { border-color:var(--accent); transform:translateY(-1px); }
    .kh-face {
      font:inherit; text-align:start; width:100%; cursor:pointer;
      display:flex; flex-direction:column; gap:3px;
      padding:11px 12px; border:0; border-radius:14px; background:transparent; color:var(--text);
    }
    .kh-face[disabled] { cursor:default; }
    .kh-face:focus-visible { outline:2px solid var(--accent); outline-offset:-2px; }
    .kh-n { font-size:15px; font-weight:800; line-height:1.4; color:var(--accent-strong); }
    .kh-name { font-size:14px; font-weight:600; }
    .kh-range { font-size:12px; color:var(--muted); }
    .kh-tag { margin-top:5px; font-size:12px; font-weight:700; line-height:1.5; }
    .kh-take { color:var(--accent-strong); }

    .kh-done { background:var(--accent-soft); border-color:transparent; }
    .kh-done .kh-n, .kh-done .kh-tag { color:var(--accent-strong); }
    .kh-held .kh-face { opacity:.62; }
    .kh-held .kh-n { color:var(--muted); }
    .kh-mine { border-color:var(--gold); background:var(--gold-soft); }
    .kh-mine .kh-n, .kh-mine .kh-tag { color:var(--gold-deep); }

    .kh-actions { display:flex; flex-direction:column; gap:6px; padding:0 10px 10px; }
    .kh-actions button, .kh-read {
      font:inherit; font-size:13px; font-weight:700; line-height:1.35; padding:8px 10px; border-radius:10px; border:0;
      display:flex; align-items:center; justify-content:center; gap:6px; text-align:center;
      background:var(--accent); color:var(--accent-contrast); cursor:pointer; text-decoration:none;
    }
    .kh-actions svg { flex:0 0 auto; }
    .kh-actions button:hover, .kh-read:hover { background:var(--accent-strong); }
    .kh-actions button[disabled] { opacity:.6; cursor:default; }
    .kh-read { background:var(--surface) !important; color:var(--accent-strong) !important; border:1px solid var(--accent) !important; }
    .kh-read:hover { background:var(--accent-soft) !important; }
    .kh-ghost { background:transparent !important; color:var(--muted) !important; border:1px solid var(--border) !important; }
    .kh-ghost:hover { color:var(--text) !important; }
    .kh-mine .kh-ghost { color:var(--gold-deep) !important; border-color:var(--gold) !important; }

    .kh-modal { position:fixed; inset:0; z-index:60; background:rgba(9,25,31,.5); display:grid; place-items:center; padding:18px; }
    .kh-sheet { width:min(420px, 100%); background:var(--surface); border-radius:18px; padding:20px; box-shadow:var(--shadow-lift); }
    .kh-sheet h3 { margin:0 0 4px; font-size:17px; }
    .kh-hint { margin:0 0 14px; font-size:13px; color:var(--muted); }
    .kh-sheet label { display:block; font-size:14px; font-weight:600; margin-bottom:6px; }
    .kh-sheet input { font:inherit; width:100%; padding:11px 13px; border:1px solid var(--border); border-radius:12px; background:var(--bg); color:var(--text); }
    .kh-note { margin:12px 0 0; font-size:13px; color:var(--muted); line-height:1.8; }
    .kh-sheet-actions { display:flex; gap:8px; margin-top:16px; }
    .kh-sheet-actions button { font:inherit; font-weight:700; padding:11px 16px; border-radius:12px; border:0; background:var(--accent); color:var(--accent-contrast); cursor:pointer; }

    .kh-share { margin:0 0 16px; padding:14px; border-radius:14px; background:var(--accent-soft); }
    .kh-share p { margin:0 0 9px; font-size:14px; color:var(--text); }
    .kh-share .kh-thanks { font-weight:600; color:var(--accent-strong); }
    .kh-share-row { display:flex; gap:8px; flex-wrap:wrap; }
    .kh-share-row .kh-ghost { background:var(--surface) !important; }
    .kh-wa, .kh-share-row button {
      font:inherit; font-size:14px; font-weight:700; padding:10px 15px; border-radius:12px; border:0;
      display:inline-flex; align-items:center; gap:7px;
      background:var(--accent); color:var(--accent-contrast); text-decoration:none; cursor:pointer;
    }
    .kh-wa { background:#25D366; color:#fff; }
    .kh-wa:hover { background:#1ebe5a; }
    .kh-share-row svg { flex:0 0 auto; }
    @media (max-width:480px) {
      .kh-grid { grid-template-columns:repeat(auto-fill, minmax(140px, 1fr)); }
    }
  </style>
</Layout>
