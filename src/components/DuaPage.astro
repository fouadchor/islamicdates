---
import { type Lang } from '../lib/data';
import { DUA_SECTIONS, DUA_PAGE, DUA_UI, DUA_HUB_FAQ, DUA_FAQ_TITLE } from '../lib/duas';
import DuaNav from './DuaNav.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;

const P = DUA_PAGE[lang];
const U = DUA_UI[lang];
const home = lang === 'ar' ? '/' : `/${lang}/`;
const tool = (p: string) => (lang === 'ar' ? p : `/${lang}${p}`);
const catHref = (id: string) => tool(`/dua/${id}/`);
const L = (ar: string, en: string, ur: string) => (lang === 'ar' ? ar : lang === 'ur' ? ur : en);
const pick = (t: { ar: string; en: string; ur: string }) => (lang === 'ar' ? t.ar : lang === 'ur' ? t.ur : t.en);

// Section icons (kept simple & friendly, themed by section).
const ICONS: Record<string, string> = {
  'morning-evening': '🌅',
  'quran': '📖',
  'distress': '🤲',
  'daily': '🌙',
};

const related = [
  { href: home, label: L('التقويم الهجري وتاريخ اليوم', 'Hijri calendar & today’s date', 'ہجری کیلنڈر و آج کی تاریخ') },
  { href: tool('/prayer-times/'), label: L('مواقيت الصلاة', 'Prayer times', 'مواقیتِ نماز') },
  { href: tool('/zakat/'), label: L('حاسبة الزكاة', 'Zakat calculator', 'زکوٰۃ کیلکولیٹر') },
  { href: tool('/about/'), label: L('دليل التقويم الهجري', 'Hijri calendar guide', 'ہجری کیلنڈر گائیڈ') },
];
---
<header class="site-header">
  <div class="header-start">
    <a href={home} class="logo" aria-label={L('الانتقال إلى الصفحة الرئيسية', 'Go to homepage', 'ہوم پیج پر جائیں')}>
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L('التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر')}</div>
        <div class="tagline">{L('الدعاء والأذكار', 'Duʿaʾ & Adhkar', 'دعا و اذکار')}</div>
      </div>
    </a>
    <a href={home} class="home-btn">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
      <span>{L('الرئيسية', 'Home', 'ہوم')}</span>
    </a>
  </div>
</header>

<div class="dua-layout">
  <aside class="dua-side">
    <DuaNav lang={lang} />

    <div class="ad-slot"><span class="ad-label">{L('مساحة إعلانية', 'Advertisement', 'اشتہار')}</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>

    <div class="card related-card">
      <h2 class="related-title">{P.relatedTitle}</h2>
      <div class="related-links">
        {related.map(r => <a href={r.href}>{r.label}</a>)}
      </div>
    </div>
  </aside>

  <main class="dua-main">
    <section class="card section-card dua-hero">
      <h1 class="dua-h1">{P.h1}</h1>
      <p class="section-p" style="margin-top:10px">{P.lead}</p>
      <p class="dua-note">{P.sourcesNote}</p>
    </section>

    <!-- Hub: each card opens its own standalone category page -->
    <nav class="topic-cards" aria-label={L('أقسام الدعاء', 'Duʿaʾ sections', 'دعا کے حصے')}>
      {DUA_SECTIONS.map(s => (
        <a class="topic-card" href={catHref(s.id)}>
          <span class="tc-ic" aria-hidden="true">{ICONS[s.id] ?? '☾'}</span>
          <span class="tc-body">
            <span class="tc-title">{pick(s.title)}</span>
            <span class="tc-intro">{pick(s.intro)}</span>
            <span class="tc-foot">
              <span class="tc-count">{s.items.length} {U.supplications}</span>
              <span class="tc-cta">{U.viewAll}
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </span>
          </span>
        </a>
      ))}
    </nav>

    <section class="card section-card dua-faq" aria-label={pick(DUA_FAQ_TITLE)}>
      <h2 class="faq-title">{pick(DUA_FAQ_TITLE)}</h2>
      <div class="faq-list">
        {DUA_HUB_FAQ.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-q">{pick(f.q)}</summary>
            <p class="faq-a">{pick(f.a)}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</div>

<footer class="site-footer">
  {L('الأدعية من القرآن الكريم والسنة الصحيحة', 'Supplications from the Quran and authentic Sunnah', 'دعائیں قرآن کریم اور صحیح سنت سے')}
  <span style="margin:0 8px;opacity:.4">·</span>
  <a href={tool('/privacy/')} style="color:var(--muted);text-decoration:none;font-size:13px">{L('سياسة الخصوصية', 'Privacy Policy', 'رازداری پالیسی')}</a>
</footer>

<style>
  /* ───── Layout: direction-aware grid (sidebar on the start side: right in RTL) ───── */
  .dua-layout {
    max-width: 1180px; margin: 0 auto;
    padding: 22px 20px 56px;
    display: grid; gap: 24px;
    grid-template-columns: 1fr;
  }
  .dua-main { min-width: 0; display: flex; flex-direction: column; gap: 22px; order: 1; }
  /* Mobile-first: reset the global sticky/width aside rule so the sidebar
     stacks below the content instead of floating over it. */
  .dua-side { display: flex; flex-direction: column; gap: 18px; order: 2; position: static; max-width: none; min-width: 0; top: auto; }

  @media (min-width: 960px) {
    .dua-layout { grid-template-columns: 282px minmax(0, 1fr); align-items: start; }
    .dua-side { grid-column: 1; grid-row: 1; position: sticky; top: 70px; }
    .dua-main { grid-column: 2; grid-row: 1; }
  }

  /* ───── Related card ───── */
  .related-card { padding: 18px 20px; }
  .related-title { margin: 0 0 12px; font-size: 15.5px; font-weight: 700; }
  .related-links { display: flex; flex-direction: column; gap: 10px; font-size: 14.5px; }
  .related-links a { color: var(--accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }

  /* ───── Hero ───── */
  .dua-h1 { margin: 0; font-size: 26px; font-weight: 800; line-height: 1.3; }
  .dua-note {
    margin: 16px 0 0; padding: 13px 16px; border-radius: 12px;
    background: var(--surface2); border: 1px solid var(--border);
    color: var(--muted); font-size: 13.5px; line-height: 1.85;
  }

  /* ───── Topic cards (hub → standalone pages) ───── */
  .topic-cards {
    display: grid; gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 560px) { .topic-cards { grid-template-columns: 1fr; } }
  .topic-card {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 18px; border-radius: var(--radius);
    background: var(--surface); border: 1px solid var(--border);
    box-shadow: var(--shadow); text-decoration: none; color: var(--text);
    transition: transform .18s, box-shadow .18s, border-color .18s;
  }
  .topic-card:hover {
    transform: translateY(-2px); border-color: var(--accent);
    box-shadow: 0 8px 26px rgba(13,40,48,.10);
  }
  .tc-ic {
    flex: 0 0 auto; width: 50px; height: 50px; border-radius: 14px;
    background: var(--accent-soft); display: flex; align-items: center; justify-content: center;
    font-size: 26px; line-height: 1;
  }
  .tc-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .tc-title { font-weight: 800; font-size: 17px; line-height: 1.3; }
  .tc-intro {
    font-size: 13px; color: var(--muted); line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .tc-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 4px; }
  .tc-count {
    font-size: 12px; font-weight: 800; color: var(--gold-deep);
    background: var(--gold-soft); padding: 3px 10px; border-radius: 999px;
  }
  .tc-cta {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 13px; font-weight: 800; color: var(--accent);
  }
  [dir="rtl"] .tc-cta svg { transform: scaleX(-1); }

  /* FAQ */
  .faq-title { margin: 0 0 8px; font-size: 18px; font-weight: 800; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 4px 0; }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    cursor: pointer; list-style: none; position: relative;
    padding: 12px 30px 12px 0; font-weight: 700; font-size: 15.5px; color: var(--text);
    line-height: 1.6;
  }
  [dir="rtl"] .faq-q { padding: 12px 0 12px 30px; }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+'; position: absolute; inset-inline-end: 4px; top: 10px;
    font-size: 20px; font-weight: 700; color: var(--accent); transition: transform .2s;
  }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a { margin: 0 0 12px; color: var(--muted); line-height: 1.9; font-size: 14.5px; text-wrap: pretty; }
</style>
