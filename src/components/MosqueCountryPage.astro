---
import Layout from '../layouts/Layout.astro';
import { type PtCountry } from '../lib/cities';
import { mosqueCitiesOfCountry, mosqueCityPath, mosqueCountryPath, mosqueBase, curatedMosquesFor } from '../lib/mosque-cities';
import { type Lang, pick } from '../lib/data';

interface Props { lang: Lang; country: PtCountry }
const { lang, country } = Astro.props;

const countryName = pick(lang, country.ar, country.en, country.ur);
const cities      = mosqueCitiesOfCountry(country.code);
const canonical   = `https://islamicdates.org${mosqueCountryPath(country.slug, lang)}`;
const homeHref    = pick(lang, '/', '/en/', '/ur/');

const title = pick(lang,
  `مساجد ${countryName} · دليل المساجد في مدن ${countryName}`,
  `Mosques in ${countryName} · Directory by City`,
  `${countryName} کی مساجد · شہر کے حساب سے فہرست`);

const description = pick(lang,
  `دليل مساجد ${countryName}: اختر مدينتك لعرض أبرز المساجد والجوامع مع اتجاهات لكل مسجد وأداة تُظهر أقرب مسجد إلى موقعك. يشمل ${cities.map(c => c.ar).slice(0, 6).join('، ')} وغيرها.`,
  `Mosque directory for ${countryName}: choose your city to see notable mosques with directions and a tool that finds the mosque nearest to you. Covers ${cities.map(c => c.en).slice(0, 6).join(', ')} and more.`,
  `${countryName} کی مساجد کی فہرست: اپنا شہر منتخب کریں اور نمایاں مساجد، راستے اور قریب ترین مسجد تلاش کرنے والا ٹول دیکھیں۔ ${cities.map(c => c.ur).slice(0, 6).join('، ')} وغیرہ شامل ہیں۔`);

const jsonLd = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': pick(lang, 'الرئيسية', 'Home', 'ہوم'), 'item': `https://islamicdates.org${homeHref}` },
    { '@type': 'ListItem', 'position': 2, 'name': pick(lang, 'المساجد القريبة', 'Mosques', 'مساجد'), 'item': `https://islamicdates.org${mosqueBase(lang)}` },
    { '@type': 'ListItem', 'position': 3, 'name': countryName, 'item': canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', 'name': title,
    'itemListElement': cities.map((c, i) => ({ '@type': 'ListItem', 'position': i + 1, 'name': pick(lang, c.ar, c.en, c.ur), 'url': `https://islamicdates.org${mosqueCityPath(country.slug, c.slug, lang)}` })) },
]);

const t = {
  brand:    pick(lang, 'التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر'),
  tagline:  pick(lang, 'المساجد القريبة', 'Mosques Near Me', 'قریبی مساجد'),
  home:     pick(lang, 'الرئيسية', 'Home', 'ہوم'),
  homeAria: pick(lang, 'الانتقال إلى الصفحة الرئيسية', 'Go to homepage', 'ہوم پیج پر جائیں'),
  crumbDir: pick(lang, 'المساجد', 'Mosques', 'مساجد'),
  h1:       pick(lang, `مساجد ${countryName}`, `Mosques in ${countryName}`, `${countryName} کی مساجد`),
  intro:    pick(lang,
    `اختر مدينتك في ${countryName} لعرض أبرز مساجدها وجوامعها مع رابط اتجاهات لكل مسجد، وأداة تُظهر أقرب مسجد إلى موقعك، ومواقيت الصلاة واتجاه القبلة للمدينة.`,
    `Choose your city in ${countryName} to see its notable mosques with directions, a tool that finds the mosque nearest to you, and the city's prayer times and Qibla direction.`,
    `${countryName} میں اپنا شہر منتخب کریں تاکہ نمایاں مساجد، ہر مسجد تک راستہ، قریب ترین مسجد تلاش کرنے والا ٹول، اور شہر کے اوقاتِ نماز و قبلہ دیکھ سکیں۔`),
  cities:   pick(lang, `المدن (${cities.length})`, `Cities (${cities.length})`, `شہر (${cities.length})`),
  backAll:  pick(lang, '← كل الدول', '← All countries', '← تمام ممالک'),
  tools:    pick(lang, 'أدوات ذات صلة', 'Related tools', 'متعلقہ اوزار'),
  mainTool: pick(lang, 'المساجد القريبة من موقعك', 'Mosques near your location', 'آپ کے قریب مساجد'),
  fullCal:  pick(lang, 'التقويم الهجري وتاريخ اليوم', "Hijri calendar & today's date", 'ہجری کیلنڈر اور آج کی تاریخ'),
  footer:   pick(lang, 'بيانات المساجد من OpenStreetMap', 'Mosque data from OpenStreetMap', 'مساجد کا ڈیٹا OpenStreetMap سے'),
  privacy:  pick(lang, 'سياسة الخصوصية', 'Privacy Policy', 'رازداری پالیسی'),
};
---
<Layout title={title} description={description} canonical={canonical} lang={lang} jsonLd={jsonLd}
  arPath={mosqueCountryPath(country.slug, 'ar')} enPath={mosqueCountryPath(country.slug, 'en')} urPath={mosqueCountryPath(country.slug, 'ur')}>
  <header class="site-header">
    <div class="header-start">
      <a href={homeHref} class="logo" aria-label={t.homeAria}>
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">{t.brand}</div>
          <div class="tagline">{t.tagline}</div>
        </div>
      </a>
      <a href={homeHref} class="home-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span>{t.home}</span>
      </a>
    </div>
  </header>

  <div class="layout">
    <main>
      <nav aria-label="breadcrumb" style="font-size:13px;color:var(--muted);margin-bottom:12px;display:flex;flex-wrap:wrap;gap:6px;align-items:center">
        <a href={mosqueBase(lang)} style="color:var(--accent);text-decoration:none">{t.crumbDir}</a>
        <span aria-hidden="true">›</span>
        <span>{countryName}</span>
      </nav>

      <section class="card section-card">
        <h1 class="section-h2" style="font-size:24px">{t.h1}</h1>
        <p class="section-p" style="margin-top:8px">{t.intro}</p>
      </section>

      <section class="card section-card">
        <h2 class="section-h2">{t.cities}</h2>
        <div class="months-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));margin-top:12px">
          {cities.map(c => (
            <a href={mosqueCityPath(country.slug, c.slug, lang)} class="month-item" style="text-decoration:none;color:inherit">
              <div>
                <div class="month-name">{pick(lang, c.ar, c.en, c.ur)}</div>
                <div class="month-note">{pick(lang, `${curatedMosquesFor(c.slug).length} مسجد`, `${curatedMosquesFor(c.slug).length} mosques`, `${curatedMosquesFor(c.slug).length} مساجد`)}</div>
              </div>
            </a>
          ))}
        </div>
        <div style="margin-top:16px">
          <a href={mosqueBase(lang)} style="color:var(--accent);text-decoration:none;font-size:14px;font-weight:700">{t.backAll}</a>
        </div>
      </section>
    </main>

    <aside>
      <div class="card" style="padding:18px 20px">
        <h3 style="margin:0 0 12px;font-size:15.5px;font-weight:700">{t.tools}</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14.5px">
          <a href={mosqueBase(lang)} style="color:var(--accent);text-decoration:none">{t.mainTool}</a>
          <a href={homeHref} style="color:var(--accent);text-decoration:none">{t.fullCal}</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    {t.footer}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href={pick(lang, '/privacy/', '/en/privacy/', '/ur/privacy/')} style="color:var(--muted);text-decoration:none;font-size:13px">{t.privacy}</a>
  </footer>
</Layout>
