---
import { type Lang } from '../lib/data';
import { DUA_SECTIONS, getDuaSection, DUA_PAGE, DUA_UI, DUA_FAQ, DUA_FAQ_TITLE } from '../lib/duas';
import DuaSectionBlock from './DuaSectionBlock.astro';
import DuaNav from './DuaNav.astro';

interface Props { lang: Lang; sectionId: string }
const { lang, sectionId } = Astro.props;

const P = DUA_PAGE[lang];
const U = DUA_UI[lang];
const section = getDuaSection(sectionId)!;
const others = DUA_SECTIONS.filter(s => s.id !== sectionId);
const faqs = DUA_FAQ[sectionId] ?? [];

const home = lang === 'ar' ? '/' : `/${lang}/`;
const tool = (p: string) => (lang === 'ar' ? p : `/${lang}${p}`);
const catHref = (id: string) => tool(`/dua/${id}/`);
const duaHub = tool('/dua/');
const L = (ar: string, en: string, ur: string) => (lang === 'ar' ? ar : lang === 'ur' ? ur : en);
const pick = (t: { ar: string; en: string; ur: string }) => (lang === 'ar' ? t.ar : lang === 'ur' ? t.ur : t.en);

const ICONS: Record<string, string> = {
  'morning-evening': '🌅', 'quran': '📖', 'distress': '🤲', 'daily': '🌙',
};

const related = [
  { href: home, label: L('التقويم الهجري وتاريخ اليوم', 'Hijri calendar & today’s date', 'ہجری کیلنڈر و آج کی تاریخ') },
  { href: tool('/prayer-times/'), label: L('مواقيت الصلاة', 'Prayer times', 'مواقیتِ نماز') },
  { href: tool('/zakat/'), label: L('حاسبة الزكاة', 'Zakat calculator', 'زکوٰۃ کیلکولیٹر') },
  { href: tool('/about/'), label: L('دليل التقويم الهجري', 'Hijri calendar guide', 'ہجری کیلنڈر گائیڈ') },
];
---
<header class="site-header">
  <div class="header-start">
    <a href={home} class="logo" aria-label={L('الانتقال إلى الصفحة الرئيسية', 'Go to homepage', 'ہوم پیج پر جائیں')}>
      <div class="logo-icon">☾</div>
      <div>
        <div class="brand">{L('التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر')}</div>
        <div class="tagline">{L('الدعاء والأذكار', 'Duʿaʾ & Adhkar', 'دعا و اذکار')}</div>
      </div>
    </a>
    <a href={duaHub} class="home-btn">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>{U.backToHub}</span>
    </a>
  </div>
</header>

<nav class="breadcrumb" aria-label={L('مسار التنقل', 'Breadcrumb', 'بریڈ کرمب')}>
  <div class="breadcrumb-inner">
    <a href={home}>{L('الرئيسية', 'Home', 'ہوم')}</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href={duaHub}>{U.duaCrumb}</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="current">{pick(section.title)}</span>
  </div>
</nav>

<div class="dua-layout">
  <aside class="dua-side">
    <DuaNav lang={lang} currentId={sectionId} />

    <div class="ad-slot"><span class="ad-label">{L('مساحة إعلانية', 'Advertisement', 'اشتہار')}</span><span style="font-size:13px;opacity:.7">300 × 250</span></div>

    <div class="card related-card">
      <h2 class="related-title">{P.relatedTitle}</h2>
      <div class="related-links">
        {related.map(r => <a href={r.href}>{r.label}</a>)}
      </div>
    </div>
  </aside>

  <main class="dua-main">
    <DuaSectionBlock lang={lang} section={section} as="h1" />

    <section class="card section-card other-sections">
      <h2 class="other-title">{U.otherSections}</h2>
      <div class="other-grid">
        {others.map(s => (
          <a class="other-card" href={catHref(s.id)}>
            <span class="other-ic" aria-hidden="true">{ICONS[s.id] ?? '☾'}</span>
            <span class="other-text">
              <span class="other-name">{pick(s.title)}</span>
              <span class="other-count">{s.items.length} {U.supplications}</span>
            </span>
            <svg class="other-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ))}
      </div>
    </section>

    {faqs.length > 0 && (
      <section class="card section-card dua-faq" aria-label={pick(DUA_FAQ_TITLE)}>
        <h2 class="faq-title">{pick(DUA_FAQ_TITLE)}</h2>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-q">{pick(f.q)}</summary>
              <p class="faq-a">{pick(f.a)}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </main>
</div>

<footer class="site-footer">
  {L('الأدعية من القرآن الكريم والسنة الصحيحة', 'Supplications from the Quran and authentic Sunnah', 'دعائیں قرآن کریم اور صحیح سنت سے')}
  <span style="margin:0 8px;opacity:.4">·</span>
  <a href={tool('/privacy/')} style="color:var(--muted);text-decoration:none;font-size:13px">{L('سياسة الخصوصية', 'Privacy Policy', 'رازداری پالیسی')}</a>
</footer>

<button id="duaToTop" class="dua-totop" aria-label={L('العودة إلى الأعلى', 'Back to top', 'اوپر جائیں')}>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
</button>

<style is:global>
  html { scroll-behavior: smooth; }
</style>

<style>
  .breadcrumb { max-width: 1180px; margin: 0 auto; padding: 16px 20px 0; }
  .breadcrumb-inner {
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
    font-size: 13.5px; color: var(--muted);
  }
  .breadcrumb a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .sep { opacity: .5; }
  .breadcrumb .current { color: var(--text); font-weight: 700; }

  .dua-layout {
    max-width: 1180px; margin: 0 auto;
    padding: 16px 20px 56px;
    display: grid; gap: 24px; grid-template-columns: 1fr;
  }
  .dua-main { min-width: 0; display: flex; flex-direction: column; gap: 22px; order: 1; }
  /* Mobile-first: reset the global sticky/width aside rule so the sidebar
     stacks below the content instead of floating over it. */
  .dua-side { display: flex; flex-direction: column; gap: 18px; order: 2; position: static; max-width: none; min-width: 0; top: auto; }

  @media (min-width: 960px) {
    .dua-layout { grid-template-columns: 282px minmax(0, 1fr); align-items: start; }
    .dua-side { grid-column: 1; grid-row: 1; position: sticky; top: 70px; }
    .dua-main { grid-column: 2; grid-row: 1; }
  }

  .related-card { padding: 18px 20px; }
  .related-title { margin: 0 0 12px; font-size: 15.5px; font-weight: 700; }
  .related-links { display: flex; flex-direction: column; gap: 10px; font-size: 14.5px; }
  .related-links a { color: var(--accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }

  /* Other-sections block */
  .other-title { margin: 0 0 14px; font-size: 18px; font-weight: 800; }
  .other-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .other-card {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 15px; border-radius: 14px;
    border: 1px solid var(--border); background: var(--surface2);
    text-decoration: none; color: var(--text);
    transition: background .18s, border-color .18s, transform .18s, box-shadow .18s;
  }
  .other-card:hover {
    background: var(--surface); border-color: var(--accent);
    transform: translateY(-1px); box-shadow: 0 6px 18px rgba(13,40,48,.07);
  }
  .other-ic {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 11px;
    background: var(--accent-soft); display: flex; align-items: center; justify-content: center;
    font-size: 21px; line-height: 1;
  }
  .other-text { display: flex; flex-direction: column; gap: 2px; flex: 1 1 auto; min-width: 0; }
  .other-name { font-weight: 700; font-size: 14.5px; line-height: 1.3; }
  .other-count { font-size: 12.5px; color: var(--muted); }
  .other-arrow { flex: 0 0 auto; color: var(--accent); opacity: .8; }
  [dir="rtl"] .other-arrow { transform: scaleX(-1); }

  /* FAQ */
  .faq-title { margin: 0 0 8px; font-size: 18px; font-weight: 800; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 4px 0; }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    cursor: pointer; list-style: none; position: relative;
    padding: 12px 30px 12px 0; font-weight: 700; font-size: 15.5px; color: var(--text);
    line-height: 1.6;
  }
  [dir="rtl"] .faq-q { padding: 12px 0 12px 30px; }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+'; position: absolute; inset-inline-end: 4px; top: 10px;
    font-size: 20px; font-weight: 700; color: var(--accent); transition: transform .2s;
  }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a { margin: 0 0 12px; color: var(--muted); line-height: 1.9; font-size: 14.5px; text-wrap: pretty; }

  .dua-totop {
    position: fixed; inset-block-end: 22px; inset-inline-end: 22px; z-index: 50;
    width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid var(--border); background: var(--accent); color: var(--accent-contrast);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 18px rgba(13,148,136,.32);
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: opacity .25s, transform .25s, visibility .25s, background .2s;
  }
  .dua-totop.show { opacity: 1; visibility: visible; transform: none; }
  .dua-totop:hover { background: #0b7d73; }
</style>

<script>
  const toTop = document.getElementById('duaToTop');
  if (toTop) {
    const onScroll = () => toTop.classList.toggle('show', window.scrollY > 600);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
