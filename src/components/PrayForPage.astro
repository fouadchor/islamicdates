---
// صفحة «ادعوا لـ…» الواحدة — نسخة واحدة تخدم اللغات الثلاث.
//
// Most people arrive here from a WhatsApp message, on a phone, a day after a
// death or on hearing someone is ill. The page is built for that moment: the
// name first, one short supplication with the name in it, one button — and only
// then the rest. No ads, no countdowns, no side rail of unrelated tools.
import Layout from '../layouts/Layout.astro';
import PrayForCard from './PrayForCard';
import { pick, type Lang } from '../lib/data';
import { prayT } from '../lib/pray-for-i18n';
import { renderDuas } from '../lib/pray-for-duas';
import type { PrayLoaded } from '../lib/pray-for-load';

// Loaded — and the status set — by the route file, because Astro streams.
interface Props { lang: Lang; loaded: PrayLoaded }
const { lang, loaded } = Astro.props;
const { slug, view, problem } = loaded;
const T = prayT(lang);

const isNew = Astro.url.searchParams.get('new') === '1';
const canonical = `https://islamicdates.org${T.base}${slug}/`;
const home = pick(lang, '/', '/en/', '/ur/');
const copy = view ? T.page(view.name, view.kind, view.gender, view.prayers) : null;
const duas = view ? renderDuas(view.kind, view.gender, lang, view.name) : [];

// One pre-rendered preview card per language and kind (scripts/gen-pray-for-og.mjs);
// the person's name travels in og:title beside it.
const ogImage = view ? `https://islamicdates.org/og/pray-for/${lang}-${view.kind}.jpg` : undefined;
---
<Layout title={copy ? copy.title : T.notFoundH} description={copy ? copy.description : T.notFoundBody}
        canonical={canonical} lang={lang} quiet={true}
        arPath={`/pray-for/${slug}/`} enPath={`/en/pray-for/${slug}/`} urPath={`/ur/pray-for/${slug}/`} noindex={true}
        ogImage={ogImage} ogImageAlt={copy?.ogAlt}>
  <header class="site-header">
    <div class="header-start">
      <a href={home} class="logo" aria-label={T.home}>
        <div class="logo-icon">☾</div>
        <div>
          <div class="brand">{pick(lang, 'التقويم الهجري', 'Hijri Calendar', 'ہجری کیلنڈر')}</div>
          <div class="tagline">{T.tagline}</div>
        </div>
      </a>
    </div>
  </header>

  <div class="pf-wrap">
    <main>
      {view && copy ? (
        <>
          <section class={`card pf-hero pf-${view.kind}`} data-pf-hero>
            <svg class="pf-star" viewBox="0 0 48 48" width="34" height="34" aria-hidden="true">
              <path d="M24 3l5.6 7.9 9.6-1.5-1.5 9.6L45 24l-7.9 5.6 1.5 9.6-9.6-1.5L24 45l-5.6-7.9-9.6 1.5 1.5-9.6L3 24l7.9-5.6-1.5-9.6 9.6 1.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <circle cx="24" cy="24" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            <p class="pf-eyebrow" lang="ar" dir="rtl">{copy.eyebrow}</p>
            {copy.eyebrowNote && <p class="pf-eyebrow-note">{copy.eyebrowNote}</p>}
            <h1 class="pf-name"><bdi>{view.name}</bdi></h1>
            <p class="pf-lead">{copy.lead}</p>
            <p class="pf-intro">{copy.intro}</p>
          </section>

          <section class="card pf-body">
            <PrayForCard initial={view} lang={lang} t={copy.card} duas={duas}
                         shareUrl={canonical} base={T.base} isNew={isNew} client:load />
          </section>

          <section class="card pf-reminder">
            <h2 class="section-h2">{copy.reminderH}</h2>
            <p class="section-p">{copy.reminder}</p>
          </section>

          <p class="pf-another"><a href={T.base}>{copy.card.createNew}</a></p>
        </>
      ) : (
        <section class="card section-card">
          <h1 class="section-h2" style="font-size:24px">{problem === 'unavailable' ? T.unavailableH : T.notFoundH}</h1>
          <p class="section-p" style="margin-top:8px">{problem === 'unavailable' ? T.unavailableBody : T.notFoundBody}</p>
          <p class="section-p" style="margin-top:12px"><a href={T.base} style="color:var(--accent)">{T.createNew}</a></p>
        </section>
      )}
    </main>
  </div>

  {isNew && view && (
    <script is:inline>
      // `?new=1` marks the creator's first visit (the island shows them the
      // "now send it" card), but it rides along whenever the address bar is
      // copied. Drop it from the address bar so the next copy is clean.
      (function () {
        try {
          var u = new URL(location.href);
          u.searchParams.delete('new');
          history.replaceState(history.state, '', u.pathname + (u.search === '?' ? '' : u.search) + u.hash);
        } catch (_) {}
      })();
    </script>
  )}

  <footer class="site-footer">
    {T.footerNote}
    <span style="margin:0 8px;opacity:.4">·</span>
    <a href={T.privacyHref} style="color:var(--muted);text-decoration:none;font-size:13px">{T.privacyLabel}</a>
  </footer>

  <style is:global>
    .pf-wrap { max-width: 700px; margin: 0 auto; padding: 22px 16px 120px; }
    .pf-wrap > main { gap: 18px; }

    /* ── Hero: the person, before anything else ─────────────────────────── */
    .pf-hero {
      position: relative; overflow: hidden; text-align: center;
      padding: 30px 22px 26px;
      background:
        radial-gradient(120% 70% at 50% 0%, var(--accent-soft) 0%, transparent 70%),
        var(--surface);
    }
    .pf-sick.pf-hero { background: radial-gradient(120% 70% at 50% 0%, var(--gold-soft) 0%, transparent 70%), var(--surface); }
    .pf-star { color: var(--accent); opacity: .75; display: block; margin: 0 auto 6px; }
    .pf-sick .pf-star { color: var(--gold); }
    .pf-eyebrow {
      margin: 0; font-family: 'Noto Naskh Arabic', 'IBM Plex Sans Arabic', serif;
      font-size: 19px; font-weight: 600; line-height: 1.9; color: var(--accent-strong);
    }
    .pf-sick .pf-eyebrow { color: var(--gold-deep); }
    .pf-eyebrow-note { margin: 0; font-size: 13px; color: var(--muted); font-style: italic; }
    .pf-name {
      margin: 12px 0 2px; font-family: 'Noto Naskh Arabic', 'IBM Plex Sans Arabic', serif;
      font-size: clamp(30px, 7vw, 42px); font-weight: 700; line-height: 1.45;
      color: var(--text); overflow-wrap: anywhere; text-wrap: balance;
    }
    html[lang="en"] .pf-name { font-family: 'Plus Jakarta Sans', 'Noto Naskh Arabic', sans-serif; font-weight: 800; }
    .pf-lead { margin: 0; font-size: 16.5px; font-weight: 700; color: var(--accent-strong); }
    .pf-sick .pf-lead { color: var(--gold-deep); }
    .pf-intro { margin: 14px auto 0; max-width: 520px; font-size: 14.5px; line-height: 1.85; color: var(--muted); text-wrap: pretty; }

    .pf-body { padding: 22px 22px 24px; }
    .pf-reminder { padding: 22px 24px; }
    .pf-another { margin: 0; text-align: center; font-size: 14.5px; }
    .pf-another a { color: var(--accent); font-weight: 700; text-decoration: none; }
    .pf-another a:hover { text-decoration: underline; }

    /* ── The island: count, the featured supplication, the button ──────── */
    .pf { position: relative; }
    .pf-creator { margin: 0 0 18px; padding: 18px 16px; border-radius: 16px; background: var(--accent-soft); text-align: center; animation: pf-rise .35s ease; }
    .pf-creator-h { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 0 6px; font-size: 17px; font-weight: 800; color: var(--accent-strong); }
    .pf-creator-ic { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-contrast); }
    .pf-creator-p { margin: 0 0 12px; font-size: 14.5px; line-height: 1.8; color: var(--text); }
    .pf-creator-first { margin: 12px 0 0; font-weight: 700; color: var(--accent-strong); }
    .pf-creator .pf-share-row { justify-content: center; }

    .pf-count {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px 8px;
      margin: 0 0 20px; padding: 12px 16px; border-radius: 16px; text-align: center;
      background: var(--accent-soft); color: var(--accent-strong); font-size: 16px; font-weight: 700; line-height: 1.7;
    }
    .pf-count .pf-n { font-size: 24px; font-weight: 800; margin: 0 4px; vertical-align: -2px; }
    .pf-count.is-zero { background: var(--gold-soft); color: var(--gold-deep); }
    .pf-count-ic { display: inline-grid; animation: pf-beat .6s ease; }
    .pf-dot { opacity: .45; }
    .pf-count-sub { font-size: 14.5px; font-weight: 600; }
    .pf-count-sub .pf-n { font-size: 16px; vertical-align: 0; }

    .pf-feature-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 10px; }
    .pf-feature-h { margin: 0; font-size: 15px; font-weight: 800; color: var(--muted); }
    .pf-font { display: inline-flex; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; direction: ltr; }
    .pf-font button { font: inherit; font-weight: 800; font-size: 13px; min-width: 44px; height: 36px; padding: 0 8px; border: 0; background: var(--surface); color: var(--text); cursor: pointer; }
    .pf-font button + button { border-left: 1px solid var(--border); }
    .pf-font button[disabled] { opacity: .35; cursor: default; }
    .pf-font button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .pf-a-sm { font-size: 12px; } .pf-a-lg { font-size: 16px; }

    .pf-dua { border: 1px solid var(--border); border-radius: 16px; background: var(--surface2); padding: 16px 18px 12px; }
    .pf-dua.is-featured { background: var(--surface); border: 1.5px solid var(--accent); box-shadow: 0 8px 26px rgba(13,148,136,.10); padding: 24px 20px 12px; text-align: center; }
    .pf-k-sick .pf-dua.is-featured { border-color: var(--gold); box-shadow: 0 8px 26px rgba(201,138,22,.10); }
    .pf-text {
      margin: 0; font-family: 'Noto Naskh Arabic', 'IBM Plex Sans Arabic', serif;
      font-size: calc(var(--pf-fs, 1) * clamp(19px, 2.6vw, 22px)); line-height: 2.15; font-weight: 500;
      color: var(--text); text-align: right; text-wrap: pretty;
    }
    .pf-dua.is-featured .pf-text { text-align: center; font-size: calc(var(--pf-fs, 1) * clamp(22px, 3.6vw, 26px)); line-height: 2.1; font-weight: 600; }
    .pf-times-line { margin: 4px 0 0; font-weight: 800; color: var(--gold-deep); }
    .pf-the-name { color: var(--accent-strong); font-weight: 700; }
    .pf-k-sick .pf-the-name { color: var(--gold-deep); }
    .pf-meaning .pf-the-name { font-weight: 700; }
    .pf-meaning { margin: 10px 0 0; font-size: calc(var(--pf-fs, 1) * 14.5px); line-height: 1.8; color: var(--muted); }
    .pf-dua-head { display: flex; align-items: center; gap: 10px; padding-bottom: 9px; margin-bottom: 10px; border-bottom: 1px dashed var(--border); }
    .pf-when { margin: 0; flex: 1 1 auto; min-width: 0; font-size: 15px; font-weight: 800; color: var(--accent); line-height: 1.5; }
    .pf-times { flex: 0 0 auto; font-size: 12.5px; font-weight: 700; color: var(--gold-deep); background: var(--gold-soft); padding: 4px 11px; border-radius: 999px; }
    .pf-dua-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border); text-align: start; }
    .pf-src { font-size: 12.5px; font-weight: 600; color: var(--muted); line-height: 1.6; }
    .pf-copy { flex: 0 0 auto; font: inherit; font-size: 12.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; padding: 6px 10px; border-radius: 9px; border: 1px solid var(--border); background: var(--surface); color: var(--accent-strong); cursor: pointer; }
    .pf-copy:hover { border-color: var(--accent); }

    .pf-act { margin-top: 18px; text-align: center; scroll-margin: 90px; }
    .pf-pray {
      font: inherit; font-size: 18.5px; font-weight: 800; width: 100%; max-width: 440px; min-height: 58px;
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      padding: 14px 22px; border: 0; border-radius: 16px; cursor: pointer;
      background: var(--accent); color: var(--accent-contrast); box-shadow: 0 8px 22px rgba(14,128,118,.24);
      transition: background .15s, transform .12s;
    }
    .pf-pray:hover:not([disabled]) { background: var(--accent-strong); }
    .pf-pray:active:not([disabled]) { transform: scale(.98); }
    .pf-pray[disabled] { opacity: .75; cursor: progress; }
    .pf-hint { margin: 9px 0 0; font-size: 13px; color: var(--muted); }
    .pf-return { margin: 0 auto 12px; max-width: 440px; font-size: 14.5px; line-height: 1.8; color: var(--text); }
    .pf-today-pill { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong); font-weight: 800; font-size: 16px; }

    .pf-done { padding: 22px 16px 18px; border-radius: 18px; background: var(--accent-soft); animation: pf-rise .35s ease; }
    .pf-done-mark { color: var(--accent); display: block; margin: 0 auto; }
    .pf-done-mark circle { stroke-dasharray: 151; stroke-dashoffset: 151; animation: pf-draw .5s ease forwards; }
    .pf-done-mark path { stroke-dasharray: 36; stroke-dashoffset: 36; animation: pf-draw .35s .4s ease forwards; }
    .pf-done-h { margin: 8px 0 10px; font-size: 20px; font-weight: 800; color: var(--accent-strong); }
    .pf-done-q { margin: 0 auto; max-width: 500px; padding: 0; }
    .pf-done-q p { margin: 0; font-family: 'Noto Naskh Arabic', 'IBM Plex Sans Arabic', serif; font-size: 18px; line-height: 2; color: var(--text); }
    html[lang="en"] .pf-done-q p { font-family: inherit; font-size: 15.5px; line-height: 1.7; font-style: italic; }
    .pf-done-q cite { display: block; margin-top: 4px; font-size: 12.5px; font-style: normal; font-weight: 600; color: var(--muted); }
    .pf-share-after { margin-top: 16px !important; background: var(--surface) !important; text-align: center; }
    .pf-share-after .pf-share-row { justify-content: center; }

    .pf-share { margin-top: 20px; padding: 14px; border-radius: 14px; background: var(--accent-soft); }
    .pf-share p { margin: 0 0 10px; font-size: 14px; line-height: 1.75; color: var(--text); }
    .pf-share-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .pf-wa, .pf-btn-soft {
      font: inherit; font-size: 14px; font-weight: 700; padding: 10px 15px; border-radius: 12px;
      display: inline-flex; align-items: center; justify-content: center; gap: 7px; text-decoration: none; cursor: pointer;
    }
    .pf-wa { background: #25D366; color: #fff; border: 0; }
    .pf-wa:hover { background: #1ebe5a; }
    .pf-btn-soft { background: var(--surface); color: var(--accent-strong); border: 1px solid var(--border); }
    .pf-btn-soft:hover { border-color: var(--accent); }
    .pf-share-row.is-big .pf-wa { font-size: 15.5px; padding: 12px 20px; }

    .pf-more { margin-top: 28px; }
    .pf-more-list { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }

    .pf-admin { margin-top: 24px; padding-top: 14px; border-top: 1px dashed var(--border); font-size: 13.5px; color: var(--muted); }
    .pf-admin-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .pf-admin-btns { display: inline-flex; gap: 8px; flex-wrap: wrap; }
    .pf-admin-btns button { font: inherit; font-size: 13.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 10px; cursor: pointer; background: var(--surface); color: var(--accent-strong); border: 1px solid var(--border); }
    .pf-admin-btns .is-danger { color: #c0392b; border-color: rgba(192,57,43,.35); }
    .pf-edit { display: flex; flex-direction: column; gap: 6px; color: var(--text); }
    .pf-edit-h { margin: 0 0 4px; font-weight: 800; font-size: 15px; }
    .pf-edit label[for], .pf-edit legend { font-size: 13.5px; font-weight: 700; padding: 0; margin: 8px 0 4px; color: var(--text); }
    .pf-edit input[type=text] { font: inherit; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); color: var(--text); width: 100%; }
    .pf-edit input[type=text]:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .pf-edit fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
    .pf-seg { display: inline-flex; flex-wrap: wrap; padding: 4px; gap: 4px; border-radius: 12px; background: var(--accent-soft); }
    .pf-seg label { position: relative; cursor: pointer; }
    .pf-seg input { position: absolute; opacity: 0; pointer-events: none; }
    .pf-seg span { display: block; text-align: center; padding: 8px 14px; border-radius: 9px; font-weight: 700; font-size: 14px; color: var(--accent-strong); }
    .pf-seg input:checked + span { background: var(--surface); box-shadow: 0 1px 4px rgba(13,40,48,.12); }
    .pf-seg input:focus-visible + span { outline: 2px solid var(--accent); }
    .pf-edit-hint { margin: 6px 0 0; font-size: 12.5px; line-height: 1.7; color: var(--muted); }
    .pf-edit-btns { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .pf-btn-main { font: inherit; font-weight: 800; padding: 10px 18px; border-radius: 12px; border: 0; background: var(--accent); color: var(--accent-contrast); cursor: pointer; }
    .pf-btn-main[disabled] { opacity: .6; cursor: default; }
    .pf-btn-danger { font: inherit; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px; border-radius: 12px; border: 0; background: #c0392b; color: #fff; cursor: pointer; }
    .pf-confirm p { margin: 0 0 4px; color: var(--text); font-size: 14px; line-height: 1.8; }
    .pf-err { margin: 0 0 12px; padding: 11px 13px; border-radius: 12px; background: #fdecea; color: #b42318; font-size: 14px; }
    .pf-deleted { text-align: center; padding: 18px 0; }
    .pf-deleted-msg { margin: 0 0 10px; font-size: 16px; font-weight: 700; }
    .pf-new-link { color: var(--accent); font-weight: 700; }

    /* The pray button, following the reader once its own place has scrolled away. */
    .pf-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 55;
      padding: 18px 14px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(to top, var(--bg) 62%, transparent);
      animation: pf-up .25s ease;
    }
    .pf-bar-in { max-width: 440px; margin: 0 auto; }
    .pf-pray.in-bar { min-height: 54px; font-size: 17.5px; box-shadow: var(--shadow-lift); }
    body.pf-sticky-on .back-top { bottom: 96px; }

    @keyframes pf-beat { 0% { transform: scale(1); } 30% { transform: scale(1.28); } 60% { transform: scale(.94); } 100% { transform: scale(1); } }
    @keyframes pf-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    @keyframes pf-up { from { transform: translateY(100%); } to { transform: none; } }
    @keyframes pf-draw { to { stroke-dashoffset: 0; } }
    @media (prefers-reduced-motion: reduce) {
      .pf *, .pf-bar { animation: none !important; transition: none !important; }
      .pf-done-mark circle, .pf-done-mark path { stroke-dashoffset: 0; }
    }
    @media (pointer: coarse) {
      .pf-wa, .pf-btn-soft, .pf-copy, .pf-admin-btns button, .pf-btn-main, .pf-btn-danger { min-height: 44px; }
      .pf-font button { height: 44px; }
    }
    @media (max-width: 480px) {
      .pf-share-row.is-big .pf-wa { flex: 1 1 100%; }
      .pf-dua { padding: 14px 14px 10px; }
      .pf-dua.is-featured { padding: 20px 14px 10px; }
      .pf-dua-foot { flex-wrap: wrap; }
    }

    @media (max-width: 480px) {
      .pf-wrap { padding: 14px 12px 120px; }
      .pf-hero { padding: 24px 16px 22px; }
      .pf-body { padding: 18px 14px 20px; }
      .pf-reminder { padding: 18px 16px; }
    }
  </style>
</Layout>
