---
// Imsākiyya city block for the Ramadan-season pages.
//
// Purpose: the 265 imsākiyya city pages (x3 languages) were reachable only
// through the /imsakiyah/ directory — every other page on the site, including
// the Ramadan pages that rank for exactly this intent, linked the hub and
// nothing under it. That leaves ~800 URLs one narrow doorway deep, which is a
// discovery problem with a hard deadline: they need to be crawled well before
// Ramadan, not in the week it starts.
//
// Same shape as HomeCityPrayer, pointed at the imsākiyya paths. Rendered only
// on Ramadan-season pages (the month page for Ramadan, the Ramadan occasion
// pages, and the fasting guide), so it stays contextual rather than sitewide.
import { imsakBase, imsakCityPath, activeRamadanYear, IMSAK_FEATURED_CITIES, type ImsakLang } from '../lib/imsakiyah';
import { pick, type Lang, hijriEra } from '../lib/data';
import { h2g } from '../lib/hijri';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = lang as ImsakLang;

// The featured cities live in lib/imsakiyah (IMSAK_FEATURED) because the same
// list decides which imsākiyya pages are offered for indexing: the pages this
// block links to are exactly the ones in the sitemap. Picks are resolved
// against PT_CITIES there, so a bad slug drops out at build time rather than
// shipping a broken link.
const cities = IMSAK_FEATURED_CITIES.map(({ country, city }) => ({
  name: city[l], country: country[l], href: imsakCityPath(country.slug, city.slug, l),
}));

// The Hijri year whose Ramadan the imsākiyya pages are currently showing, and
// the Gregorian year it lands in — so the heading names the same Ramadan the
// linked pages do rather than drifting out of step with them.
const hy = activeRamadanYear();
const gy = h2g(hy, 9, 1).getUTCFullYear();
const era = hijriEra(lang);

const T = {
  h2: pick(lang,
    `إمساكية رمضان ${hy} ${era} حسب المدينة`,
    `Ramadan ${hy} ${era} imsakiyah by city`,
    `رمضان ${hy} ${era} کی امساکیہ شہر کے اعتبار سے`),
  p: pick(lang,
    `مواعيد السحور والإفطار يوماً بيوم لكل مدينة، مع مدة الصيام وجدول قابل للطباعة — رمضان ${gy}.`,
    `Day-by-day suhoor and iftar times for each city, with fasting length and a printable table — Ramadan ${gy}.`,
    `ہر شہر کے لیے سحری و افطار کے اوقات، دورانیۂ صیام اور قابلِ طباعت جدول — رمضان ${gy}۔`),
  all: pick(lang, 'كل مدن الإمساكية', 'All imsakiyah cities', 'تمام امساکیہ شہر'),
};
---

<section class="card section-card">
  <h2 class="section-h2">{T.h2}</h2>
  <p class="section-p" style="margin-bottom:14px">{T.p}</p>
  <div class="ims-city-grid">
    {cities.map(c => (
      <a href={c.href} class="ims-city-item">
        <span class="ims-city-name">{c.name}</span>
        <span class="ims-city-country">{c.country}</span>
      </a>
    ))}
  </div>
  <a href={imsakBase(l)} class="ims-city-all">{T.all} ←</a>
</section>

<style>
  .ims-city-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  .ims-city-item {
    display: block; padding: 10px 13px;
    border: 1px solid var(--border); border-radius: 11px;
    background: var(--surface2); text-decoration: none; color: inherit;
    transition: border-color .2s, background .2s, transform .2s;
  }
  .ims-city-item:hover { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-1px); }
  .ims-city-name { display: block; font-weight: 700; font-size: 14px; }
  .ims-city-country { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; }
  .ims-city-all { display: inline-block; margin-top: 14px; font-size: 13.5px; font-weight: 700; color: var(--accent); text-decoration: none; }
  @media (max-width: 700px) {
    .ims-city-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 7px; }
    .ims-city-item { padding: 9px 11px; }
  }
</style>
